#!/usr/bin/env bash
# ryoku track unstable / ryoku track stable --source: build a Ryoku box from a
# git checkout and make `ryoku update` follow the branch. Installs build tools,
# clones or updates the repo, records the branch, and rebuilds and redeploys.
# Non-destructive: user_edits and Hub settings survive. `ryoku recovery` resets.
#
#   ryoku track unstable
#   ryoku track stable --source
#
#   curl -fsSL https://raw.githubusercontent.com/ryoku-dev/ryoku/main/bin/ryoku-track | bash -s -- unstable-dev
set -euo pipefail

CHANNEL="${1:-unstable-dev}"
case "$CHANNEL" in
  main | unstable-dev) ;;
  -h | --help)
    sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
    echo "usage: ryoku track unstable | ryoku track stable --source"
    exit 0
    ;;
  *) echo "ryoku-track: unknown channel '$CHANNEL' (use: main or unstable-dev)" >&2; exit 1 ;;
esac

REPO="$HOME/ryoku-arch"
REPO_URL="${RYOKU_TRACK_URL:-https://github.com/ryoku-dev/ryoku.git}"
say() { printf '\n==> %s\n' "$*"; }

if [[ $CHANNEL == unstable-dev ]]; then
  say "Switching this box to unstable-dev, the bleeding edge rebuilt from source. Use at your own risk."
else
  say "Switching this box to main, the stable channel, tracked from source."
fi

host_pkgmgr() {
  if command -v ryoku-host >/dev/null 2>&1; then
    ryoku-host pkgmgr 2>/dev/null && return
  fi
  if command -v pacman >/dev/null 2>&1; then
    printf 'pacman\n'
  elif command -v xbps-install >/dev/null 2>&1; then
    printf 'xbps\n'
  elif command -v dnf5 >/dev/null 2>&1 || command -v dnf >/dev/null 2>&1; then
    printf 'dnf\n'
  fi
}

say "Installing build tools and matugen"
package_manager=$(host_pkgmgr)
case "$package_manager" in
  pacman)
    sudo pacman -S --needed --noconfirm git go cmake ninja qt6-shadertools wayland base-devel matugen vulkan-headers aubio libqalculate lm_sensors
    ;;
  xbps)
    # system/packages/resolve cannot translate an explicit list; these names come
    # from void/packages/translations.tsv and void/packages/sets/build.packages.
    void_tools=(git go cmake ninja qt6-shadertools-devel wayland-devel base-devel matugen Vulkan-Headers aubio-devel libqalculate-devel lm_sensors-devel)
    sudo xbps-install -Sy "${void_tools[@]}"
    ;;
  dnf)
    # system/packages/resolve cannot translate an explicit list; these names come
    # from fedora/packages/translations.tsv and the first-party RPM build specs.
    fedora_tools=(
      git golang cmake ninja-build qt6-qtshadertools-devel wayland-devel
      gcc gcc-c++ make meson pkgconf-pkg-config ryoku-extras vulkan-headers
      aubio-devel libqalculate-devel lm_sensors-devel
    )
    command -v ryoku-host >/dev/null 2>&1 || {
      echo "ryoku-track: ryoku-host is required to install the Fedora build toolchain" >&2
      exit 1
    }
    sudo ryoku-host pkg install "${fedora_tools[@]}"
    ;;
  *)
    echo "ryoku-track: no supported package manager found" >&2
    exit 1
    ;;
esac

say "Fetching the Ryoku source ($CHANNEL) into $REPO"
if [[ -d $REPO/.git ]]; then
  # The reset below is destructive, so only reuse the canonical clone or its
  # historical ryoku-arch remote.
  cur=$(git -C "$REPO" remote get-url origin 2>/dev/null || true)
  case "$cur" in
    *ryoku-dev/ryoku* | *ryoku-arch*) ;;
    *) echo "ryoku-track: $REPO is a git repo but its origin ($cur) is not Ryoku; move it aside and re-run." >&2; exit 1 ;;
  esac
  git -C "$REPO" remote set-url origin "$REPO_URL" 2>/dev/null || true
  git -C "$REPO" fetch origin "$CHANNEL"
  git -C "$REPO" checkout "$CHANNEL"
  git -C "$REPO" reset --hard "origin/$CHANNEL"
else
  git clone -b "$CHANNEL" "$REPO_URL" "$REPO"
fi

say "Setting the update channel to $CHANNEL"
mkdir -p "$HOME/.config/environment.d"
printf 'RYOKU_CHANNEL=%s\n' "$CHANNEL" >"$HOME/.config/environment.d/ryoku.conf"
# the running session captured the old channel at login; push the new one into
# the user manager and the D-Bus activation env now, so the shell daemon and
# Hub started below (and anything launched after) carry it without a relogin.
systemctl --user set-environment "RYOKU_CHANNEL=$CHANNEL" 2>/dev/null || true
dbus-update-activation-environment "RYOKU_CHANNEL=$CHANNEL" 2>/dev/null || true
export RYOKU_CHANNEL="$CHANNEL"

say "Building and deploying the desktop from the checkout"
bash "$REPO/ryoku/shell/deploy.sh"
pkill -9 -x ryoku-shell 2>/dev/null || true
pkill -f "quickshell.*hub" 2>/dev/null || true
nohup "$HOME/.local/bin/ryoku-shell" daemon >/dev/null 2>&1 &

say "Done. ryoku status should say $CHANNEL now (a relogin picks it up everywhere). The first build compiles everything and takes a few minutes; later updates reuse the caches."
cat <<EOF

Every update after: ryoku update. Full reset to stable main: ryoku recovery.
Keep no local edits in $REPO (ryoku update resets it to origin/$CHANNEL).
EOF
