#!/usr/bin/env bash
# Re-render Rashin's provider and harness logos from lobehub/lobe-icons at a
# pinned commit into ryoku/rashin/internal/app/look/logos/masks: one alpha mask
# per mark that logos/list.txt names, from the mono SVGs, plus the upstream
# LICENSE beside them. Lithic paints roles, never brand colours, so only the
# coverage is kept and the app tints it. The marks are rasterized here because
# their SVGs fill even-odd and use arcs, which the Lithic symbols pipeline
# refuses; the build never needs these tools. Running it twice leaves the tree
# identical.
#
#   ryoku-dev-sync-provider-logos   rebuild the masks (needs git, tar, rsvg-convert, magick, network)
#
# To move the pin, change the commit below, run this, look at the marks in the
# app, and update the provider logos entry in ryoku/rashin/NOTICE and the root
# NOTICE.
set -euo pipefail

commit=ea434b96e75813517b377825e01c0df61dee8836
# the app scales down from this; a 24 dp mark at 2.5x is 60 px
size=96

repo=$(git rev-parse --show-toplevel)
dest=$repo/ryoku/rashin/internal/app/look/logos
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

mapfile -t marks < <(awk '!/^#/ && NF == 2 && $2 != "-" { print $2 }' "$dest/list.txt" | sort -u)

src=$work/src
git init -q "$src"
git -C "$src" fetch -q --depth 1 --filter=blob:none https://github.com/lobehub/lobe-icons.git "$commit"
paths=(LICENSE)
for mark in "${marks[@]}"; do
  paths+=("packages/static-svg/icons/$mark.svg")
done
mkdir -p "$work/svg"
git -C "$src" archive --format=tar "$commit" "${paths[@]}" | tar -x -C "$work/svg"

out=$work/masks
mkdir -p "$out"
for mark in "${marks[@]}"; do
  rsvg-convert -w "$size" -h "$size" "$work/svg/packages/static-svg/icons/$mark.svg" -o "$work/$mark.png"
  magick "$work/$mark.png" -alpha extract -strip -define png:exclude-chunks=date,time \
    -define png:color-type=0 -depth 8 "$out/$mark.png"
done

rm -rf "$dest/masks"
cp -R "$out" "$dest/masks"
cp "$work/svg/LICENSE" "$dest/LICENSE"
printf 'provider logos: %s masks in %s\n' "${#marks[@]}" "${dest#"$repo"/}/masks"
