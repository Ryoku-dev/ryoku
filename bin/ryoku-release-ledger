#!/usr/bin/env bash
# ryoku-release-ledger: rebuild one edition's stable or testing ledger.
#
# Stable ledgers are derived from <prefix>releases/<tag>/x86_64/release.json
# and include matching ISO images. Testing ledgers are derived from
# <prefix>channels/testing/builds/<dir>/x86_64/release.json and never include
# images. Both are newest first by date, and `latest` is the newest release.
#
# Publish workflows run this after a frozen repository lands and
# release-ledger.yml runs it on demand, so a ledger that was lost, truncated, or
# written by an older publish heals on the next run. The Hub's Updates page,
# `ryoku rollback` (the list it offers) and the site read it.
#
# The stable `images` map keys each release to the ISOs a reinstall or a rollback
# would fetch. Arch carries plain and cachyos; Void carries void. Fedora editions
# do not carry images.
#
# usage: ryoku-release-ledger <rclone remote:bucket> [arch|void|fedora/<N>] [stable|testing]
# needs: rclone (configured, see bin/ryoku-r2-config), jq
set -euo pipefail
remote=${1:?usage: ryoku-release-ledger <rclone remote:bucket> [arch|void|fedora/<N>] [stable|testing]}
edition=${2:-arch}
channel=${3:-stable}

case "$edition" in
  arch)
    edition_prefix=
    variants=plain,cachyos
    ;;
  void)
    edition_prefix=void/
    variants=void
    ;;
  fedora/*)
    fedora_release=${edition#fedora/}
    if [[ ! $fedora_release =~ ^[0-9]+$ ]]; then
      echo "ryoku-release-ledger: Fedora edition must be fedora/<N>, got: $edition" >&2
      exit 2
    fi
    edition_prefix="fedora/$fedora_release/"
    variants=
    ;;
  *)
    echo "ryoku-release-ledger: edition must be arch, void, or fedora/<N>, got: $edition" >&2
    exit 2
    ;;
esac

case "$channel" in
  stable)
    release_root="${edition_prefix}releases"
    ledger_root=$release_root
    ;;
  testing)
    release_root="${edition_prefix}channels/testing/builds"
    ledger_root="${edition_prefix}channels/testing"
    ;;
  *)
    echo "ryoku-release-ledger: channel must be stable or testing, got: $channel" >&2
    exit 2
    ;;
esac

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# collect_iso_images: emit {"<tag>":{"<variant>":{iso,manifest,sha256,signature,url,date}}}
# from the per-ISO manifests at the bucket root. The manifest list is fetched
# once (non-recursive, *.json only) so a bucket with many objects is not cat'd
# blindly; the mutable latest*.json pointers are dropped, and anything that does
# not parse as an ISO manifest is skipped with a message on stderr rather than
# aborting the whole rebuild (a stray or truncated object must not lose the
# ledger). When a variant somehow has two manifests for one release (a
# re-published ISO), the newest generated_at wins; generated_at is zero-padded
# ISO 8601 UTC, so a lexical compare is a time compare.
collect_iso_images() {
  local names=() name
  mapfile -t names < <(
    rclone lsf "$remote/" --files-only --include '*.json' 2>/dev/null \
      | grep -Ev '^latest.*\.json$' || true
  )

  : > "$tmp/manifests.ndjson"
  for name in "${names[@]}"; do
    [[ -n $name ]] || continue
    if ! rclone cat "$remote/$name" > "$tmp/manifest.json" 2>/dev/null || [[ ! -s "$tmp/manifest.json" ]]; then
      echo "ryoku-release-ledger: could not read $name; skipped" >&2
      continue
    fi
    # An ISO manifest names its release (installer_ref) and variant, and points
    # at the bucket files (files.*). Anything else at the root is not one.
    if ! jq -e '(.installer_ref | type == "string")
                and (.variant | type == "string")
                and (.files | type == "object")' "$tmp/manifest.json" >/dev/null 2>&1; then
      echo "ryoku-release-ledger: $name is not an ISO manifest; skipped" >&2
      continue
    fi
    variant=$(jq -r '.variant' "$tmp/manifest.json")
    case ",$variants," in
      *",$variant,"*) ;;
      *) continue ;;
    esac
    # Carry the manifest's own field names through unchanged: the images entry
    # is the bucket-root object names (files.*) plus the public ISO url, so a
    # consumer can fetch either the ISO or its checksum/signature/manifest.
    jq -c '{
      tag: .installer_ref,
      variant: .variant,
      generated_at: (.generated_at // ""),
      entry: {
        iso: .files.iso,
        manifest: .files.manifest,
        sha256: .files.sha256,
        signature: .files.signature,
        url: (.url // ""),
        date: (.date // "")
      }
    }' "$tmp/manifest.json" >> "$tmp/manifests.ndjson"
  done

  if [[ ! -s "$tmp/manifests.ndjson" ]]; then
    echo '{}'
    return
  fi
  jq -s '
    reduce .[] as $m ({};
      (.[$m.tag][$m.variant]) as $cur
      | if $cur == null or ($m.generated_at > $cur.generated_at)
        then .[$m.tag][$m.variant] = {generated_at: $m.generated_at, entry: $m.entry}
        else . end)
    | map_values(map_values(.entry))
  ' "$tmp/manifests.ndjson"
}

if [[ $channel == stable ]]; then
  mapfile -t directories < <(
    rclone lsf "$remote/$release_root/" --dirs-only 2>/dev/null \
      | sed 's|/$||' | grep -E '^v[0-9]' || true
  )
else
  mapfile -t directories < <(
    rclone lsf "$remote/$release_root/" --dirs-only 2>/dev/null \
      | sed 's|/$||' | grep -v '^$' || true
  )
fi
entries=()
for directory in "${directories[@]}"; do
  metadata="$tmp/$directory.json"
  if ! rclone cat "$remote/$release_root/$directory/x86_64/release.json" > "$metadata" 2>/dev/null || [[ ! -s "$metadata" ]]; then
    echo "ryoku-release-ledger: $directory has no release.json; skipped" >&2
    continue
  fi
  if [[ $channel == testing ]]; then
    if ! tag=$(jq -er '.release | select(type == "string" and length > 0)' "$metadata"); then
      echo "ryoku-release-ledger: $directory has no release name; skipped" >&2
      continue
    fi
  else
    tag=$directory
  fi
  entries+=("$(jq -c --arg tag "$tag" --arg repo "$release_root/$directory/x86_64" \
    '{tag: $tag, name: (.name // ""), version: .version, commit: .commit, date: .date, repo: $repo}' "$metadata")")
done

if [[ $channel == stable ]]; then
  if [[ -n $variants ]]; then
    collect_iso_images > "$tmp/images.json"
  else
    echo '{}' > "$tmp/images.json"
  fi
fi
if (( ${#entries[@]} == 0 )); then
  echo '{"schema":1,"latest":"","releases":[]}' > "$tmp/index.json"
elif [[ $channel == stable ]]; then
  # Attach each release's images map, keyed by its tag. A variant with no ISO
  # simply has no key, and a release with no images at all keeps no images key,
  # so a consumer that ignores images reads byte-identical entries. schema stays
  # 1 (the change is additive; no reader validates it) and the sort/latest
  # semantics are unchanged.
  printf '%s\n' "${entries[@]}" | jq -s --slurpfile images "$tmp/images.json" '
    ($images[0] // {}) as $img
    | map(. + (($img[.tag] // {}) as $m | if ($m | length) > 0 then {images: $m} else {} end))
    | sort_by(.date) | reverse
    | {schema: 1, latest: (.[0].tag // ""), releases: .}' > "$tmp/index.json"
else
  printf '%s\n' "${entries[@]}" | jq -s '
    sort_by(.date) | reverse
    | {schema: 1, latest: (.[0].tag // ""), releases: .}' > "$tmp/index.json"
fi
[[ -s "$tmp/index.json" ]] || { echo "ryoku-release-ledger: produced an empty ledger; refusing to upload" >&2; exit 1; }
rclone copyto "$tmp/index.json" "$remote/$ledger_root/index.json" --header-upload "Cache-Control: no-cache, must-revalidate"
cat "$tmp/index.json"
