#!/usr/bin/env bash
# Check every source copy that must stay byte-identical to its owner.
# Go's vendor command omits tests and module metadata, so compare only files
# present in each copy.
#
#   ryoku-dev-verify-wm-vendor           run the check (exit 1 on drift)
#   ryoku-dev-verify-wm-vendor --quiet   same, only print drift
set -euo pipefail

quiet=0
[[ ${1:-} == --quiet ]] && quiet=1
say() { (( quiet )) || printf '%s\n' "$*"; }

repo="$(git rev-parse --show-toplevel)"
cd "$repo"

seam=ryoku/wm
shopt -s nullglob
status=0

mapfile -t dirs < <(git ls-files | grep -E '/vendor/ryoku-wm/[^/]+\.go$' | sed -E 's|/[^/]+$||' | sort -u)
for dir in "${dirs[@]}"; do
  for f in "$dir"/*.go; do
    base="$(basename "$f")"
    case $base in *_test.go) continue ;; esac
    if [[ ! -f "$seam/$base" ]] || ! cmp -s "$f" "$seam/$base"; then
      printf 'wm-vendor: %s differs from %s/%s\n' "$f" "$seam" "$base"
      status=1
    fi
  done
done

check_vendor_tree() {
  local source=$1 vendor=$2 label=$3 file rel
  if [[ ! -d $vendor ]]; then
    printf 'vendor: %s copy is missing at %s\n' "$label" "$vendor"
    status=1
    return
  fi
  while IFS= read -r -d '' file; do
    rel=${file#"$vendor"/}
    if [[ ! -f $source/$rel ]] || ! cmp -s "$file" "$source/$rel"; then
      printf 'vendor: %s copy %s differs from %s/%s\n' "$label" "$file" "$source" "$rel"
      status=1
    fi
  done < <(find "$vendor" -type f -print0)
}

check_vendor_tree ryoku/i18n ryoku/rashin/vendor/ryoku-i18n ryoku-i18n
check_vendor_tree docs/lithic/library/go \
  ryoku/rashin/vendor/github.com/ryoku-dev/ryoku/docs/lithic/library/go lithic-go

(( status == 0 )) && say "vendor: window-manager seams, ryoku-i18n and Lithic Go copies match their sources"
exit "$status"
