#!/usr/bin/env bash
# next Ryoku version after the repo-root VERSION file, or after the version
# given as the third argument.
#
#   ryoku-release-bump <patch|minor|major|roll> <alpha|beta|stable|keep> [version]
#
# prints the bumped version, no leading "v". stable = bare semver; alpha/beta
# append "-<stage>.0"; keep preserves the current pre-release suffix. roll bumps
# the patch but carries to the next minor once it passes 9 (0.1.9 -> 0.2.0);
# the unstable bump runs `roll keep <main's VERSION>` to name the next release.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

bump=${1:?usage: ryoku-release-bump <patch|minor|major|roll> <alpha|beta|stable|keep> [version]}
stage=${2:?usage: ryoku-release-bump <patch|minor|major|roll> <alpha|beta|stable|keep> [version]}
base=${3:-$(tr -d '[:space:]' < "$ROOT/VERSION")}
[[ $base =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$ ]] \
  || { echo "ryoku-release-bump: not a version: $base" >&2; exit 2; }

IFS=. read -r major minor patch <<<"${base%%-*}"

case "$bump" in
  major) major=$((major + 1)); minor=0; patch=0 ;;
  minor) minor=$((minor + 1)); patch=0 ;;
  patch) patch=$((patch + 1)) ;;
  roll)
    if (( patch >= 9 )); then
      minor=$((minor + 1)); patch=0
    else
      patch=$((patch + 1))
    fi
    ;;
  *) echo "ryoku-release-bump: unknown bump type: $bump" >&2; exit 2 ;;
esac

next="${major}.${minor}.${patch}"

case "$stage" in
  stable) printf '%s\n' "$next" ;;
  alpha|beta) printf '%s-%s.0\n' "$next" "$stage" ;;
  keep)
    suffix=""
    [[ $base == *-* ]] && suffix="-${base#*-}"
    printf '%s%s\n' "$next" "$suffix"
    ;;
  *) echo "ryoku-release-bump: unknown stage: $stage" >&2; exit 2 ;;
esac
