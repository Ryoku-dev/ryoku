# Maintainer: Ryoku <releases@ryoku.dev>
#
# The vendor tree keeps repository builds offline.
pkgname=ryoku-rashin
install=ryoku-rashin.install
pkgver=${RYOKU_PKGVER:-0.1.0}
pkgrel=1
pkgdesc="Ryoku Rashin AI system"
arch=('x86_64')
url="https://ryoku.dev"
license=('GPL-3.0-or-later')
# Keep Rashin on the same update as its desktop integration.
depends=(
  "ryoku-desktop=$pkgver"
  'wayland'
  'libxkbcommon'
  'mesa'
  'libglvnd'
  'vulkan-icd-loader'
  # Teams run their agents, and the programs those open, inside bwrap.
  'bubblewrap'
)
makedepends=('go' 'pkgconf' 'vulkan-headers')
source=()

_repo="$startdir/../../.."

build() {
  RYOKU_SRC="$_repo" \
  RYOKU_BUILD_DIR="$srcdir" \
  RYOKU_PKGVER="$pkgver" \
  RYOKU_RELEASE="${RYOKU_RELEASE:-$pkgver}" \
  RYOKU_CHANNEL="${RYOKU_CHANNEL:-stable}" \
  RYOKU_NAME="${RYOKU_NAME:-Ryoku}" \
    "$startdir/payload.sh" build
}

package() {
  RYOKU_SRC="$_repo" \
  RYOKU_BUILD_DIR="$srcdir" \
  RYOKU_PKGVER="$pkgver" \
  RYOKU_RELEASE="${RYOKU_RELEASE:-$pkgver}" \
  RYOKU_CHANNEL="${RYOKU_CHANNEL:-stable}" \
  RYOKU_NAME="${RYOKU_NAME:-Ryoku}" \
    "$startdir/payload.sh" install "$pkgdir" systemd
}
