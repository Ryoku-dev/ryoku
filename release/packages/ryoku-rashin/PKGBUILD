# Maintainer: Ryoku <releases@ryoku.dev>
#
# The vendor tree keeps repository builds offline.
pkgname=ryoku-rashin
install=ryoku-rashin.install
pkgver=${RYOKU_PKGVER:-0.1.0}
pkgrel=1
pkgdesc="Ryoku Rashin AI system"
arch=('x86_64')
url="https://ryoku.dev"
# The app's Material Symbols icons are Apache-2.0 and its Geologica and Martian
# Mono faces OFL-1.1; the vendored Hindsight client is MIT and its validator
# Apache-2.0; memory adapts MIT code and prompts (Hermes Agent, OpenClaw,
# Hindsight, nanobot, PicoClaw, Engram) and Apache-2.0 ones (Codex, mem0, Letta,
# Letta Code); the built-in skill sets are MIT (Superpowers, OpenSpec, Spec Kit)
# and Apache-2.0 (Elephant and Goldfish); the rest of the package is
# GPL-3.0-or-later.
license=('GPL-3.0-or-later' 'Apache-2.0' 'OFL-1.1' 'MIT')
# Keep Rashin on the same update as its desktop integration.
depends=(
  "ryoku-desktop=$pkgver"
  'wayland'
  'libxkbcommon'
  'mesa'
  'libglvnd'
  'vulkan-icd-loader'
  # Teams run their agents, and the programs those open, inside bwrap.
  'bubblewrap'
)
# Rashin installs Hindsight, its optional memory engine, with uv only when asked.
optdepends=('uv: set up Hindsight, the optional memory engine, on this computer')
makedepends=('go' 'pkgconf' 'vulkan-headers')
source=()

_repo="$startdir/../../.."

build() {
  RYOKU_SRC="$_repo" \
  RYOKU_BUILD_DIR="$srcdir" \
  RYOKU_PKGVER="$pkgver" \
  RYOKU_RELEASE="${RYOKU_RELEASE:-$pkgver}" \
  RYOKU_CHANNEL="${RYOKU_CHANNEL:-stable}" \
  RYOKU_NAME="${RYOKU_NAME:-Ryoku}" \
    "$startdir/payload.sh" build
}

package() {
  RYOKU_SRC="$_repo" \
  RYOKU_BUILD_DIR="$srcdir" \
  RYOKU_PKGVER="$pkgver" \
  RYOKU_RELEASE="${RYOKU_RELEASE:-$pkgver}" \
  RYOKU_CHANNEL="${RYOKU_CHANNEL:-stable}" \
  RYOKU_NAME="${RYOKU_NAME:-Ryoku}" \
    "$startdir/payload.sh" install "$pkgdir" systemd
}
