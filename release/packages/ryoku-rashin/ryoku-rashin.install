# shellcheck shell=bash
_remove_legacy_global_units() {
  systemctl --global disable ryoku-ai-usage.timer >/dev/null 2>&1 || true
  rm -f /etc/systemd/user/default.target.wants/ryoku-rashin.service
}

post_install() {
  _remove_legacy_global_units
}

post_upgrade() {
  _remove_legacy_global_units
}

post_remove() {
  systemctl --global disable rashind.socket rashind.service ryoku-ai-usage.timer >/dev/null 2>&1 || true
}
