# Maintainer: Ryoku <releases@ryoku.dev>
#
# Ryogami: the Ryoku wallpaper daemon (Go) and its picker. One process owns the
# wallpaper catalog (thumbnails, colours, favourites), applies through the
# in-shell surface topic, the matugen palette, and the depth surface, behind
# ryoku's line pub/sub on $XDG_RUNTIME_DIR/ryogami.sock. Its front end is the
# Ryoku.Ryogami picker: a Qt Quick surface with a C++ GPU card renderer, built
# here and installed onto the QML import path; the daemon spawns it through
# quickshell. Wallpaper Engine scenes render through skwd-paper.
#
# built from the in-repo Go module at ryoku/shell/ryogami/daemon and the picker
# module at ryoku/shell/ryogami/picker, no tarball fetched. publish CI runs
# makepkg inside this dir against a full checkout, so the repo root is three
# levels up; go and the picker build into $srcdir so the source tree stays
# untouched.
pkgname=ryogami
pkgver=${RYOKU_PKGVER:-0.2.0}
pkgrel=1
pkgdesc="Ryogami: the Ryoku wallpaper daemon and Qt Quick picker (catalog, thumbnails, applies, depth)"
arch=('x86_64')
url="https://ryoku.dev"
# GPL-3.0-or-later: the picker ports skwd-wall v2; its LICENSE and NOTICE ship below.
license=('GPL-3.0-or-later')
# runtime tools the daemon shells out to: imagemagick + ffmpeg (thumbnails,
# colour extraction, the livewall transcode) and quickshell (spawns the picker).
# Video wallpapers play through the bundled ryogami-live, built here from
# ryoku/shell/livewall. qt6-multimedia backs the picker's video previews,
# qt6-imageformats decodes WebP/AVIF thumbnails, and Wallpaper Engine scenes
# render through skwd-paper.
depends=('imagemagick' 'ffmpeg' 'quickshell'
         'qt6-multimedia' 'qt6-imageformats' 'skwd-paper-bin')
makedepends=('go' 'wayland' 'wayland-protocols' 'cmake' 'ninja' 'qt6-shadertools'
             'qt6-declarative' 'qt6-multimedia' 'vulkan-headers')
optdepends=('yt-dlp: YouTube wallpaper source'
            'steamcmd: Steam Workshop downloads without the Steam client')
source=()

_repo="$startdir/../../.."

build() {
  RYOKU_SRC="$_repo" \
  RYOKU_BUILD_DIR="$srcdir" \
  RYOKU_PKGVER="$pkgver" \
  RYOKU_RELEASE="${RYOKU_RELEASE:-$pkgver}" \
  RYOKU_CHANNEL="${RYOKU_CHANNEL:-stable}" \
  RYOKU_NAME="${RYOKU_NAME:-Ryoku}" \
    "$startdir/payload.sh" build
}

package() {
  RYOKU_SRC="$_repo" \
  RYOKU_BUILD_DIR="$srcdir" \
  RYOKU_PKGVER="$pkgver" \
  RYOKU_RELEASE="${RYOKU_RELEASE:-$pkgver}" \
  RYOKU_CHANNEL="${RYOKU_CHANNEL:-stable}" \
  RYOKU_NAME="${RYOKU_NAME:-Ryoku}" \
    "$startdir/payload.sh" install "$pkgdir" systemd

  # The picker plugin is refused by a Qt older than the one it was built
  # against; pin that minor so pacman takes Qt along with this package.
  local qt; qt="$(pkg-config --modversion Qt6Core | cut -d. -f1,2)"
  depends+=("qt6-base>=$qt" "qt6-declarative>=$qt" "qt6-multimedia>=$qt")
}
