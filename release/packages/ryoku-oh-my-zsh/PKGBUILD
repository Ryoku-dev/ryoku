# Maintainer: Ryoku <releases@ryoku.dev>
#
# Oh My Zsh framework, packaged by Ryoku so it reaches existing users through
# the signed repository instead of relying on a fresh install's best-effort AUR
# pass. Ryoku's zsh loader disables its self-updater; pacman owns this tree.
pkgname=ryoku-oh-my-zsh
pkgver=${RYOKU_PKGVER:-0.1.0}
pkgrel=1
epoch=1
pkgdesc="Oh My Zsh framework for the Ryoku Zsh integration"
arch=('any')
url='https://github.com/ohmyzsh/ohmyzsh'
license=('MIT')
# Supersede the AUR builds that own /usr/share/oh-my-zsh: without this, a box
# that already has oh-my-zsh-git installed aborts the update with hundreds of
# "exists in filesystem" file conflicts, and replaces makes pacman swap them
# out. Providing them matters just as much: CachyOS-era installs carry
# cachyos-zsh-config, which depends on 'oh-my-zsh-git', so a conflict without
# the provide deadlocks the whole upgrade (pacman offers the removal, then
# refuses it because the removal breaks that dependency).
provides=("oh-my-zsh=$epoch:$pkgver" "oh-my-zsh-git=$epoch:$pkgver")
conflicts=('oh-my-zsh' 'oh-my-zsh-git')
replaces=('oh-my-zsh' 'oh-my-zsh-git')
makedepends=('git')
_omz_commit=4b657407c98bbc8830ae66c2ac7ff3d737c55a83
source=("oh-my-zsh::git+$url.git#commit=$_omz_commit")
sha256sums=('SKIP')

package() {
  install -d "$pkgdir/usr/share/oh-my-zsh"
  cp -a oh-my-zsh/. "$pkgdir/usr/share/oh-my-zsh/"
  install -Dm644 oh-my-zsh/LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
