# Maintainer: Ryoku <releases@ryoku.dev>
#
# Ryoku Dictation: Ryoku's own voice typing engine.
#
# A small C++ daemon that records through PipeWire, transcribes locally with
# transcribe.cpp (Parakeet or Whisper, ggml) and types the words into the
# focused window over the Wayland virtual-keyboard protocol. It replaces the
# Voxtype dependency, its Python config editor and the cava meter.
#
# Speech models are downloaded separately in Settings.
pkgname=ryoku-dictation
pkgver=${RYOKU_PKGVER:-1.0.0}
pkgrel=1
pkgdesc="Ryoku voice typing: local speech-to-text with Parakeet and Whisper"
arch=('x86_64')
url="https://ryoku.dev"
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'pipewire' 'wayland' 'libxkbcommon' 'wl-clipboard' 'vulkan-icd-loader')
makedepends=('cmake' 'ninja' 'gcc' 'pkgconf' 'git' 'shaderc' 'vulkan-headers')
conflicts=('ryoku-dictation-vulkan')
replaces=('ryoku-dictation-vulkan')
source=()
sha256sums=()

_repo="$startdir/../../.."

build() {
  RYOKU_SRC="$_repo" \
  RYOKU_BUILD_DIR="$srcdir" \
    "$startdir/payload.sh" build
}

check() {
  ctest --test-dir "$srcdir/build" --output-on-failure
}

package() {
  RYOKU_SRC="$_repo" \
  RYOKU_BUILD_DIR="$srcdir" \
    "$startdir/payload.sh" install "$pkgdir" systemd
}
