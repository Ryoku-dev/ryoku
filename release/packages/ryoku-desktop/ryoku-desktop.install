_hint() {
  cat <<'EOF'
==> Run `ryoku materialize` as your user to lay the Ryoku base configs into
    ~/.config. The next login does this on its own (ryoku-bootstrap.service);
    running it now means the desktop is complete without a relogin.
EOF
}

# refresh the hicolor icon cache and the desktop database so shipped entries
# (the Ryoku VM launcher and its icon) resolve in the app launcher without a
# relogin. both guarded: absent tools are skipped, a stale run never fails.
_refresh() {
  if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
  fi
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications 2>/dev/null || true
  fi
}

# enable bluetooth.service exactly once, so installs that predate the bluez
# dependency get a running bluetoothd on upgrade (the shell/hub Bluetooth UIs
# are dead without it). The marker keeps this one-shot: a user who later
# disables the service stays disabled across upgrades. `start` only fires on a
# booted system; inside the installer chroot the enable symlink is enough.
_bluetooth() {
  [ -e /usr/lib/systemd/system/bluetooth.service ] || return 0
  local marker=/var/lib/ryoku/bluetooth-enabled
  [ -e "$marker" ] && return 0
  systemctl enable bluetooth.service 2>/dev/null || true
  if [ -d /run/systemd/system ]; then
    systemctl start bluetooth.service 2>/dev/null || true
  fi
  mkdir -p /var/lib/ryoku && : >"$marker"
}

# enable rtkit-daemon exactly once, so installs that predate the rtkit dependency
# get realtime scheduling for PipeWire on upgrade. without it PipeWire runs
# SCHED_OTHER and the audio thread underruns into crackling under load. Marker
# keeps it one-shot: a user who later disables it stays disabled across upgrades.
_rtkit() {
  [ -e /usr/lib/systemd/system/rtkit-daemon.service ] || return 0
  local marker=/var/lib/ryoku/rtkit-enabled
  [ -e "$marker" ] && return 0
  systemctl enable rtkit-daemon.service 2>/dev/null || true
  if [ -d /run/systemd/system ]; then
    systemctl start rtkit-daemon.service 2>/dev/null || true
  fi
  mkdir -p /var/lib/ryoku && : >"$marker"
}

# enable power-profiles-daemon exactly once, so power-mode switching persists and
# the daemon is reliably running -- it is only D-Bus activated otherwise, and the
# shell's power-profile UI silently fails when it isn't up. Marker keeps it
# one-shot: a user who later disables the service stays disabled across upgrades.
# `start` only fires on a booted system; inside the installer chroot the enable
# symlink is enough.
_powerprofiles() {
  [ -e /usr/lib/systemd/system/power-profiles-daemon.service ] || return 0
  local marker=/var/lib/ryoku/power-profiles-enabled
  [ -e "$marker" ] && return 0
  systemctl enable power-profiles-daemon.service 2>/dev/null || true
  if [ -d /run/systemd/system ]; then
    systemctl start power-profiles-daemon.service 2>/dev/null || true
  fi
  mkdir -p /var/lib/ryoku && : >"$marker"
}

# Package installs, upgrades, downgrades, and removal are adopted by paired
# pre/post transaction hooks. Removal restores the remaining/default logind
# policy immediately.
_restore_logind() {
  [ -d /run/systemd/system ] || return 0
  systemctl reload systemd-logind 2>/dev/null || true
}

# The transaction that first installs the ALPM hooks cannot run their
# PreTransaction half because libalpm loaded the old hook set. Package adoption
# can also replace a checkout-installed live desktop through pre_install.
# Both pre-extraction scriptlets establish the durable root sleep block while
# all old lid and shell owners are still intact.
_pre_upgrade_power_guard() {
  local systemd_runtime="${RYOKU_SYSTEMD_RUNTIME_DIR:-/run/systemd/system}"
  local unit=ryoku-power-cutover-guard.service attempt=0 inhibitors
  [ -d "$systemd_runtime" ] || return 0
  for command in systemctl systemd-run systemd-inhibit grep; do
    command -v "$command" >/dev/null 2>&1 || {
      echo "==> ERROR: $command is required for guarded power-policy upgrade" >&2
      return 1
    }
  done
  if ! systemctl is-active --quiet "$unit"; then
    systemctl reset-failed "$unit" >/dev/null 2>&1 || true
    systemd-run --quiet --collect --unit="$unit" \
      --property=Type=exec --property=TimeoutStopSec=5s \
      /usr/bin/systemd-inhibit --what=sleep --mode=block \
      --who=ryoku-package-cutover \
      --why="keep sleep blocked while Ryoku replaces session power owners" \
      sleep infinity
  fi
  while [ "$attempt" -lt 40 ]; do
    inhibitors="$(systemd-inhibit --list --no-pager --no-legend 2>/dev/null || true)"
    if systemctl is-active --quiet "$unit" &&
       printf '%s\n' "$inhibitors" | grep -q 'ryoku-package-cutover' &&
       printf '%s\n' "$inhibitors" | grep -q 'sleep.*block'; then
      return 0
    fi
    attempt=$((attempt + 1))
    sleep 0.05
  done
  echo "==> ERROR: could not acquire the pre-extraction sleep block" >&2
  return 1
}

# libalpm loads hooks before extracting a transaction, so the release that
# first introduces the hooks cannot run them itself. A direct pacman transaction
# schedules guarded adoption after the database lock drops. `ryoku update`
# suppresses that detached job and invokes the all-session helper synchronously
# from stage two. Successful adoption writes the marker; later transactions use
# the paired hooks directly.
_schedule_power_cutover() {
  local systemd_runtime="${RYOKU_SYSTEMD_RUNTIME_DIR:-/run/systemd/system}"
  local helper="${RYOKU_POWER_CUTOVER_HELPER:-/usr/bin/ryoku-power-cutover}"
  local marker="${RYOKU_POWER_CUTOVER_MARKER:-/var/lib/ryoku/power-cutover-hook-active}"
  [ "${RYOKU_MANAGED_UPDATE:-0}" != 1 ] || return 0
  [ -d "$systemd_runtime" ] || return 0
  [ -x "$helper" ] || return 0
  [ ! -e "$marker" ] || return 0
  if ! command -v systemd-run >/dev/null 2>&1; then
    echo "==> ERROR: systemd-run is required to adopt the new power policy" >&2
    return 1
  fi
  if ! systemd-run --quiet --collect --no-block \
      --unit="ryoku-power-cutover-migration-$$" \
      --property=Type=exec --property=Restart=on-failure \
      --property=RestartSec=1s --property=StartLimitIntervalSec=0 \
      "$helper" package-deferred >/dev/null 2>&1; then
    echo "==> ERROR: could not schedule the guarded power-policy cutover" >&2
    return 1
  fi
}

# tune bluez main.conf in place (Experimental battery reporting, fast + robust
# reconnect, AutoEnable). bluez owns the file and BlueZ has no drop-in dir, so
# Ryoku edits it idempotently instead of shipping a conflicting copy. Re-applied
# on upgrade in case a bluez update reset it; restart bluetoothd so keys apply now.
_bluetooth_tune() {
  command -v ryoku-bluetooth-tune >/dev/null 2>&1 || return 0
  ryoku-bluetooth-tune >/dev/null 2>&1 || true
  if [ -d /run/systemd/system ]; then
    systemctl try-restart bluetooth.service 2>/dev/null || true
  fi
}

# pin the Wi-Fi regulatory domain so 5 GHz is usable. `apply` is idempotent: it
# seeds iwd's 5 GHz rank nudge when absent and re-asserts the persisted country
# when the live domain drifted. It never invents a country, so a box the
# installer never set one on is left alone. Re-applied on upgrade in case an iwd
# update reset main.conf.
_wifi_regdom() {
  command -v ryoku-wifi-regdom >/dev/null 2>&1 || return 0
  ryoku-wifi-regdom apply >/dev/null 2>&1 || true
}

# ASUS AMD+NVIDIA panels register only nvidia_wmi_ec_backlight and hide
# amdgpu_bl0, so brightness will not lower. ryoku-hw-backlight-fix adds
# acpi_backlight=native (hardware-gated + idempotent, a no-op on every other
# box) and bakes it into the UKI. Takes effect on the next reboot.
_backlight_fix() {
  command -v ryoku-hw-backlight-fix >/dev/null 2>&1 || return 0
  ryoku-hw-backlight-fix >/dev/null 2>&1 || true
}

# enable the AI-usage collector timer exactly once via --global, so every user
# picks it up (the units live in /usr/lib/systemd/user). --global only writes the
# timers.target.wants symlink; the timer arms on the user's next login. Marker
# keeps it one-shot: a user who later disables it stays disabled across upgrades.
_ai_usage_timer() {
  [ -e /usr/lib/systemd/user/ryoku-ai-usage.timer ] || return 0
  local marker=/var/lib/ryoku/ai-usage-timer-enabled
  [ -e "$marker" ] && return 0
  systemctl --global enable ryoku-ai-usage.timer 2>/dev/null || true
  mkdir -p /var/lib/ryoku && : >"$marker"
}

# enable the Bluetooth A2DP-race reset unit once via --global (the unit lives in
# /usr/lib/systemd/user), so every user picks it up on next login. Marker keeps
# it one-shot: a user who later disables it stays disabled across upgrades.
_bt_reset_unit() {
  [ -e /usr/lib/systemd/user/ryoku-bluetooth-reset.service ] || return 0
  local marker=/var/lib/ryoku/bt-reset-enabled
  [ -e "$marker" ] && return 0
  systemctl --global enable ryoku-bluetooth-reset.service 2>/dev/null || true
  mkdir -p /var/lib/ryoku && : >"$marker"
}

# enable the config bootstrap once via --global, so every user picks it up on next
# login (the units live in /usr/lib/systemd/user). A plain package install lays
# nothing into ~/.config, and a session with no laid-down config is a bare
# compositor: no keybinds, no shell autostart, no wallpaper. Marker keeps this
# one-shot: a user who disables the unit stays disabled across upgrades.
_bootstrap() {
  [ -e /usr/lib/systemd/user/ryoku-bootstrap.service ] || return 0
  local marker=/var/lib/ryoku/bootstrap-enabled
  [ -e "$marker" ] && return 0
  systemctl --global enable ryoku-bootstrap.service 2>/dev/null || true
  mkdir -p /var/lib/ryoku && : >"$marker"
}

# The kill switch owns its boot dependency: only an explicitly armed switch
# leaves the units enabled. An unarmed upgrade removes legacy dependencies.
_network_kill_units() {
  [ -e /var/lib/ryoku/network-kill-switch.enabled ] && return 0
  systemctl disable ryoku-network-kill-guard.service \
    ryoku-network-kill-disconnect.service 2>/dev/null || true
}

# apply the boot splash + Limine theme when an upgrade ships new art; a no-op in
# the install chroot, where the installer lays the boot chain.
_boot_theme() {
  command -v ryoku-boot-apply >/dev/null 2>&1 || return 0
  ryoku-boot-apply >/dev/null 2>&1 || true
}


pre_install() {
  _pre_upgrade_power_guard
}

pre_upgrade() {
  _pre_upgrade_power_guard
}
post_install() {
  _refresh
  _bluetooth
  _bluetooth_tune
  _wifi_regdom
  _backlight_fix
  _rtkit
  _powerprofiles
  _ai_usage_timer
  _bt_reset_unit
  _bootstrap
  _boot_theme
  _hint
  _schedule_power_cutover
}

post_upgrade() {
  _refresh
  _bluetooth
  _bluetooth_tune
  _wifi_regdom
  _backlight_fix
  _rtkit
  _powerprofiles
  _ai_usage_timer
  _bt_reset_unit
  _boot_theme
  _network_kill_units
  _hint
  _schedule_power_cutover
}

post_remove() {
  _refresh
  _restore_logind
  rm -f /var/lib/ryoku/power-cutover-hook-active
}
