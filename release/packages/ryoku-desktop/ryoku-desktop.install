# shellcheck shell=bash
_hint() {
  cat <<'EOF'
==> Run `ryoku materialize` as your user to lay the Ryoku base configs into
    ~/.config. The next login does this on its own (ryoku-bootstrap.service);
    running it now means the desktop is complete without a relogin.
EOF
}

# refresh the hicolor icon cache and the desktop database so shipped entries
# (the Ryoku VM launcher and its icon) resolve in the app launcher without a
# relogin. both guarded: absent tools are skipped, a stale run never fails.
_refresh() {
  if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
  fi
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications 2>/dev/null || true
  fi
}

_reconcile_services() {
  command -v ryoku-host >/dev/null 2>&1 || return 0
  RYOKU_HOST_INIT=systemd ryoku-host svc reconcile --system >/dev/null 2>&1 || true
}

# libalpm reads hooks before extraction, so the release that first adds the
# post-transaction hook must reload once from its scriptlet.
_reload_polkit_migration() {
  local helper="${RYOKU_POLKIT_RELOAD_HELPER:-/usr/bin/ryoku-polkit-reload}"
  local marker="${RYOKU_POLKIT_RELOAD_MARKER:-/var/lib/ryoku/polkit-reload-hook-active}"
  [ ! -e "$marker" ] || return 0
  [ -x "$helper" ] || return 0
  if ! "$helper"; then
    echo "==> WARNING: could not reload Ryoku authorization rules" >&2
    return 0
  fi
  install -d -m 755 "${marker%/*}"
  : > "$marker"
}

# Package installs, upgrades, downgrades, and removal are adopted by paired
# pre/post transaction hooks. Removal restores the remaining/default logind
# policy immediately.
_restore_logind() {
  [ -d /run/systemd/system ] || return 0
  systemctl reload systemd-logind 2>/dev/null || true
}

# The transaction that first installs the ALPM hooks cannot run their
# PreTransaction half because libalpm loaded the old hook set. Package adoption
# can also replace a checkout-installed live desktop through pre_install.
# Both pre-extraction scriptlets establish the durable root sleep block while
# all old lid and shell owners are still intact.
_pre_upgrade_power_guard() {
  local systemd_runtime="${RYOKU_SYSTEMD_RUNTIME_DIR:-/run/systemd/system}"
  local unit=ryoku-power-cutover-guard.service attempt=0 inhibitors
  [ -d "$systemd_runtime" ] || return 0
  for command in systemctl systemd-run systemd-inhibit grep; do
    command -v "$command" >/dev/null 2>&1 || {
      echo "==> ERROR: $command is required for guarded power-policy upgrade" >&2
      return 1
    }
  done
  if ! systemctl is-active --quiet "$unit"; then
    systemctl reset-failed "$unit" >/dev/null 2>&1 || true
    systemd-run --quiet --collect --unit="$unit" \
      --property=Type=exec --property=TimeoutStopSec=5s \
      /usr/bin/systemd-inhibit --what=sleep --mode=block \
      --who=ryoku-package-cutover \
      --why="keep sleep blocked while Ryoku replaces session power owners" \
      sleep infinity
  fi
  while [ "$attempt" -lt 40 ]; do
    inhibitors="$(systemd-inhibit --list --no-pager --no-legend 2>/dev/null || true)"
    if systemctl is-active --quiet "$unit" &&
       printf '%s\n' "$inhibitors" | grep -q 'ryoku-package-cutover' &&
       printf '%s\n' "$inhibitors" | grep -q 'sleep.*block'; then
      return 0
    fi
    attempt=$((attempt + 1))
    sleep 0.05
  done
  echo "==> ERROR: could not acquire the pre-extraction sleep block" >&2
  return 1
}

# libalpm loads hooks before extracting a transaction, so the release that
# first introduces the hooks cannot run them itself. A direct pacman transaction
# schedules guarded adoption after the database lock drops. `ryoku update`
# suppresses that detached job and invokes the all-session helper synchronously
# from stage two. Successful adoption writes the marker; later transactions use
# the paired hooks directly.
_schedule_power_cutover() {
  local systemd_runtime="${RYOKU_SYSTEMD_RUNTIME_DIR:-/run/systemd/system}"
  local helper="${RYOKU_POWER_CUTOVER_HELPER:-/usr/bin/ryoku-power-cutover}"
  local marker="${RYOKU_POWER_CUTOVER_MARKER:-/var/lib/ryoku/power-cutover-hook-active}"
  [ "${RYOKU_MANAGED_UPDATE:-0}" != 1 ] || return 0
  [ -d "$systemd_runtime" ] || return 0
  [ -x "$helper" ] || return 0
  [ ! -e "$marker" ] || return 0
  if ! command -v systemd-run >/dev/null 2>&1; then
    echo "==> ERROR: systemd-run is required to adopt the new power policy" >&2
    return 1
  fi
  if ! systemd-run --quiet --collect --no-block \
      --unit="ryoku-power-cutover-migration-$$" \
      --property=Type=exec --property=Restart=on-failure \
      --property=RestartSec=1s --property=StartLimitIntervalSec=0 \
      "$helper" package-deferred >/dev/null 2>&1; then
    echo "==> ERROR: could not schedule the guarded power-policy cutover" >&2
    return 1
  fi
}

# tune bluez main.conf in place (Experimental battery reporting, fast + robust
# reconnect, AutoEnable). bluez owns the file and BlueZ has no drop-in dir, so
# Ryoku edits it idempotently instead of shipping a conflicting copy. Re-applied
# on upgrade in case a bluez update reset it; restart bluetoothd so keys apply now.
_bluetooth_tune() {
  command -v ryoku-bluetooth-tune >/dev/null 2>&1 || return 0
  ryoku-bluetooth-tune >/dev/null 2>&1 || true
  if [ -d /run/systemd/system ]; then
    systemctl try-restart bluetooth.service 2>/dev/null || true
  fi
}

# pin the Wi-Fi regulatory domain so 5 GHz is usable. `apply` is idempotent: it
# seeds iwd's 5 GHz rank nudge when absent and re-asserts the persisted country
# when the live domain drifted. It never invents a country, so a box the
# installer never set one on is left alone. Re-applied on upgrade in case an iwd
# update reset main.conf.
_wifi_regdom() {
  command -v ryoku-wifi-regdom >/dev/null 2>&1 || return 0
  ryoku-wifi-regdom apply >/dev/null 2>&1 || true
}

# FA506NCG needs its hidden native AMD backlight forced at boot. The helper
# allowlists that confirmed quirk and removes the former broad override from
# every other board, then bakes the result into the UKI for the next reboot.
_backlight_fix() {
  command -v ryoku-hw-backlight-fix >/dev/null 2>&1 || return 0
  ryoku-hw-backlight-fix >/dev/null 2>&1 || true
}


# apply the boot splash + Limine theme when an upgrade ships new art; a no-op in
# the install chroot, where the installer lays the boot chain.
_boot_theme() {
  command -v ryoku-boot-apply >/dev/null 2>&1 || return 0
  ryoku-boot-apply >/dev/null 2>&1 || true
}


pre_install() {
  _pre_upgrade_power_guard
}

pre_upgrade() {
  _pre_upgrade_power_guard
}
post_install() {
  _refresh
  _reload_polkit_migration
  _reconcile_services
  _bluetooth_tune
  _wifi_regdom
  _backlight_fix
  _boot_theme
  _hint
  _schedule_power_cutover
}

post_upgrade() {
  _refresh
  _reload_polkit_migration
  _reconcile_services
  _bluetooth_tune
  _wifi_regdom
  _backlight_fix
  _boot_theme
  _hint
  _schedule_power_cutover
}

post_remove() {
  _refresh
  _restore_logind
  rm -f /var/lib/ryoku/power-cutover-hook-active \
    /var/lib/ryoku/polkit-reload-hook-active
}
