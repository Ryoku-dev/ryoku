# Maintainer: Ryoku <releases@ryoku.dev>
#
# Ryoku desktop base: the compositor-neutral components + user-facing runtime.
# The compositor and its config ship from a sibling ryoku-desktop-<wm> variant
# this base pulls via the ryoku-desktop-compositor virtual. Lays the base config
# under /usr/share/ryoku/config, the helper scripts, and the GPU udev rule.
#
# built from in-repo sources, no tarball fetch. publish CI runs makepkg inside
# this dir from a full checkout, so the repo root is three levels up.
pkgname=ryoku-desktop
pkgver=${RYOKU_PKGVER:-0.1.0}
pkgrel=3
pkgdesc="Ryoku desktop: Quickshell configuration, helpers, and runtime (compositor-neutral base)"
# package() compiles Go helpers (ryovm-fetch), so the payload is arch-specific.
arch=('x86_64')
url="https://ryoku.dev"
# The Python bar style's ported QML stays AGPL-3.0-or-later (Serpantinum); the
# rest of the package is GPL-3.0-or-later. AGPL-3.0 s13 permits the combination.
license=('GPL-3.0-or-later' 'AGPL-3.0-or-later')
# go builds the app helpers (ryovm-fetch); cmake+Qt6 build any compiled ryoku/apps app.
makedepends=('go' 'cmake' 'ninja')
depends=(
  # Ryoku. the monorepo components are pinned to this build's own version:
  # every publish rebuilds them all with one shared RYOKU_PKGVER, and the shell
  # QML in this package must never run against another release's compiled
  # plugin or daemon (a partial upgrade now fails loudly instead of skewing).
  "ryoku-shell=$pkgver"
  "ryoku-hub=$pkgver"
  "ryoku-rashin=$pkgver"
  "ryoku-blobs=$pkgver"
  "ryoku=$pkgver"
  'ryoku-keyring'
  # the RyokuArch package manager (GlazePKG)
  'gpk'
  # a compositor variant provides this virtual; an installed base pulls the sole
  # provider (ryoku-desktop-hyprland) on the next -Syu with no user action.
  'ryoku-desktop-compositor'
  'xorg-xwayland'
  # CachyOS's SDDM greeter is still Qt5; QPA plugins are ABI-specific, so the
  # Qt6 plugin cannot provide the native Wayland platform to that greeter.
  'qt6-wayland'
  'qt5-wayland'
  'qt6-5compat'
  'qt6-svg'
  'gtk3'
  'webkit2gtk-4.1'
  # WebP/AVIF/etc image decoders (libqwebp.so and friends). qt6-base ships only
  # PNG/JPEG/GIF, but RyoStore and the ryostore catalogue deliver product
  # previews and screenshots as WebP; without this every rice, bundle, bar-style
  # and Fastfetch cover renders blank. A hard depend so the art shows on the ISO
  # and on existing boxes after `ryoku update`.
  'qt6-imageformats'
  # weston hosts the SDDM greeter as a Wayland compositor (weston --shell=kiosk),
  # so the greeter runs on Wayland like the session and SDDM tears it down
  # cleanly at login; the old X11 greeter was orphaned when a Wayland session
  # started and kept drawing power. Official extra repo, hard depend so it ships
  # on the ISO and reaches existing boxes on `ryoku update` -- a Wayland greeter
  # config without weston cannot start.
  'weston'
  'xdg-desktop-portal-gtk'
  # adw-gtk3 / adw-gtk3-dark, the GTK3 theme the Hyprland autostart selects
  # (gsettings gtk-theme). Unlike stock Adwaita it derives its 156 widget rules
  # from the named colours Ryoku generates, so the palette actually reaches GTK3
  # apps. A hard depend so `ryoku update` pulls it onto existing boxes: nothing
  # else brings it in, and without it the name resolves to nothing on disk and
  # GTK3 apps fall back to stock Adwaita.
  'adw-gtk-theme'
  # Adwaita-dark, kept for the "adwaita" gtkTheme option and because the portal
  # file chooser (GTK3) still wants it; otherwise it falls back to light in the
  # dark session. A hard depend so `ryoku update` pulls it onto existing boxes.
  'gnome-themes-extra'
  # Qt icon theme the shipped qt6ct.conf (config/qt6ct/qt6ct.conf) selects, so
  # named freedesktop icons (e.g. the Avahi entries' network-wired) resolve in
  # the launcher's all-apps grid instead of a broken-image placeholder.
  'papirus-icon-theme'
  # the Bibata XCursor set the desktop is configured against (env.lua +
  # autostart set XCURSOR_THEME/HYPRCURSOR_THEME to Bibata-Modern-Ice, the Hub
  # cursor picker defaults to it). ships from [ryoku], not the AUR, so a fresh
  # install and `ryoku update` always carry it: the old AUR theme was skipped
  # offline and never revisited by `ryoku update`, leaving the pointer on a lone
  # fallback bitmap. fixed upstream version, not the monorepo RYOKU_PKGVER; see
  # release/packages/ryoku-cursors/PKGBUILD.
  'ryoku-cursors'
  # the optional "Material Bibata" pointer in the Ryoku accent, offered as a
  # toggle on the Hub Cursor page. shipped so the toggle always resolves to an
  # installed theme, offline and after `ryoku update`, like ryoku-cursors above.
  # see release/packages/ryoku-cursor-material/PKGBUILD.
  'ryoku-cursor-material'
  # shell + the runtime the QML itself imports
  'quickshell'
  # KSyntaxHighlighting (org.kde.syntaxhighlighting QML module) colours code
  # blocks in the Super+S chat; the import is load-bearing, so it ships here.
  'syntax-highlighting'
  # The user-facing applications are deliberately NOT depends (see optdepends):
  # pacman re-satisfies a dependency list on every upgrade, so a hard depend
  # reinstalled apps people deleted. The ISO pacstraps them from
  # system/packages/base.packages and `ryoku doctor` delivers them once
  # (reconcile_shipped_apps.go). Tools the shell calls by name stay below.
  # tools the shipped autostart, pill, ryoshot, and helper scripts call by name
  'brightnessctl'
  'playerctl'
  # the launcher's "@" live radio: mpv plays the stream, mpv-mpris puts it on
  # the players bus, yt-dlp resolves the Lofi Girl live page at play time.
  'mpv'
  'mpv-mpris'
  'yt-dlp'
  'wl-clipboard'
  'wl-clip-persist'
  'cliphist'
  'grim'
  'slurp'
  'cava'
  # the visualiser's line style is an oscilloscope: wavecap.py (python) drives
  # pw-record (pipewire) to capture the sink monitor and downsample its waveform.
  # pactl (already used by the shell's audio-watch) resolves the monitor node.
  'python'
  'pipewire'
  'jq'
  'imagemagick'
  # matugen. material-you / base16 palette engine from the official extra repo.
  # the daemon runs it on every wallpaper change to derive colors.json and
  # retint kitty / Hyprland / the shell (the "match wallpaper" colors).
  'matugen'
  # ryogami: the wallpaper daemon the shell drives (`ryogami wallpaper ...`) over
  # ryogami.sock -- catalog, thumbnails, applies, transitions, live video and the
  # depth surface. Ships from [ryoku], so a fresh install and `ryoku update` always
  # carry it; it supersedes awww (the retired swww fork the shell no longer drives).
  # ryoku doctor enables its user unit and retires any old awww-daemon. See
  # release/packages/ryogami/PKGBUILD.
  'ryogami'
  # live (video) wallpapers: the daemon grabs one frame with ffmpeg to derive the
  # wallpaper palette. official repo, so a hard depend reaches existing boxes.
  'ffmpeg'
  # the shell's weather, calendar and screenshot upload, the Hub's location
  # search and the CLI's recovery helpers fetch with curl; a hard depend so they
  # work out of the box on the ISO and on existing boxes after `ryoku update`.
  'curl'
  # qt6-multimedia + qt6-declarative back the QML video surfaces: the wallpaper
  # picker's live previews, the shell's video-wallpaper preview, and qylock.
  # official repo, hard depends so they reach existing boxes on `ryoku update`.
  'qt6-multimedia'
  'qt6-declarative'
  # Hub's ISO picker (GPU passthrough VM) shells out to a file chooser
  'zenity'
  # Game Mode wifi power-save toggle (ryoku-wifi-powersave runs iw)
  'iw'
  # Full network isolation: ryoku-network-kill installs an inet nftables table
  # before deactivating NetworkManager, so Wi-Fi, Ethernet, VPN, LAN, IPv4 and
  # IPv6 have no path to leak through. Hard depend reaches existing boxes.
  'nftables'
  # Bluetooth: the pill link + Hub Connections drive bluetoothd over D-Bus
  # (Quickshell.Bluetooth) and shell out to bluetoothctl to pair; the .install
  # enables bluetooth.service once so upgrades from bluez-less installs work.
  'bluez'
  'bluez-utils'
  # FIDO2/U2F enrollment (`pamu2fcfg`) and PAM auth for YubiKeys and other
  # security keys. A hard depend so the Hub's setup flow works on fresh installs
  # and reaches existing boxes on `ryoku update`.
  'pam-u2f'
  # rtkit hands PipeWire's audio thread realtime scheduling; without it the
  # thread runs SCHED_OTHER and crackles under load. .install enables the daemon.
  'rtkit'
  # fonts the shell UI hardcodes: Inter, JetBrainsMono Nerd, Noto Sans CJK, and
  # Material Symbols Rounded (every pill/bar icon, via MaterialIcon.qml). all
  # official repo, so a hard depend reaches existing boxes on `ryoku update`;
  # without the symbols font each icon renders as its ligature name ("wifi").
  'ttf-jetbrains-mono-nerd'
  'inter-font'
  'noto-fonts'
  'noto-fonts-cjk'
  'noto-fonts-emoji'
  'ttf-material-symbols-variable'
  # ── feature tools promoted from optdepends to hard depends ────────────────
  # An optdepend never installs on `pacman -Syu`, so on a packaged box
  # (`ryoku update`) or a shell-installer box these advertised, always-on
  # features were silently dead, while the ISO had them (it pacstraps
  # system/packages/base.packages). Hard depends make the ISO, `ryoku update`,
  # and the shell installer converge on one desktop: the single source of truth.
  'tesseract'            # OCR text grab (pill Super+D)
  'tesseract-data-eng'   # English OCR language data
  'zbar'                 # QR-code scanning (pill Super+D)
  'gpu-screen-recorder'  # the screen recorder behind the capture card and `ryoku-shell record`
  'wtype'                # voice-dictation typing on Wayland (Voxtype)
  'libqalculate'         # calculator backend (launcher Super+Space)
  'upower'               # battery + power status (pill/bar battery indicator)
  'power-profiles-daemon'
  # external-monitor brightness over DDC/CI: the pill DISPLAY faders and the
  # XF86MonBrightness keys drive external displays through `ddcutil setvcp`.
  # was base.packages-only, so it never reached update/shell boxes (the pill
  # faders were silently dead there); a hard depend fixes every path.
  'ddcutil'
  # Two clients the Hyprland variant used to own that are protocol-neutral, not
  # Hyprland-specific: niri serves ext-idle-notify-v1 and wlr-screencopy/layer-
  # shell just the same. Shipping only with the Hyprland variant left a niri box
  # with no idle management and a dead color picker everywhere; base reaches both.
  'hypridle'             # idle daemon ryoku-idle renders a config for (ext-idle-notify-v1)
  'hyprpicker'           # screen color picker (ryoku-cmd-color-picker, Super+Shift+C)
  # Game controllers: xpadneo-dkms (Xbox One/Series Bluetooth pads, from the AUR
  # step) is a DKMS module, so it needs the kernel headers and the DKMS build
  # system to compile its module; without them the build silently fails and the
  # pad is not detected at all (users had to install linux-headers + dkms by
  # hand). linux-headers matches the base `linux` kernel; dkms's alpm hooks then
  # (re)build the module whenever headers land, so `ryoku update` pulling these
  # onto an existing box rebuilds an already-installed pad driver.
  'linux-headers'
  'dkms'
)
optdepends=(
  # The applications Ryoku ships. Optional here on purpose: the ISO pacstraps
  # them and `ryoku doctor` delivers them once to an existing box, so pacman
  # never has a missing dependency to "repair" and a deleted app stays deleted.
  'kitty: the default terminal'
  'fish: optional interactive shell'
  'blesh: Bash line editor'
  'zsh: optional interactive shell'
  'zsh-autosuggestions: command suggestions for Zsh'
  'zsh-history-substring-search: history search for Zsh'
  'zsh-syntax-highlighting: syntax highlighting for Zsh'
  "ryoku-oh-my-zsh=$pkgver: Ryoku prompt and plugins for Zsh"
  'starship: shell prompt'
  'fastfetch: system summary (launcher, RyoStore covers)'
  'yazi: terminal file manager'
  'neovim: the shipped editor'
  'nautilus: graphical file manager'
  'nautilus-python: Ryoku stash actions in the Nautilus right-click menu'
  'ryotunes: the Ryoku music app the now-playing widget follows'
  'waifu2x-ncnn-vulkan: AI upscale for ryoshot Beautify HD and ryowalls Enhance'
  'pavucontrol: GUI mixer behind the bar Open audio button'
  'songrec: Recognize Music in the launcher'
  'openrgb: keyboard and mouse lighting (Settings > Appearance > Lighting)'
  'gamescope: nested gaming micro-compositor'
  'gamemode: gaming performance governor Steam invokes'
  'mangohud: in-game FPS and frametime overlay'
  'chromium: web browser'
  'kdialog: folder picker fallback for rice export/import when zenity is absent'
  'plasma-integration: full KDE platform theme for KDE apps (Dolphin, Kate); set QT_QPA_PLATFORMTHEME=kde'
  'qemu-desktop: GPU-passthrough VM (Ryoku Settings > GPU)'
  'libvirt: VM management for the passthrough VM'
  'edk2-ovmf: UEFI and Secure Boot firmware for the VM'
  'swtpm: TPM 2.0 for the Windows 11 VM'
  'looking-glass: low-latency VM display in a desktop window'
  'quickemu: build and run virtual machines in ryovm'
  'libisoburn: instant cloud machines in ryovm (cloud-init seed ISO; xorriso)'
  'spice-gtk: SPICE console + headless VM viewer for ryovm'
  # ryoport's experimental consoles delegate to mature open-source clients:
  # picocom (GPL-2.0) for serial console cables, GNU telnet (inetutils,
  # GPL-3.0) for legacy network consoles, FreeRDP (Apache-2.0) for RDP
  # desktops, TigerVNC (GPL-2.0) for VNC screens. Optional by the same rule
  # as quickemu above: each missing client shows as an install hint on its
  # console page instead of a dead button.
  'picocom: serial console berths in ryoport'
  'inetutils: telnet berths in ryoport'
  'freerdp: RDP berths in ryoport'
  'tigervnc: VNC berths in ryoport'
  'asusctl: ASUS laptop Aura keyboard lighting'
  'qmk_hid: QMK/VIA keyboard lighting (Framework 16, custom boards)'
)
install="$pkgname.install"
source=()

_repo="$startdir/../../.."

build() {
  RYOKU_SRC="$_repo" \
    RYOKU_PKGVER="$pkgver" \
    RYOKU_RELEASE="${RYOKU_RELEASE:-}" \
    RYOKU_CHANNEL="${RYOKU_CHANNEL:-}" \
    RYOKU_NAME="${RYOKU_NAME:-}" \
    RYOKU_BUILD_DIR="$srcdir" \
    "$startdir/payload.sh" build
}

package() {
  RYOKU_SRC="$_repo" \
    RYOKU_PKGVER="$pkgver" \
    RYOKU_RELEASE="${RYOKU_RELEASE:-}" \
    RYOKU_CHANNEL="${RYOKU_CHANNEL:-}" \
    RYOKU_NAME="${RYOKU_NAME:-}" \
    RYOKU_BUILD_DIR="$srcdir" \
    "$startdir/payload.sh" install "$pkgdir" systemd
}

