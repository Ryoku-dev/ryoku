# Maintainer: Ryoku <releases@ryoku.dev>
#
# imgborders: a Hyprland compositor plugin that tiles an image around each window
# as its border. Installed as the un-prefixed imgborders.so under
# /usr/lib/hyprland/plugins/, loaded by the Hub's generated settings.lua (Borders
# tab, Image border) via hl.plugin.load; a missing or ABI-mismatched plugin is
# guarded there and degrades to off. The .abi receipt beside the .so records the
# compositor ABI it was built for, so the Hub's Plugins page and `ryoku doctor`
# can tell a build a Hyprland bump left behind from a working one without
# loading it.
#
# Hyprland plugins are ABI-locked to the compositor. prepare() reads the build
# host's Hyprland version and checks out the matching commit from the vendored
# hyprpm.toml (the same map hyprpm uses), so a [ryoku] rebuild always builds
# against whatever Hyprland it ships, with no manual commit bumps. When that map
# has no pin for the shipped Hyprland yet, prepare() falls back to the vendored
# default-branch HEAD (as hyprpm does) rather than failing. That HEAD carries
# Ryoku's Hyprland 0.57 render-context port; pinned versions still check out
# their exact source commits.
#
# Built from a vendored git bundle committed beside this recipe
# (imgborders.bundle = `git bundle create ... --all` of the upstream repo), so a
# [ryoku] build never clones from Codeberg. The bundle carries the full history
# and hyprpm.toml, so the ABI auto-resolve above still works offline. Refresh it
# (new upstream commits or Hyprland pins) with: git clone the upstream repo, then
# `git -C <checkout> bundle create imgborders.bundle --all`, and update sha256sums.
pkgname=imgborders
pkgver=${RYOKU_PKGVER:-0.1.0}
pkgrel=1
pkgdesc="Hyprland plugin: tiling image borders on windows"
arch=('x86_64')
url="https://codeberg.org/zacoons/imgborders"
license=('GPL-3.0-or-later')
depends=('hyprland')
makedepends=('hyprland' 'cmake' 'pkgconf' 'git' 'libdrm' 'pixman' 'pango' 'cairo')
source=("$pkgname.bundle")
noextract=("$pkgname.bundle")
sha256sums=('259f33251afa2b93edf635e96339d5080c89e120a4c6f23c5bade69978e91e70')

# the plugin ABI this build locks to, Hyprland's own client-hash formula:
# commit + major.minor of aquamarine, hyprutils, hyprgraphics, hyprcursor and
# hyprlang, read from the installed version.h.
_abi() {
  local h; h="$(pkg-config --variable=prefix hyprland)/hyprland/src/version.h"
  local v; v() { sed -n "s/^#define $1 *\"\([^\"]*\)\".*/\1/p" "$h" | sed 's/\.[^.]*$//'; }
  printf '%s_aq_%s_hu_%s_hg_%s_hc_%s_hlg_%s\n' \
    "$(sed -n 's/^#define GIT_COMMIT_HASH *"\([^"]*\)".*/\1/p' "$h")" \
    "$(v AQUAMARINE_VERSION)" "$(v HYPRUTILS_VERSION)" "$(v HYPRGRAPHICS_VERSION)" \
    "$(v HYPRCURSOR_VERSION)" "$(v HYPRLANG_VERSION)"
}

prepare() {
  git clone -q "$srcdir/$pkgname.bundle" "$srcdir/$pkgname"
  cd "$srcdir/$pkgname"
  local hv commit
  hv="$(pkg-config --modversion hyprland)"
  # hyprpm.toml lines: ["<hyprland-commit>", "<plugin-commit>"], # <version>
  commit="$(grep -F "$hv" hyprpm.toml | grep -oE '[0-9a-f]{40}' | sed -n 2p)"
  if [[ -n "$commit" ]]; then
    echo "PKGBUILD: $pkgname -> $commit (Hyprland $hv)"
    git checkout -q "$commit"
  else
    # no pin for this Hyprland yet: build the vendored default-branch HEAD.
    # That HEAD carries Ryoku's Hyprland 0.57 render-context port; failing here
    # would abort the whole [ryoku] publish under set -e.
    echo "PKGBUILD: no hyprpm.toml pin for Hyprland $hv; building $pkgname HEAD" >&2
  fi
}

build() {
  cd "$srcdir/$pkgname"
  cmake -B build -DCMAKE_BUILD_TYPE=Release
  cmake --build build
}

package() {
  install -Dm755 "$srcdir/$pkgname/build/libimgborders.so" \
    "$pkgdir/usr/lib/hyprland/plugins/imgborders.so"
  _abi | install -Dm644 /dev/stdin "$pkgdir/usr/lib/hyprland/plugins/imgborders.abi"
}
