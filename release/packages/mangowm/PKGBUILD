# Maintainer: Ryoku <releases@ryoku.dev>
#
# mangowm: the compositor itself, built from the tagged source. Arch's extra
# carries mangowm too, but its build ships the greeter entry as-is
# (Exec=mango): a first login on it boots the bare compositor with no
# keybinds, no autostart and no shell. Only a build that leaves the entry to
# ryoku-desktop-mango (whose Exec is the materializing wrapper) can back the
# desktop, so this one carries epoch=1 and the variant depends on
# mangowm>=1:0.17.4: an unversioned dep resolves by repo order, which puts
# extra first, but no epoch-less build can satisfy a >=1: constraint.
# Re-vendor on each tag Ryoku tracks.
#
# The greeter session entry and the portal routing file are NOT owned here:
# meson installs assets/mango.desktop and assets/mango-portals.conf, and
# ryoku-desktop-mango ships its own copies (the Exec line is a Ryoku wrapper,
# see its PKGBUILD). package() drops upstream's so exactly one package lays
# each path. mango-session.target stays: it is upstream's unit, and the
# compositor activates it itself, so Ryoku's session chain rides it unchanged.
pkgname=mangowm
_pkgname=mango
pkgver=0.17.4
pkgrel=1
epoch=1
pkgdesc="A Wayland compositor with smooth animation (Ryoku build, tagged release)"
arch=('x86_64')
url="https://github.com/mangowm/mango"
license=('GPL-3.0-or-later')
depends=(
  'wayland>=1.23.1'
  'libinput>=1.27.1'
  'libdrm'
  'pixman'
  'libxkbcommon'
  'pcre2'
  'pango'
  'cjson'
  'libxcb'
  'xcb-util-wm'
  'xcb-util-renderutil'
  'xorg-xwayland'
  'libwlroots-0.20.so'
  'libscenefx-0.5.so'
  'libglvnd'
)
makedepends=(
  'meson'
  'ninja'
  'wayland-protocols>=1.41'
)
provides=('wayland-compositor')
source=("$_pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('0891dc5650cf4b7daf0298ce9c188f7ff81792d872c1396febba022635d68c8e')
options=('!debug')

build() {
  arch-meson "$_pkgname-$pkgver" build
  meson compile -C build
}

package() {
  DESTDIR="$pkgdir" meson install -C build

  # The session entry and portal routing belong to ryoku-desktop-mango, which
  # owns the wrapper Exec line and keeps the file in step with caps.
  rm -f "$pkgdir/usr/share/wayland-sessions/mango.desktop" \
        "$pkgdir/usr/share/xdg-desktop-portal/mango-portals.conf"
  rmdir --ignore-fail-on-non-empty \
        "$pkgdir/usr/share/wayland-sessions" \
        "$pkgdir/usr/share/xdg-desktop-portal" 2>/dev/null || true
}
