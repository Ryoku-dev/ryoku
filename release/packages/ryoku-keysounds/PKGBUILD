# Maintainer: Ryoku <releases@ryoku.dev>
#
# ryoku-keysounds: Ryoku's own Hyprland compositor plugin, a keyboard sound on
# every key press (ryoku/hyprland/plugins/keysounds). Installed as keysounds.so
# under /usr/lib/hyprland/plugins/, loaded by the Hub's generated settings.lua
# (Plugins page, Key sounds) via hl.plugin.load.
#
# Hyprland plugins are ABI-locked to the compositor. This one lives in the
# monorepo, so it always builds against the Hyprland the build host has; the
# .abi receipt beside the .so records that ABI, so the Hub and `ryoku doctor`
# can tell a build left behind by a Hyprland bump from a working one without
# loading it. The plugin source also ships under /usr/share/ryoku/hypr-plugins,
# so a box without a checkout can rebuild it for a newer Hyprland
# (`ryoku-hub desktop plugins rebuild keysounds`).
#
# The sample profiles and the importer are their own package now
# (ryoku-keysounds-profiles), shared with niri's key-sounds engine: one copy of
# /usr/share/ryoku/keysounds serves both, and installing both variants never
# conflicts. The plugin reads them at runtime from that path.
pkgname=ryoku-keysounds
pkgver=${RYOKU_PKGVER:-0.1.0}
pkgrel=1
epoch=1
pkgdesc="Hyprland plugin: a keyboard sound on every key press, real switch recordings"
arch=('x86_64')
url="https://ryoku.dev"
license=('GPL-3.0-or-later')
depends=('hyprland' 'libcanberra' "ryoku-keysounds-profiles=$epoch:$pkgver")
makedepends=('hyprland' 'pkgconf' 'make' 'gcc' 'libcanberra' 'pixman' 'libdrm')
source=()

_repo="$startdir/../../.."
_src="$_repo/ryoku/hyprland/plugins/keysounds"

# the plugin ABI this build locks to, Hyprland's own client-hash formula:
# commit + major.minor of aquamarine, hyprutils, hyprgraphics, hyprcursor and
# hyprlang, read from the installed version.h.
_abi() {
  local h; h="$(pkg-config --variable=prefix hyprland)/hyprland/src/version.h"
  local v; v() { sed -n "s/^#define $1 *\"\([^\"]*\)\".*/\1/p" "$h" | sed 's/\.[^.]*$//'; }
  printf '%s_aq_%s_hu_%s_hg_%s_hc_%s_hlg_%s\n' \
    "$(sed -n 's/^#define GIT_COMMIT_HASH *"\([^"]*\)".*/\1/p' "$h")" \
    "$(v AQUAMARINE_VERSION)" "$(v HYPRUTILS_VERSION)" "$(v HYPRGRAPHICS_VERSION)" \
    "$(v HYPRCURSOR_VERSION)" "$(v HYPRLANG_VERSION)"
}

build() {
  # build a copy so the checkout stays clean; the samples are already installed
  # by ryoku-keysounds-profiles, so only the .so is built here.
  rm -rf "$srcdir/keysounds"
  cp -a "$_src" "$srcdir/keysounds"
  make -C "$srcdir/keysounds" keysounds.so
}

package() {
  install -Dm755 "$srcdir/keysounds/keysounds.so" "$pkgdir/usr/lib/hyprland/plugins/keysounds.so"
  _abi | install -Dm644 /dev/stdin "$pkgdir/usr/lib/hyprland/plugins/keysounds.abi"
  # the recipe, for a rebuild on a box with no checkout. profiles.txt stays with
  # the shared samples package, so `make keysounds.so` is the shipped recipe.
  install -d "$pkgdir/usr/share/ryoku/hypr-plugins/keysounds"
  install -Dm644 -t "$pkgdir/usr/share/ryoku/hypr-plugins/keysounds" \
    "$_src/main.cpp" "$_src/Makefile" "$_src/hyprpm.toml" "$_src/README.md"
}
