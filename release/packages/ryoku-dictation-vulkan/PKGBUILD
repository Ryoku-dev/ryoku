# Maintainer: Ryoku <releases@ryoku.dev>
#
# The Vulkan ggml backend for Ryoku dictation. This is not a second engine: it
# is one shared module that ryoku-dictate loads at startup, which is what turns
# Settings > Dictation > GPU from a reinstall into a switch.
#
# Built from the same pinned transcribe.cpp revision as ryoku-dictation, and it
# depends on that exact version, because a backend module and its core must be
# the same build.
pkgname=ryoku-dictation-vulkan
pkgver=${RYOKU_PKGVER:-1.0.0}
pkgrel=1
pkgdesc="Vulkan compute backend for Ryoku dictation"
arch=('x86_64')
url="https://ryoku.dev"
license=('MIT')
depends=("ryoku-dictation=${pkgver}" 'vulkan-icd-loader' 'gcc-libs')
# glslc ships in shaderc on Arch; the Vulkan headers build the ggml module.
makedepends=('cmake' 'ninja' 'gcc' 'pkgconf' 'git' 'shaderc' 'vulkan-headers')
source=()

_repo="$startdir/../../.."

build() {
  RYOKU_SRC="$_repo" \
  RYOKU_BUILD_DIR="$srcdir" \
    "$startdir/payload.sh" build
}

package() {
  RYOKU_SRC="$_repo" \
  RYOKU_BUILD_DIR="$srcdir" \
    "$startdir/payload.sh" install "$pkgdir"
}
