# Maintainer: Ryoku <releases@ryoku.dev>
#
# GlazePKG (gpk) = the official RyokuArch package manager. terminal dashboard
# that unifies every pkg manager on the system in one searchable view. ships in
# the [ryoku] repo and is a ryoku-desktop dep so a fresh install has it, vs
# leaning on the best-effort post-install AUR build.
#
# upstream is Go (github.com/neur0map/glazepkg); repackaged here from the
# pinned release binary, signed by the release key in the [ryoku] repo.
# `gpk update` self-updates from upstream after install.
pkgname=gpk
pkgver=0.6.10
pkgrel=1
pkgdesc="GlazePKG: the RyokuArch package manager, every package manager in one view"
arch=('x86_64' 'aarch64')
url="https://github.com/neur0map/glazepkg"
license=('GPL-3.0-or-later')
depends=('pacman')
provides=('gpk')
conflicts=('gpk-bin')
replaces=('gpk-bin')
options=('!strip' '!debug')
source_x86_64=("gpk-$pkgver-x86_64::https://github.com/neur0map/glazepkg/releases/download/v$pkgver/gpk-linux-amd64")
source_aarch64=("gpk-$pkgver-aarch64::https://github.com/neur0map/glazepkg/releases/download/v$pkgver/gpk-linux-arm64")
sha256sums_x86_64=('b4e43c2428a3c680f9ce97855d44522e18cfce4bb933e5e622c52d3db17a7be3')
sha256sums_aarch64=('39c4590c65630b134c51e34cdb040819a52513aaf72fb41e2d549eac83fa945b')

package() {
  if [[ $CARCH == aarch64 ]]; then
    install -Dm755 "$srcdir/gpk-$pkgver-aarch64" "$pkgdir/usr/bin/gpk"
  else
    install -Dm755 "$srcdir/gpk-$pkgver-x86_64" "$pkgdir/usr/bin/gpk"
  fi
}
