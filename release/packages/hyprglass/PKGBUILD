# Maintainer: Ryoku <releases@ryoku.dev>
#
# hyprglass: a Hyprland compositor plugin adding a liquid-glass blur / refraction
# effect to windows. Installed under /usr/lib/hyprland/plugins/, loaded by the
# Hub's generated settings.lua (Look tab, Glass) via hl.plugin.load; a missing or
# ABI-mismatched plugin is guarded there and degrades to off. The .abi receipt
# beside the .so records the compositor ABI it was built for, so the Hub's
# Plugins page and `ryoku doctor` can tell a build a Hyprland bump left behind
# from a working one without loading it.
#
# Hyprland plugins are ABI-locked to the compositor. prepare() reads the build
# host's Hyprland version and checks out the matching commit from upstream's
# hyprpm.toml (the same map hyprpm uses), so a [ryoku] rebuild always builds
# against whatever Hyprland it ships, with no manual commit bumps. When that map
# has no pin for the shipped Hyprland yet, prepare() falls back to the
# default-branch HEAD (as hyprpm does) rather than failing, so a Hyprland release
# outpacing the pin table can't abort the whole [ryoku] publish.
pkgname=hyprglass
pkgver=${RYOKU_PKGVER:-0.1.0}
pkgrel=1
epoch=1
pkgdesc="Hyprland plugin: liquid-glass blur and refraction on windows"
arch=('x86_64')
url="https://github.com/hyprnux/hyprglass"
license=('GPL-3.0-or-later')
depends=('hyprland')
makedepends=('hyprland' 'pkgconf' 'make' 'gcc' 'git' 'pixman' 'libdrm')
source=("$pkgname::git+https://github.com/hyprnux/hyprglass.git")
sha256sums=('SKIP')

# the plugin ABI this build locks to, Hyprland's own client-hash formula:
# commit + major.minor of aquamarine, hyprutils, hyprgraphics, hyprcursor and
# hyprlang, read from the installed version.h.
_abi() {
  local h; h="$(pkg-config --variable=prefix hyprland)/hyprland/src/version.h"
  local v; v() { sed -n "s/^#define $1 *\"\([^\"]*\)\".*/\1/p" "$h" | sed 's/\.[^.]*$//'; }
  printf '%s_aq_%s_hu_%s_hg_%s_hc_%s_hlg_%s\n' \
    "$(sed -n 's/^#define GIT_COMMIT_HASH *"\([^"]*\)".*/\1/p' "$h")" \
    "$(v AQUAMARINE_VERSION)" "$(v HYPRUTILS_VERSION)" "$(v HYPRGRAPHICS_VERSION)" \
    "$(v HYPRCURSOR_VERSION)" "$(v HYPRLANG_VERSION)"
}

prepare() {
  cd "$srcdir/$pkgname"
  local hv commit
  hv="$(pkg-config --modversion hyprland)"
  # hyprpm.toml lines: ["<hyprland-commit>", "<plugin-commit>"], # <version>
  commit="$(grep -F "$hv" hyprpm.toml | grep -oE '[0-9a-f]{40}' | sed -n 2p)"
  if [[ -n "$commit" ]]; then
    echo "PKGBUILD: $pkgname -> $commit (Hyprland $hv)"
    git checkout -q "$commit"
  else
    # no pin for this Hyprland yet: build the fetched default-branch HEAD, as
    # hyprpm does when no pin matches (upstream keeps HEAD on the latest
    # Hyprland). failing here would abort the whole [ryoku] publish under set -e.
    echo "PKGBUILD: no hyprpm.toml pin for Hyprland $hv; building $pkgname HEAD" >&2
  fi
}

build() {
  cd "$srcdir/$pkgname"
  make
}

package() {
  install -Dm755 "$srcdir/$pkgname/hyprglass.so" \
    "$pkgdir/usr/lib/hyprland/plugins/hyprglass.so"
  _abi | install -Dm644 /dev/stdin "$pkgdir/usr/lib/hyprland/plugins/hyprglass.abi"
}
