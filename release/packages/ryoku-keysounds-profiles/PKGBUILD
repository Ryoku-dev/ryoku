# Maintainer: Ryoku <releases@ryoku.dev>
#
# ryoku-keysounds-profiles: the key-sound samples and the importer that makes
# one from any pack, shared by both compositors' key sounds. The Hyprland plugin
# (ryoku-keysounds) and niri's engine (ryoku-keysounds-niri) both depend on it,
# so there is one copy of /usr/share/ryoku/keysounds and one
# /usr/bin/ryoku-keysounds-import no matter which, or both, are installed.
#
# The profiles are real switch recordings cut from the MIT-licensed Mechvibes
# packs (github.com/hainguyents13/mechvibes, src/audio) and sliced by
# ryoku-keysounds-import (see ryoku/keysounds/profiles.txt for the pack behind
# each profile). The packs come from mechvibes.bundle beside this recipe: a
# git bundle of the eleven packs and licence at upstream commit 326252a1,
# which upstream's Mechvibes 3 history rewrite made unreachable. Refresh it
# with payload.sh's bundle notes and update sha256sums.
pkgname=ryoku-keysounds-profiles
pkgver=${RYOKU_PKGVER:-0.1.0}
pkgrel=1
pkgdesc="Key-sound sample profiles (real switch recordings) and the Mechvibes importer"
arch=('x86_64')
url="https://ryoku.dev"
license=('GPL-3.0-or-later' 'MIT')
# python runs the importer, ffmpeg cuts and normalises each sample, git opens
# the vendored Mechvibes bundle.
makedepends=('git' 'python' 'ffmpeg')
source=("mechvibes.bundle")
noextract=("mechvibes.bundle")
sha256sums=('5ec21776bc0989cb3a4bbcdf88084bf7d1caa9a2a9e1dd7084ad76f1e8095e32')

prepare() {
  git clone -q "$srcdir/mechvibes.bundle" "$srcdir/mechvibes"
  git -C "$srcdir/mechvibes" checkout -q 8d18b40792c7ce859a898ce0e840a0c01112888c
}

_repo="$startdir/../../.."

build() {
  RYOKU_SRC="$_repo" \
    RYOKU_PKGVER="$pkgver" \
    MECHVIBES="$srcdir/mechvibes" \
    RYOKU_BUILD_DIR="$srcdir" \
    "$startdir/payload.sh" build
}

package() {
  RYOKU_SRC="$_repo" \
    RYOKU_PKGVER="$pkgver" \
    RYOKU_BUILD_DIR="$srcdir" \
    "$startdir/payload.sh" install "$pkgdir"
}
