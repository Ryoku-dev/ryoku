# Maintainer: Ryoku <releases@ryoku.dev>
# ryoku-desktop-umbriel: experimental Umbriel variant. Not published yet.
pkgname=ryoku-desktop-umbriel
pkgver=${RYOKU_PKGVER:-0.1.0}
pkgrel=1
epoch=1
pkgdesc="Ryoku desktop (experimental): Umbriel and the ryoku-wm-umbriel provider"
arch=('x86_64')
url="https://ryoku.dev"
license=('GPL-3.0-or-later')
makedepends=('go')
depends=(
  "ryoku-desktop=$epoch:$pkgver"
  'umbriel'
  'xorg-xwayland'
  'xdg-desktop-portal-umbriel'
  'wlsunset'
)
provides=('ryoku-desktop-compositor')
source=()

_repo="$startdir/../../.."

build() {
  RYOKU_SRC="$_repo" RYOKU_PKGVER="$pkgver" \
    RYOKU_RELEASE="${RYOKU_RELEASE:-}" RYOKU_CHANNEL="${RYOKU_CHANNEL:-}" \
    RYOKU_NAME="${RYOKU_NAME:-}" RYOKU_BUILD_DIR="$srcdir" \
    "$startdir/payload.sh" build
}

package() {
  RYOKU_SRC="$_repo" RYOKU_PKGVER="$pkgver" \
    RYOKU_RELEASE="${RYOKU_RELEASE:-}" RYOKU_CHANNEL="${RYOKU_CHANNEL:-}" \
    RYOKU_NAME="${RYOKU_NAME:-}" RYOKU_BUILD_DIR="$srcdir" \
    "$startdir/payload.sh" install "$pkgdir" systemd
}
