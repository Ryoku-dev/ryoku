#!/usr/bin/env python3
"""Recolour the Material Bibata pointer to the live wallpaper accent.

Ryoku's matugen post-hook calls this on every palette change. It only acts
when the Material Bibata cursor is the selected theme (desktop.cursor.theme in
~/.config/ryoku/desktop.json); otherwise it exits immediately so an unrelated
wallpaper change costs nothing.

Speed matters: the on-screen Hyprland pointer is the hyprcursor, which is
SVG-based and rebuilds in a fifth of a second, so the fast path recolours only
that and applies it at once (live, like the bar). niri and XWayland / GTK apps
display the X11 bitmap set instead, and rasterising all eleven sizes takes
~20 s, so the X11 pass builds only the size the compositor actually loads
(cursor size x output scale, ~2 s), applies that live at once, then fills the
remaining sizes in a detached background pass. --full builds every size
synchronously (used when the toggle is first enabled).

Accent: the primary role in ~/.cache/ryoku/colors.json (a hex arg overrides).
Bibata SVG source: /usr/share/ryoku-cursor-material/bibata (RYOKU_BIBATA_SRC
overrides, for running from a checkout).
"""

import colorsys
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

THEME = "Bibata-Material-Ryoku"
HOME = Path(os.path.expanduser("~"))
SRC = Path(os.environ.get("RYOKU_BIBATA_SRC", "/usr/share/ryoku-cursor-material/bibata"))
INSTALL = HOME / ".local/share/icons"
CFG = HOME / ".config/ryoku/desktop.json"
COLORS = HOME / ".cache/ryoku/colors.json"
LOCK = Path(os.environ.get("XDG_CACHE_HOME", str(HOME / ".cache"))) / "ryoku" / "cursor-material.lock"
FASTLOCK = LOCK.with_name("cursor-material-fast.lock")
BUILT = LOCK.with_name("cursor-material.built")
FAST = LOCK.with_name("cursor-material.fast")
LADDER = (16, 20, 22, 24, 28, 32, 48, 64, 72, 84, 96)
INDEX = ("[Icon Theme]\nName=Material Bibata Cursor Ryoku\n"
         "Comment=Material Bibata Cursor, wallpaper accent\nInherits=Adwaita\n")


class BuildAborted(Exception):
    """A newer palette accent arrived mid-build; the stale build was killed."""


def read_json(p):
    try:
        return json.loads(Path(p).read_text())
    except Exception:
        return {}


def cursor_section():
    return read_json(CFG).get("desktop", {}).get("cursor", {})


def active_theme():
    # "DYNAMIC" is the Hub's "Follow the wallpaper" pick; it means this theme.
    t = str(cursor_section().get("theme", ""))
    return THEME if t == "DYNAMIC" else t


def cursor_size():
    try:
        return int(cursor_section().get("size", 24))
    except Exception:
        return 24


def _nearest_ladder(n):
    return min(LADDER, key=lambda s: abs(s - n))


def display_sizes():
    """The X11 nominal size(s) the running compositor actually renders, so the
    fast pass rasterises only those instead of all eleven. niri loads cursor
    size x output scale per monitor; the configured size itself is only needed
    by XWayland/GTK apps, which the full ladder covers. Returns a sorted list of
    ladder sizes (at least one)."""
    size = cursor_size()
    targets = set()
    try:
        out = subprocess.run(["niri", "msg", "--json", "outputs"],
                             capture_output=True, text=True, timeout=3)
        if out.returncode == 0:
            data = json.loads(out.stdout)
            for o in data.values():
                scale = (o.get("logical") or {}).get("scale") or o.get("scale") or 1
                targets.add(int(round(size * float(scale))))
    except Exception:
        pass
    if not targets:
        # no niri (Hyprland renders the hyprcursor, XWayland the configured size)
        targets.add(size)
    return sorted({_nearest_ladder(t) for t in targets})


def hexval(h):
    h = str(h).strip().lstrip("#")
    if len(h) == 3:
        h = "".join(c * 2 for c in h)
    if len(h) != 6:
        return None
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def tohex(rgb):
    return "#%02x%02x%02x" % tuple(max(0, min(255, round(c))) for c in rgb)


def relit(rgb, lightness, sat_cap):
    r, g, b = (c / 255 for c in rgb)
    hh, ll, ss = colorsys.rgb_to_hls(r, g, b)
    return tohex(tuple(c * 255 for c in colorsys.hls_to_rgb(hh, lightness, min(ss, sat_cap))))


def accent():
    for a in sys.argv[1:]:
        if a.startswith("-"):
            continue
        if hexval(a):
            return tohex(hexval(a))
    p = read_json(COLORS).get("primary")
    return tohex(hexval(p)) if p and hexval(p) else "#e2342a"


def compile_theme(flags, body, primary, watch, sizes=None, abort=None, nice=False):
    """Compile the recoloured theme with the given cursor_utils flags; returns
    (workdir, compiled_theme_dir). Caller removes workdir. sizes restricts the
    X11 raster to those nominal sizes (the fast path); None builds the ladder.
    abort, if given, is polled while cursor_utils runs; a True return kills the
    build and raises BuildAborted so a stale full ladder never holds the lock
    against a newer accent. nice runs the raster at low CPU priority so the
    background full ladder never steals cycles from the fast path."""
    if not (SRC / "src/cursor_utils.py").is_file():
        sys.exit(f"bibata source missing at {SRC}")
    work = Path(tempfile.mkdtemp(prefix="ryoku-cursor-"))
    for sub in ("src", "svg", "config"):
        shutil.copytree(SRC / sub, work / sub)
    render = work / "config/render.json"
    d = json.loads(render.read_text())
    t = "Bibata-Modern-Classic"
    d[t]["colors"][0]["replace"] = body
    d[t]["colors"][1]["replace"] = primary
    d[t]["colors"][2]["replace"] = watch
    render.write_text(json.dumps(d, indent=2))
    if sizes is not None:
        bt = work / "config/build.toml"
        text = bt.read_text()
        text = re.sub(r"x11_sizes = \[[^\]]*\]",
                      "x11_sizes = [" + ", ".join(str(s) for s in sizes) + "]",
                      text, count=1)
        bt.write_text(text)
    # cursor_utils renders PNGs through a fixed /tmp path; a private TMPDIR per
    # build lets a fast build and a full build run at once without colliding.
    tmp = work / "tmp"
    tmp.mkdir()
    env = dict(os.environ, TMPDIR=str(tmp))
    cmd = [sys.executable, "src/cursor_utils.py", *flags,
           "--theme", t, "--out-dir", "out"]
    if nice:
        cmd = ["nice", "-n", "19", *cmd]
    proc = subprocess.Popen(cmd, cwd=work, env=env,
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        while True:
            try:
                proc.wait(timeout=0.2)
                break
            except subprocess.TimeoutExpired:
                if abort is not None and abort():
                    proc.kill()
                    proc.wait()
                    raise BuildAborted()
        if proc.returncode != 0:
            raise subprocess.CalledProcessError(proc.returncode, "cursor_utils")
    finally:
        if proc.poll() is None:
            proc.kill()
            proc.wait()
    return work, work / "out" / t


def install_parts(compiled, parts):
    """Replace the named parts inside the installed theme dir in place, so a
    hypr-only pass keeps the existing X11 cursors/ and vice versa."""
    final = INSTALL / THEME
    final.mkdir(parents=True, exist_ok=True)
    (final / "index.theme").write_text(INDEX)
    for name in parts:
        src = compiled / name
        if not src.exists():
            continue
        dst = final / name
        if dst.is_dir():
            shutil.rmtree(dst, ignore_errors=True)
        elif dst.exists():
            dst.unlink()
        shutil.move(str(src), str(dst))


def build_hypr(body, primary, watch):
    work, compiled = compile_theme(["--hypr"], body, primary, watch)
    try:
        install_parts(compiled, ["hyprcursors", "manifest.hl", "index.theme"])
    finally:
        shutil.rmtree(work, ignore_errors=True)


def build_x11(body, primary, watch, sizes=None, abort=None, nice=False):
    work, compiled = compile_theme(["--x11"], body, primary, watch,
                                   sizes=sizes, abort=abort, nice=nice)
    try:
        install_parts(compiled, ["cursors"])
    finally:
        shutil.rmtree(work, ignore_errors=True)


def apply_live():
    # Re-assert, not set: the theme name does not change when only its images
    # are recoloured, and niri reloads the pointer only when the cursor block
    # changes value. The provider's re-assert forces that reload on niri and
    # is a plain setcursor on Hyprland.
    subprocess.run(["ryoku", "wm", "act", "cursor.reassert"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def colors_from(acc):
    rgb = hexval(acc)
    return relit(rgb, 0.16, 0.35), acc, relit(rgb, 0.06, 0.40)


def _marker_matches(path, acc):
    return path.exists() and path.read_text().strip() == acc


def _fast_build():
    """Rasterise only the size the compositor displays and apply it live, on a
    lock of its own so it never queues behind a full-ladder build. That queue
    is what made a wallpaper change wait ~30 s: the fast build sat behind the
    previous change's 18 s full build. Non-blocking: a fast build already
    running will pick up the newest accent when it loops, so a second one is
    redundant."""
    FASTLOCK.parent.mkdir(parents=True, exist_ok=True)
    fh = open(FASTLOCK, "w")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        fh.close()
        return
    try:
        while True:
            acc = accent()
            if _marker_matches(FAST, acc):
                return
            body, primary, watch = colors_from(acc)
            build_x11(body, primary, watch, sizes=display_sizes())
            apply_live()
            FAST.write_text(acc)
            if accent() == acc:
                return
    finally:
        fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()


def _full_build():
    """Fill the whole size ladder for the live accent, on the full lock so two
    full builds never stack. The build aborts the moment a newer accent arrives
    (the fast path has already applied it live), then loops onto that accent, so
    a stale ladder never holds the lock against the current palette."""
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    fh = open(LOCK, "w")
    fcntl.flock(fh, fcntl.LOCK_EX)
    try:
        while True:
            acc = accent()
            if (_marker_matches(BUILT, acc)
                    and (INSTALL / THEME / "cursors/left_ptr").exists()):
                return
            body, primary, watch = colors_from(acc)
            try:
                build_x11(body, primary, watch, abort=lambda: accent() != acc,
                          nice=True)
            except BuildAborted:
                continue
            apply_live()
            BUILT.write_text(acc)
            if accent() == acc:
                return
    finally:
        fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()


def x11_pass(full=False):
    """Build the X11 set niri and XWayland/GTK display. The fast path applies
    the displayed size live within a couple of seconds; the full ladder fills
    in behind it. --full does the ladder synchronously (first enable)."""
    if full:
        _full_build()
        return
    _fast_build()
    _full_build()


def main():
    args = sys.argv[1:]
    # internal: background X11 pass spawned by the fast path. It reads the live
    # palette itself, so a queue of passes always ends on the newest accent.
    if "--x11only" in args:
        x11_pass()
        return

    if "--force" not in args and active_theme() != THEME:
        return

    body, primary, watch = colors_from(accent())
    # fast + lock-free: the hyprcursor pointer writes SVGs directly (no /tmp
    # collision) and rebuilds in ~0.2s, so it applies at once and never waits.
    build_hypr(body, primary, watch)
    apply_live()
    # the X11 set niri and XWayland/GTK display: synchronous with --full (first
    # enable), otherwise a detached background pass that fast-builds the shown
    # size, applies it live, then fills the rest, so the update never waits.
    if "--full" in args:
        x11_pass(full=True)
    else:
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "--x11only"],
                         start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    main()
