# SPDX-License-Identifier: GPL-3.0-only
# Hyakki from the reviewed monorepo and its committed vendor tree.
pkgname=hyakki
pkgver=${RYOKU_PKGVER:-0.1.0}
pkgrel=1
epoch=1
replaces=('ryoku-rashin')
conflicts=('ryoku-rashin')
pkgdesc="Hyakki local-first AI desktop and command line"
arch=('x86_64')
url="https://ryoku.dev"
# The combined binaries are GPL-3.0-only; the included grants are listed in
# /usr/share/licenses/hyakki/THIRD_PARTY_NOTICES.
license=('GPL-3.0-only' 'Apache-2.0' 'OFL-1.1' 'MIT' 'BSD-3-Clause' 'LicenseRef-SCOWL' 'Zlib')
depends=(
  "ryoku-desktop=$epoch:$pkgver"
  'libx11'
  'libxcursor'
  'libxfixes'
  'libxkbcommon'
  'libxkbcommon-x11'
  'wayland'
  'mesa'
  'libglvnd'
  'vulkan-icd-loader'
  'hicolor-icon-theme'
  'python'
  'git'
  'xdg-utils'
  'bubblewrap'
)
# Generated from release/optional.json; release/check.py keeps them equal.
# Hyakki runs none of these until the feature that names it is turned on.
optdepends=(
  'chromium: the browser Hands drives in its own profile; any Chromium-family browser on PATH also works'
  'weston: the headless parent of the separate desktop Hands runs apps on'
  'niri: the separate desktop Hands runs apps on, and the maximize quick command'
  'grim: screenshots when Ryoku'"'"'s capture tool is absent, and Hands looking at its separate desktop'
  'wtype: types dictation, rewrites and Hands keys into the focused window'
  'wl-clipboard: reads the highlighted text for a rewrite in place, and a pasted picture in the app'
  'tesseract: reads words on screen for guides, kept walkthroughs and select-and-ask'
  'tesseract-data-eng: reads words on screen for guides, kept walkthroughs and select-and-ask'
  'espeak-ng: Oni'"'"'s system voice'
  'pipewire: hears the microphone and plays Oni'"'"'s voice and sounds'
  'libpulse: the microphone list, the volume quick commands and the PulseAudio capture and playback fallback'
  'whisper-cpp: decodes speech with the downloaded Whisper model'
  'uv: sets up Hindsight, the optional memory engine, when asked'
  'llama-cpp: runs downloaded models on this computer; without it Hyakki can fetch llama.cpp when asked'
)
makedepends=('go>=1.26' 'pkgconf' 'vulkan-headers')
options=('!lto' '!debug')
install=hyakki.install
source=()

_repo="$startdir/../../.."

build() {
  RYOKU_SRC="$_repo" \
  RYOKU_BUILD_DIR="$srcdir" \
  RYOKU_PKGVER="$pkgver" \
  RYOKU_RELEASE="${RYOKU_RELEASE:-$pkgver}" \
  RYOKU_CHANNEL="${RYOKU_CHANNEL:-stable}" \
  RYOKU_NAME="${RYOKU_NAME:-Ryoku}" \
    "$startdir/payload.sh" build
}

package() {
  RYOKU_SRC="$_repo" \
  RYOKU_BUILD_DIR="$srcdir" \
  RYOKU_PKGVER="$pkgver" \
  RYOKU_RELEASE="${RYOKU_RELEASE:-$pkgver}" \
  RYOKU_CHANNEL="${RYOKU_CHANNEL:-stable}" \
  RYOKU_NAME="${RYOKU_NAME:-Ryoku}" \
    "$startdir/payload.sh" install "$pkgdir" systemd
}
