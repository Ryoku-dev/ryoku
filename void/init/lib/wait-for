#!/bin/sh
# wait-for: the bounded translation of systemd's Condition* and ordering keys.
# runit starts every service in parallel, so a translated service waits for its
# precondition here instead of declaring After=/Condition=. A wait that exceeds
# its budget fails the service: the run script then parks itself (exec sv down .)
# rather than crash-looping, matching systemd's condition-not-met behavior.
#
# Usage (sourced by a run script; POSIX sh, no bashisms -- Void's /bin/sh is dash):
#   . "${RYOKU_INIT_LIB:-/usr/lib/ryoku/runit}/wait-for"
#   load_session_env
#   wait_env WAYLAND_DISPLAY 30 || exit 101
#   wait_file /run/user/1000/bus 30 || exit 101
#   wait_dbus org.freedesktop.portal.Desktop 30 || exit 101
#   wait_service bluetoothd 30 || exit 101
# Exit code 101 means "precondition never arrived" and is what the finish
# scripts treat as a park, not a crash.
#
# Every budget is in seconds and every one is overridable through the
# RYOKU_WAIT_BUDGET_SCALE env var (tests shrink it; nothing else sets it).

# Turnstile's service environment is an envdir, not a mutable copy of the
# compositor environment. Reloading it lets a supervised process observe
# values published after runsv first invoked its run script.
load_session_env() {
	[ -n "${TURNSTILE_ENV_DIR:-}" ] || return 0
	[ -d "$TURNSTILE_ENV_DIR" ] || return 0

	for _ryoku_env_file in "$TURNSTILE_ENV_DIR"/*; do
		[ -f "$_ryoku_env_file" ] || continue
		_ryoku_env_name=${_ryoku_env_file##*/}
		case $_ryoku_env_name in
			""|[0-9]*|*[!A-Za-z0-9_]*) continue ;;
		esac
		_ryoku_env_value=$(cat "$_ryoku_env_file") || continue
		export "$_ryoku_env_name=$_ryoku_env_value"
	done
}

# scale a budget: integer math only (POSIX sh has no float). scale 0 parks
# immediately, which is what the negative tests want.
wait_budget() {
	_budget=${1:-30}
	_scale=${RYOKU_WAIT_BUDGET_SCALE:-1}
	# a zero or negative scale means "do not wait": one poll, no sleep.
	if [ "$_scale" -le 0 ] 2>/dev/null; then
		echo 0
		return
	fi
	echo $((_budget * _scale))
}

_wait_failed() {
	_wait_actual_budget=$(wait_budget "$4")
	printf '%s\n' "wait-for: $1 $2 $3 after ${_wait_actual_budget}s; parking" >&2
	return 1
}

# poll fn until it succeeds or the budget expires. 0.2s granularity: fast
# enough that services start promptly, slow enough to be idle-cheap.
wait_poll() {
	_deadline=$(( $(date +%s) + $(wait_budget "$1") ))
	shift
	while :; do
		"$@" >/dev/null 2>&1 && return 0
		[ "$(date +%s)" -ge "$_deadline" ] && return 1
		sleep 0.2
	done
}

# ConditionEnvironment= checks the live envdir under Turnstile. The run
# process's inherited environment is only used by the test/fallback tier.
wait_env() {
	if wait_poll "$2" _wait_env_once "$1"; then
		return 0
	fi
	_wait_failed environment "$1" "not set" "$2"
}

_wait_env_once() {
	case $1 in
		""|[0-9]*|*[!A-Za-z0-9_]*) return 1 ;;
	esac
	if [ -n "${TURNSTILE_ENV_DIR:-}" ]; then
		[ -s "$TURNSTILE_ENV_DIR/$1" ]
		return
	fi
	eval "_ryoku_env_value=\${$1:-}"
	[ -n "$_ryoku_env_value" ]
}

# the path exists (ConditionPathExists=). a leading ! inverts, matching the
# unit-file syntax (ConditionPathExists=!/path).
wait_file() {
	case $1 in
		!*)
			if wait_poll "$2" sh -c "[ ! -e \"${1#!}\" ]"; then
				return 0
			fi
			;;
		*)
			if wait_poll "$2" sh -c "[ -e \"$1\" ]"; then
				return 0
			fi
			;;
	esac
	_wait_failed file "$1" "not ready" "$2"
}

# the D-Bus name is owned on the session bus (a stand-in for After=/Wants= on
# another daemon). Uses busctl when present; falls back to a bare probe so a
# minimal image still works.
wait_dbus() {
	if wait_poll "$2" _wait_dbus_once "$1"; then
		return 0
	fi
	_wait_failed "D-Bus name" "$1" "not owned" "$2"
}

_wait_dbus_once() {
	if command -v busctl >/dev/null 2>&1; then
		busctl --user status "$1" >/dev/null 2>&1 && return 0
		busctl status "$1" >/dev/null 2>&1 && return 0
		return 1
	fi
	# no busctl: the session socket existing is the best available signal
	[ -S "${DBUS_SESSION_BUS_ADDRESS#unix:path=}" ] || [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus" ]
}

# another runit service is supervised and up (After=/Requires= on a service).
# User services take precedence because Void can have a same-named system
# service whose supervisor state is not readable from a Turnstile session.
wait_service() {
	if wait_poll "$2" _wait_service_once "$1"; then
		return 0
	fi
	_wait_failed service "$1" "not up" "$2"
}

_wait_service_once() {
	for _dir in "../$1" "${RYOKU_USER_SERVICE_DIR:+$RYOKU_USER_SERVICE_DIR/$1}" "/var/service/$1" "/etc/sv/$1"; do
		[ -n "$_dir" ] || continue
		if [ -d "$_dir/supervise" ]; then
			_state=$(cat "$_dir/supervise/stat" 2>/dev/null) || continue
			case $_state in
				run*|finish*) return 0 ;;
			esac
			return 1
		fi
	done
	return 1
}

# the ExecStart binary is installed. systemd fails a unit whose binary is
# missing and stops retrying at its start limit; runsv would retry every
# second forever, so the caller parks instead (`sv up` retries once it lands).
require_bin() {
	[ -x "$1" ] && return 0
	echo "missing $1; parked until it is installed"
	return 1
}
