#!/bin/sh
# Rashin starts this on demand and brings it down from its finish script.
exec 2>&1

. "${RYOKU_INIT_LIB:-/usr/lib/ryoku/runit}/wait-for"
load_session_env
BIN=${RYOKU_BIN_DIR:-/usr/bin}

wait_service ryoku-rashin "${RYOKU_WAIT_RASHIN:-60}" || exec sv down .
require_bin "$BIN/prowl" || exec sv down .

# Clear a stale listener before starting the gateway.
"$BIN/prowl" gateway down --port 8788 >/dev/null 2>&1 || true

exec "$BIN/prowl" gateway serve --port 8788
