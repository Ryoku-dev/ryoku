#!/bin/sh
# Translation of ryoku/shell/systemd/user/ryogami.service.
# ryogami renders every wallpaper surface and serves the wallpaper topic, so
# it is supervised beside the shell daemon. Restart=always is runsv's default;
# KillMode=process is natural (the ryoku-depth helper it shells out to must
# outlive a reload, and runsv only ever signals this child).
exec 2>&1

BIN=${RYOKU_BIN_DIR:-/usr/bin}

. "${RYOKU_INIT_LIB:-$(dirname "$0")/../../lib}/wait-for"
wait_env WAYLAND_DISPLAY "${RYOKU_WAIT_WAYLAND:-60}" || exec sv down .

# quickshell links jemalloc, so the glibc arena cap does nothing here. Without
# a decay schedule the picker strands ~128 MB after a single open/close
# (measured). Same tuning the shell daemon gives its own surfaces.
export MALLOC_CONF=narenas:2,background_thread:true,dirty_decay_ms:5000,muzzy_decay_ms:5000

exec "$BIN/ryogami"
