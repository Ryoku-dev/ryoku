#!/bin/sh
exec 2>&1
. "${RYOKU_INIT_LIB:-/usr/lib/ryoku/runit}/wait-for"
load_session_env
wait_service bluetoothd "${RYOKU_WAIT_BLUETOOTHD:-60}" || exec sv down .

# the helper keeps bluetoothctl registered as the pairing agent, asks the user
# through a notification and types the answer back, and keeps scan chatter out
# of the log
exec ryoku-bt-agent
