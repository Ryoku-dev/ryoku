#!/bin/sh
exec 2>&1
. "${RYOKU_INIT_LIB:-/usr/lib/ryoku/runit}/wait-for"
load_session_env
wait_service bluetoothd "${RYOKU_WAIT_BLUETOOTHD:-60}" || exec sv down .

# the helper holds stdin open so bluetoothctl stays registered as the pairing
# agent, and keeps scan chatter out of the log
exec ryoku-bt-agent
