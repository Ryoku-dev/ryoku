#!/bin/sh
# Translation of ryoku/shell/systemd/user/ryoku-bootstrap.service.
# Type=oneshot + RemainAfterExit: run does the work once, then parks itself
# (exec sv down .) so it never repeats. The ConditionPathExists=|! markers are
# kept: when the box is already materialized the service is a no-op park.
# Before=graphical-session.target and the niri drop-in's Wants/After ordering
# move to the Void session wrapper, which runs this service's command before
# starting the compositor; under a plain runsvdir the compositor is not
# supervised, so the wrapper is the only ordering point that exists.
exec 2>&1

BIN=${RYOKU_BIN_DIR:-/usr/bin}
_home=${HOME:-$(getent passwd "$(id -u)" | cut -d: -f6)}

# the two ways a session comes up bare: never materialized, or the shell tree
# it needs is missing. Both present = nothing to do.
if [ -d "$_home/.config/ryoku" ] && [ -f "$_home/.config/quickshell/shell/shell.qml" ]; then
	exec sv down .
fi

# materialize is declarative and preserves user files, so a second run (an
# update racing a login) is harmless rather than a reason to refuse to start.
# TimeoutStartSec=120: bounded with a watchdog so a hung materialize cannot
# wedge the session bootstrap forever.
_timeout=${RYOKU_BOOTSTRAP_TIMEOUT:-120}
if command -v timeout >/dev/null 2>&1; then
	timeout "$_timeout" "$BIN/ryoku" materialize
else
	"$BIN/ryoku" materialize
fi

exec sv down .
