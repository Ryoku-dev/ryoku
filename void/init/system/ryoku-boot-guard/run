#!/bin/sh
# Translation of ryoku/cli/systemd/ryoku-boot-guard.service.
# System oneshot: runs `ryoku boot-guard` early in every boot and parks.
# It does nothing unless a packaged update armed it
# (/var/lib/ryoku/update-pending.json); then it counts failed boots and, on
# the second, puts the Ryoku set back on the previous release.
#
# Ordering translation (see translations.tsv): DefaultDependencies=no +
# After=local-fs is implicit (runit stage 2 runs after the root fs is up).
# The network wait stays inside boot-guard itself (nm-online only on the boot
# that reverts). Before=display-manager.service has no runit analogue: runit
# starts sddm in parallel, and the guard is idempotent, so the accepted race
# is that a revert may land while the greeter is already up.
exec 2>&1

. "${RYOKU_INIT_LIB:-/usr/lib/ryoku/runit}/wait-for"
load_session_env
BIN=${RYOKU_BIN_DIR:-/usr/bin}

# ConditionPathExists=/var/lib/ryoku/update-pending.json: no armed update,
# no work, park. The marker appears mid-boot when an update arms it, so wait
# briefly for it rather than racing stage 2.

wait_file /var/lib/ryoku/update-pending.json "${RYOKU_WAIT_PENDING:-10}" || exec sv down .

# TimeoutStartSec=10min, bounded the same way.
if command -v timeout >/dev/null 2>&1; then
	timeout 600 "$BIN/ryoku" boot-guard || true
else
	"$BIN/ryoku" boot-guard || true
fi

exec sv down .
