# Template file for 'ryoku-rashin'
pkgname=ryoku-rashin
version=0.1.0
revision=1
archs="x86_64"
short_desc="Ryoku Rashin AI system"
maintainer="Ryoku <releases@ryoku.dev>"
license="GPL-3.0-or-later, Apache-2.0, OFL-1.1, MIT"
homepage="https://ryoku.dev"
hostmakedepends="go pkg-config"
makedepends="wayland-devel libxkbcommon-devel libglvnd-devel Vulkan-Headers"
depends="ryoku-desktop>=${version} wayland libxkbcommon libglvnd vulkan-loader bubblewrap"
# xbps has no optional dependencies: uv, which sets up Hindsight, the optional
# memory engine, is optional and comes with the desktop package set
# (void/packages/translations.tsv), so it is not a depends.
distfiles="https://repo.ryoku.dev/sources/ryoku-${version}.tar.gz"
checksum=SKIP
wrksrc="ryoku-${version}"

_payload() {
	GOFLAGS="-buildmode=pie" \
	RYOKU_SRC="$wrksrc" \
	RYOKU_BUILD_DIR="${wrksrc%/*}/${pkgname}-payload-build" \
	RYOKU_PKGVER="$version" \
	RYOKU_RELEASE="$version" \
	RYOKU_CHANNEL="${RYOKU_CHANNEL:-stable}" \
	RYOKU_NAME="${RYOKU_NAME:-Ryoku}" \
		"$wrksrc/release/packages/$pkgname/payload.sh" "$@"
}

do_build() {
	_payload build
}

do_install() {
	_payload install "$DESTDIR" runit
}

