#!/usr/bin/env python3
import colorsys
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

THEME = "Bibata-Material-Ryoku"
HOME = Path(os.path.expanduser("~"))
SRC = Path(os.environ.get("RYOKU_BIBATA_SRC", "/usr/share/ryoku-cursor-material/bibata"))
INSTALL = HOME / ".local/share/icons"
CFG = HOME / ".config/ryoku/desktop.json"
COLORS = HOME / ".cache/ryoku/colors.json"
LOCK = Path(os.environ.get("XDG_CACHE_HOME", str(HOME / ".cache"))) / "ryoku" / "cursor-material.lock"
FASTLOCK = LOCK.with_name("cursor-material-fast.lock")
BUILT = LOCK.with_name("cursor-material.built")
FAST = LOCK.with_name("cursor-material.fast")
LADDER = (16, 20, 22, 24, 28, 32, 48, 64, 72, 84, 96)
INDEX = ("[Icon Theme]\nName=Material Bibata Cursor Ryoku\n"
         "Comment=Material Bibata Cursor, wallpaper accent\nInherits=Adwaita\n")


class BuildAborted(Exception):
    pass


def read_json(path):
    try:
        return json.loads(Path(path).read_text())
    except Exception:
        return {}


def active_theme():
    theme = str(read_json(CFG).get("desktop", {}).get("cursor", {}).get("theme", ""))
    return THEME if theme == "DYNAMIC" else theme


def cursor_size():
    try:
        return int(read_json(CFG).get("desktop", {}).get("cursor", {}).get("size", 24))
    except Exception:
        return 24


def _nearest_ladder(n):
    return min(LADDER, key=lambda s: abs(s - n))


def display_sizes():
    size = cursor_size()
    targets = set()
    try:
        out = subprocess.run(["niri", "msg", "--json", "outputs"],
                             capture_output=True, text=True, timeout=3)
        if out.returncode == 0:
            data = json.loads(out.stdout)
            for o in data.values():
                scale = (o.get("logical") or {}).get("scale") or o.get("scale") or 1
                targets.add(int(round(size * float(scale))))
    except Exception:
        pass
    if not targets:
        targets.add(size)
    return sorted({_nearest_ladder(t) for t in targets})


def hexval(value):
    value = str(value).strip().lstrip("#")
    if len(value) == 3:
        value = "".join(char * 2 for char in value)
    if len(value) != 6:
        return None
    return tuple(int(value[i:i + 2], 16) for i in (0, 2, 4))


def tohex(rgb):
    return "#%02x%02x%02x" % tuple(max(0, min(255, round(value))) for value in rgb)


def relit(rgb, lightness, sat_cap):
    red, green, blue = (value / 255 for value in rgb)
    hue, _, saturation = colorsys.rgb_to_hls(red, green, blue)
    return tohex(tuple(value * 255 for value in colorsys.hls_to_rgb(
        hue, lightness, min(saturation, sat_cap))))


def accent():
    for arg in sys.argv[1:]:
        if not arg.startswith("-") and hexval(arg):
            return tohex(hexval(arg))
    primary = read_json(COLORS).get("primary")
    return tohex(hexval(primary)) if primary and hexval(primary) else "#e2342a"


def compile_theme(flags, body, primary, watch, sizes=None, abort=None, nice=False):
    if not (SRC / "src/cursor_utils.py").is_file():
        sys.exit(f"bibata source missing at {SRC}")
    work = Path(tempfile.mkdtemp(prefix="ryoku-cursor-"))
    for subdir in ("src", "svg", "config"):
        shutil.copytree(SRC / subdir, work / subdir)
    render = work / "config/render.json"
    data = json.loads(render.read_text())
    theme = "Bibata-Modern-Classic"
    data[theme]["colors"][0]["replace"] = body
    data[theme]["colors"][1]["replace"] = primary
    data[theme]["colors"][2]["replace"] = watch
    render.write_text(json.dumps(data, indent=2))
    if sizes is not None:
        bt = work / "config/build.toml"
        text = bt.read_text()
        text = re.sub(r"x11_sizes = \[[^\]]*\]",
                      "x11_sizes = [" + ", ".join(str(s) for s in sizes) + "]",
                      text, count=1)
        bt.write_text(text)
    tmp = work / "tmp"
    tmp.mkdir()
    env = dict(os.environ, TMPDIR=str(tmp))
    cmd = [sys.executable, "src/cursor_utils.py", *flags,
           "--theme", theme, "--out-dir", "out"]
    if nice:
        cmd = ["nice", "-n", "19", *cmd]
    proc = subprocess.Popen(cmd, cwd=work, env=env, stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL)
    try:
        while True:
            try:
                proc.wait(timeout=0.2)
                break
            except subprocess.TimeoutExpired:
                if abort is not None and abort():
                    proc.kill()
                    proc.wait()
                    raise BuildAborted()
        if proc.returncode != 0:
            raise subprocess.CalledProcessError(proc.returncode, "cursor_utils")
    finally:
        if proc.poll() is None:
            proc.kill()
            proc.wait()
    return work, work / "out" / theme


def install_parts(compiled, parts):
    final = INSTALL / THEME
    final.mkdir(parents=True, exist_ok=True)
    (final / "index.theme").write_text(INDEX)
    for name in parts:
        source = compiled / name
        if not source.exists():
            continue
        destination = final / name
        if destination.is_dir():
            shutil.rmtree(destination, ignore_errors=True)
        elif destination.exists():
            destination.unlink()
        shutil.move(str(source), str(destination))


def build_hypr(body, primary, watch):
    work, compiled = compile_theme(["--hypr"], body, primary, watch)
    try:
        install_parts(compiled, ["hyprcursors", "manifest.hl", "index.theme"])
    finally:
        shutil.rmtree(work, ignore_errors=True)


def build_x11(body, primary, watch, sizes=None, abort=None, nice=False):
    work, compiled = compile_theme(["--x11"], body, primary, watch,
                                   sizes=sizes, abort=abort, nice=nice)
    try:
        install_parts(compiled, ["cursors"])
    finally:
        shutil.rmtree(work, ignore_errors=True)


def apply_live():
    subprocess.run(["ryoku", "wm", "act", "cursor.reassert"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def colors_from(value):
    rgb = hexval(value)
    return relit(rgb, 0.16, 0.35), value, relit(rgb, 0.06, 0.40)


def _marker_matches(path, acc):
    return path.exists() and path.read_text().strip() == acc


def _fast_build():
    FASTLOCK.parent.mkdir(parents=True, exist_ok=True)
    lock = open(FASTLOCK, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        lock.close()
        return
    try:
        while True:
            acc = accent()
            if _marker_matches(FAST, acc):
                return
            body, primary, watch = colors_from(acc)
            build_x11(body, primary, watch, sizes=display_sizes())
            apply_live()
            FAST.write_text(acc)
            if accent() == acc:
                return
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)
        lock.close()


def _full_build():
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    lock = open(LOCK, "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        while True:
            acc = accent()
            if (_marker_matches(BUILT, acc)
                    and (INSTALL / THEME / "cursors/left_ptr").exists()):
                return
            body, primary, watch = colors_from(acc)
            try:
                build_x11(body, primary, watch, abort=lambda: accent() != acc,
                          nice=True)
            except BuildAborted:
                continue
            apply_live()
            BUILT.write_text(acc)
            if accent() == acc:
                return
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)
        lock.close()


def x11_pass(full=False):
    if full:
        _full_build()
        return
    _fast_build()
    _full_build()


def main():
    args = sys.argv[1:]
    if "--x11only" in args:
        x11_pass()
        return
    if "--force" not in args and active_theme() != THEME:
        return
    body, primary, watch = colors_from(accent())
    build_hypr(body, primary, watch)
    apply_live()
    if "--full" in args:
        x11_pass(full=True)
    else:
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "--x11only"],
                         start_new_session=True, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    main()
