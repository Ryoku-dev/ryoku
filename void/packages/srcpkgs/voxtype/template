# Template file for 'voxtype'
pkgname=voxtype
version=1.1.1
revision=1
archs="x86_64"
create_wrksrc=yes
skip_extraction="voxtype-${version}-1.x86_64.rpm"
hostmakedepends="libarchive"
depends="alsa-lib curl glibc alsa-pipewire"
short_desc="Push-to-talk voice-to-text for Wayland compositors"
maintainer="Ryoku <releases@ryoku.dev>"
license="MIT"
homepage="https://github.com/peteonrails/voxtype"
distfiles="${homepage}/releases/download/v${version}/voxtype-${version}-1.x86_64.rpm"
checksum=5d0704d2f8bff4b02ca7d6ace1eab20caf8b3bbbc137f3e1a268af5021509872
provides="voxtype-bin-${version}_${revision}"
conflicts="voxtype-bin>=0"
conf_files="/etc/voxtype/config.toml"
nostrip=yes

pre_install() {
	bsdtar -xf "${XBPS_SRCDISTDIR}/${pkgname}-${version}/voxtype-${version}-1.x86_64.rpm"
	rm -rf usr/lib/.build-id
	# Void ships neither the CUDA nor the ROCm runtime these engine providers
	# load, and runit (void/init/user/voxtype) supervises the daemon here.
	rm -rf usr/lib/voxtype/cuda-12 usr/lib/voxtype/cuda-13 usr/lib/voxtype/migraphx \
		usr/lib/systemd
}

do_install() {
	vmkdir etc
	vmkdir usr
	vcopy "etc/*" etc
	vcopy "usr/*" usr
}
