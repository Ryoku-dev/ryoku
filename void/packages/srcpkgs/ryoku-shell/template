# Template file for 'ryoku-shell'
pkgname=ryoku-shell
version=0.1.0
revision=1
archs="x86_64"
short_desc="Ryoku shell IPC daemon: supervises the Quickshell desktop"
maintainer="Ryoku <releases@ryoku.dev>"
license="GPL-3.0-or-later"
homepage="https://ryoku.dev"
hostmakedepends="go pkg-config wayland-devel wayland-protocols"
makedepends="wayland-devel ffmpeg6-devel"
depends="quickshell ffmpeg6 wayland jq python3 uv socat gum qrencode upower
 brightnessctl ddcutil wtype wl-clipboard zenity power-profiles-daemon
 NetworkManager curl libnotify"
distfiles="https://repo.ryoku.dev/sources/ryoku-${version}.tar.gz"
checksum=SKIP
wrksrc="ryoku-${version}"

_payload() {
	GOFLAGS="-buildmode=pie" \
	RYOKU_SRC="$wrksrc" \
	RYOKU_BUILD_DIR="${wrksrc%/*}/${pkgname}-payload-build" \
	RYOKU_PKGVER="$version" \
	RYOKU_RELEASE="$version" \
	RYOKU_CHANNEL="${RYOKU_CHANNEL:-stable}" \
	RYOKU_NAME="${RYOKU_NAME:-Ryoku}" \
		"$wrksrc/release/packages/$pkgname/payload.sh" "$@"
}

do_build() {
	_payload build
}

do_install() {
	_payload install "$DESTDIR" runit
}
