# Template file for 'hyakki'
pkgname=hyakki
version=0.1.0
revision=1
replaces="ryoku-rashin>=0"
conflicts="ryoku-rashin>=0"
archs="x86_64"
short_desc="Hyakki local-first AI desktop and command line"
maintainer="Ryoku <releases@ryoku.dev>"
license="GPL-3.0-only, Apache-2.0, OFL-1.1, MIT, BSD-3-Clause, LicenseRef-SCOWL, Zlib"
homepage="https://ryoku.dev"
hostmakedepends="go python3 pkg-config"
makedepends="wayland-devel libxkbcommon-devel libglvnd-devel Vulkan-Headers libX11-devel libXcursor-devel libXfixes-devel"
depends="ryoku-desktop>=${version} python3 git xdg-utils hicolor-icon-theme libxkbcommon-x11 libX11 libXcursor libXfixes wayland libxkbcommon mesa-dri libglvnd vulkan-loader bubblewrap"
# Optional programs and their reasons are listed in INSTALL.msg.
distfiles="https://repo.ryoku.dev/sources/ryoku-${version}.tar.gz"
checksum=SKIP
wrksrc="ryoku-${version}"

_payload() {
	GOFLAGS="-buildmode=pie" \
	RYOKU_SRC="$wrksrc" \
	RYOKU_BUILD_DIR="${wrksrc%/*}/${pkgname}-payload-build" \
	RYOKU_PKGVER="$version" \
	RYOKU_RELEASE="$version" \
	RYOKU_CHANNEL="${RYOKU_CHANNEL:-stable}" \
	RYOKU_NAME="${RYOKU_NAME:-Ryoku}" \
		"$wrksrc/release/packages/$pkgname/payload.sh" "$@"
}

do_build() {
	_payload build
}

do_install() {
	_payload install "$DESTDIR" runit
}

