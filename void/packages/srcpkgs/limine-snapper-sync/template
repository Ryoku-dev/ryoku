short_desc="Integrates Limine boot entries with Snapper snapshots"
maintainer="Ryoku <releases@ryoku.dev>"
license="GPL-3.0-only"
homepage="https://gitlab.com/Zesko/limine-snapper-sync"
distfiles="https://gitlab.com/Zesko/limine-snapper-sync/-/archive/${version}/limine-snapper-sync-${version}.tar.gz
 https://repo1.maven.org/maven2/tools/jackson/core/jackson-databind/3.2.3/jackson-databind-3.2.3.jar
 https://repo1.maven.org/maven2/tools/jackson/core/jackson-core/3.2.3/jackson-core-3.2.3.jar
 https://repo1.maven.org/maven2/com/fasterxml/jackson/core/jackson-annotations/2.22/jackson-annotations-2.22.jar"
checksum="29bcd51503a0168ca836023efb4cdbd63b6ec4578eb69fb959a33dfa48aa844c
