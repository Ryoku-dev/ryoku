# Building directly keeps Maven and Gradle out of the build and the network off.
do_build() {
	local distdir="${XBPS_SRCDISTDIR}/${pkgname}-${version}"
	local java_home=/usr/lib/jvm/mandrel25
	local classpath="${distdir}/jackson-databind-3.2.3.jar:${distdir}/jackson-core-3.2.3.jar:${distdir}/jackson-annotations-2.22.jar"

	mkdir -p build/classes
	"${java_home}/bin/javac" -encoding UTF-8 -cp "$classpath" -d build/classes \
		$(find src/main/java -name '*.java' -type f | LC_ALL=C sort)
	cp -a src/main/resources/. build/classes/

	"${java_home}/bin/native-image" \
		--gc=serial \
		-march=compatibility \
		-R:MaxHeapSize=128m \
		-Os \
		-H:+UnlockExperimentalVMOptions \
		-H:ReflectionConfigurationFiles="${wrksrc}/src/main/resources/reflect-config.json" \
		-H:IncludeResourceBundles=messages \
		-H:IncludeLocales=en,ru \
		-H:IncludeResources='messages.*\.properties|reflect-config\.json' \
		--no-fallback \
		-cp "build/classes:${classpath}" \
		-o build/limine-snapper-sync \
		org.limine.snapper.Main

	local po lang
	for po in po/*.po; do
		[ -f "$po" ] || continue
		lang=${po##*/}
		lang=${lang%.po}
		mkdir -p "build/locale/${lang}/LC_MESSAGES"
		msgfmt --check "$po" -o "build/locale/${lang}/LC_MESSAGES/limine-snapper-sync.mo"
	done
}

do_install() {
	vinstall install/arch-linux/etc/limine-snapper-sync.conf 644 etc

	vmkdir etc
	vcopy install/arch-linux/etc/xdg etc
	vmkdir usr
	vcopy install/arch-linux/usr/bin usr
	vmkdir usr/lib
	vcopy install/arch-linux/usr/lib/limine usr/lib
	vcopy install/arch-linux/usr/lib/snapper usr/lib
	vmkdir usr/share
	vcopy install/arch-linux/usr/share/applications usr/share
	vcopy install/arch-linux/usr/share/icons usr/share
	vcopy build/locale usr/share

	vinstall build/limine-snapper-sync 755 usr/lib/limine
	vsv limine-snapper-sync
	vdoc README.md
	vdoc CHANGELOG.md
	vlicense LICENSE
}
