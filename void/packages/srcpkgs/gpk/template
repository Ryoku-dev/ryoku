# Template file for 'gpk'
pkgname=gpk
version=0.7.0
revision=1
archs="x86_64"
create_wrksrc=yes
skip_extraction="gpk-linux-amd64"
short_desc="GlazePKG package manager dashboard"
maintainer="Ryoku <releases@ryoku.dev>"
license="GPL-3.0-or-later"
homepage="https://github.com/neur0map/glazepkg"
distfiles="${homepage}/releases/download/v${version}/gpk-linux-amd64"
checksum=a700edea745900be76a3a289155dccb6a7c16fda13dcc02b262236cfc848b9d8
nostrip=yes

# Upstream's release binary detects XBPS at runtime; it has no pacman dependency.
do_install() {
	vbin "${XBPS_SRCDISTDIR}/${pkgname}-${version}/gpk-linux-amd64" gpk
}
