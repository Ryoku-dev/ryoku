short_desc="Ryoku compositor-neutral desktop payload and runtime"
maintainer="Ryoku <releases@ryoku.dev>"
license="GPL-3.0-or-later, AGPL-3.0-or-later"
homepage="https://ryoku.dev"
distfiles="https://repo.ryoku.dev/sources/ryoku-${version}.tar.gz"
checksum=SKIP
wrksrc="ryoku-${version}"

conf_files="/etc/elogind/logind.conf.d/10-ryoku-lid.conf /etc/xdg/mimeapps.list"
# 60-ryoku-i2c.rules hands /dev/i2c-* to this group for DDC brightness.
system_groups="i2c"

_do_payload() {
	GOFLAGS="-buildmode=pie" \
	RYOKU_SRC="$wrksrc" \
	RYOKU_PKGVER="$version" \
	RYOKU_RELEASE="${RYOKU_RELEASE:-local-${version}}" \
	RYOKU_CHANNEL="${RYOKU_CHANNEL:-local}" \
	RYOKU_NAME="${RYOKU_NAME:-Ryoku}" \
	RYOKU_BUILD_DIR="$wrksrc/.xbps-build/ryoku-desktop" \
		"$wrksrc/release/packages/ryoku-desktop/payload.sh" "$@"
}

do_build() {
	_do_payload build
}

do_install() {
	_do_payload install "$DESTDIR" runit
}
