do_install() {
	_srcdir="${XBPS_SRCDISTDIR}/${pkgname}-${version}"
	vinstall "${_srcdir}/Rubik[wght].ttf" 644 usr/share/fonts/TTF
	vinstall "${_srcdir}/Rubik-Italic[wght].ttf" 644 usr/share/fonts/TTF
	vlicense "${_srcdir}/OFL.txt"
}
