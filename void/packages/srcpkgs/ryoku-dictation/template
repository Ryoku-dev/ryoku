# Template file for 'ryoku-dictation'
pkgname=ryoku-dictation
version=1.0.0
revision=1
archs="x86_64"
short_desc="Ryoku voice typing: local speech-to-text with Parakeet and Whisper"
maintainer="Ryoku <releases@ryoku.dev>"
license="GPL-3.0-or-later"
homepage="https://ryoku.dev"
hostmakedepends="cmake ninja pkgconf shaderc"
makedepends="pipewire-devel wayland-devel libxkbcommon-devel vulkan-loader-devel Vulkan-Headers"
depends="pipewire wayland libxkbcommon wl-clipboard vulkan-loader"
distfiles="https://repo.ryoku.dev/sources/ryoku-${version}.tar.gz"
wrksrc="ryoku-${version}"


_payload() {
	RYOKU_SRC="$wrksrc" \
	RYOKU_BUILD_DIR="${wrksrc%/*}/${pkgname}-payload-build" \
	RYOKU_PKGVER="$version" \
	RYOKU_RELEASE="$version" \
	RYOKU_CHANNEL="${RYOKU_CHANNEL:-stable}" \
	RYOKU_NAME="${RYOKU_NAME:-Ryoku}" \
		"$wrksrc/release/packages/$pkgname/payload.sh" "$@"
}

do_build() {
	_payload build
}

do_install() {
	# The runit service itself ships from ryoku-desktop, which installs every
	# void/init/user directory wholesale; nothing to place here.
	_payload install "$DESTDIR" runit
}
