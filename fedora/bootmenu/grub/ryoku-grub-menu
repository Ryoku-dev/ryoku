#!/usr/bin/bash
#
# Puts Ryoku into Fedora's GRUB menu, keeping shim, GRUB and the kernels
# exactly as Fedora signs them (issue #48).
#
#   install   copy the theme onto /boot, point /etc/default/grub at it, and
#             rebuild grub.cfg when either changed or grub.cfg does not
#             source the snapshot submenu yet (ryoku-desktop %posttrans)
#   purge     undo all of it and drop the snapshot menu and its kernels
#             (ryoku-desktop %preun on removal; %postun rebuilds grub.cfg)
#
# The theme's font is a copy of GRUB's Unifont on /boot: left to itself,
# grub2-mkconfig picks one from /usr/share/grub, which sits on the root
# filesystem GRUB cannot read on an encrypted install.
set -euo pipefail

grub_dir="${RYOKU_GRUB_DIR:-/boot/grub2}"
defaults="${RYOKU_GRUB_DEFAULTS:-/etc/default/grub}"
shipped="${RYOKU_GRUB_THEME_SRC:-/usr/share/ryoku/grub/theme}"
unifont="${RYOKU_GRUB_FONT_SRC:-/usr/share/grub/unicode.pf2}"
theme_dir="$grub_dir/themes/ryoku"
mkconfig="${RYOKU_GRUB_MKCONFIG:-grub2-mkconfig}"

# set_key <KEY> <value>: set KEY="value" in /etc/default/grub; returns 0 when
# the file changed.
set_key() {
  local line="$1=\"$2\""
  grep -qxF -- "$line" "$defaults" && return 1
  if grep -q "^$1=" "$defaults"; then
    sed -i "s|^$1=.*|$line|" "$defaults"
  else
    printf '%s\n' "$line" >>"$defaults"
  fi
}

# terminal_output: the current GRUB_TERMINAL_OUTPUT value, unquoted.
terminal_output() {
  sed -n 's/^GRUB_TERMINAL_OUTPUT="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$defaults"
}

drop_key() {
  grep -q "^$1=" "$defaults" || return 1
  sed -i "/^$1=/d" "$defaults"
}

# copy_new <src> <dest>: copy when the content differs; returns 0 when it did.
copy_new() {
  cmp -s "$1" "$2" && return 1
  cp -f "$1" "$2"
}

rebuild() {
  "$mkconfig" -o "$grub_dir/grub.cfg" >/dev/null
}

install_menu() {
  [ -d "$grub_dir" ] && [ -f "$defaults" ] || return 0
  mkdir -p "$theme_dir"
  # grub2-mkconfig loads the image modules the theme directory needs, so a
  # changed theme rebuilds grub.cfg too.
  local changed=1 file
  for file in "$shipped"/*; do
    copy_new "$file" "$theme_dir/${file##*/}" && changed=0
  done
  [ -f "$unifont" ] && cp -f "$unifont" "$theme_dir/unicode.pf2"

  # only Fedora's plain console becomes graphical; a serial or other chosen
  # terminal is kept, and the theme simply does not show there.
  case "$(terminal_output)" in
    "" | console) set_key GRUB_TERMINAL_OUTPUT gfxterm && changed=0 ;;
  esac
  set_key GRUB_FONT "$theme_dir/unicode.pf2" && changed=0
  set_key GRUB_THEME "$theme_dir/theme.txt" && changed=0
  if [ "$changed" = 0 ] || ! grep -qs "ryoku-snapshots.cfg" "$grub_dir/grub.cfg"; then
    rebuild
  fi
}

purge_menu() {
  [ -f "$defaults" ] || return 0
  if grep -qxF "GRUB_THEME=\"$theme_dir/theme.txt\"" "$defaults"; then
    drop_key GRUB_THEME || :
    drop_key GRUB_FONT || :
    [ "$(terminal_output)" = gfxterm ] && set_key GRUB_TERMINAL_OUTPUT console || :
  fi
  rm -rf "$theme_dir" "$grub_dir/ryoku-snapshots.cfg" "$(dirname "$grub_dir")/ryoku"
}

case "${1:-}" in
  install) install_menu ;;
  purge) purge_menu ;;
  *)
    echo "usage: ryoku-grub-menu install|purge" >&2
    exit 2
    ;;
esac
