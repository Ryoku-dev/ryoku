[Unit]
# Started by ryoku-snapshot-menu.path after a snapshot is created or deleted,
# and by ryoku-desktop's %posttrans. Rewrites the "Ryoku snapshots" GRUB submenu and
# keeps one kernel and initramfs copy per kernel version the snapshots need.
Description=Ryoku snapshot boot menu
# A dnf transaction or a snapper cleanup changes /.snapshots many times within
# a second. Each run is an idempotent resync, so the default start limit would
# only fail the unit and take the path trigger down with it.
StartLimitIntervalSec=0
ConditionPathExists=/etc/snapper/configs/root
RequiresMountsFor=/boot /.snapshots

[Service]
Type=oneshot
ExecStart=/usr/bin/ryoku boot-menu sync
Nice=10
IOSchedulingClass=idle
