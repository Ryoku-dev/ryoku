+++ b/ryoku/cli/internal/host/dnf_test.go
@@ -0,0 +1,99 @@
+package host
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"runtime"
+	"testing"
+)
+
+func fedoraPackageFixture(t *testing.T) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "fedora.tsv")
+	body := "arch\tfedora\tlanes\tnotes\nfd\tfd-find\tdesktop\t\ngithub-cli\tgh\tdesktop\t\nmissing\t-\tdesktop\tnot packaged\n"
+	if err := os.WriteFile(path, []byte(body), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func TestDNFPackageTranslationAndCommands(t *testing.T) {
+	table := fedoraPackageFixture(t)
+	runner := &fakeRunner{
+		paths: map[string]bool{"dnf5": true},
+		answer: func(command Command) Result {
+			if argv(command) == "rpm -q --quiet fd-find" || argv(command) == "rpm -q --quiet gh" {
+				return Result{}
+			}
+			if command.Name == "rpm" {
+				return Result{Code: 1}
+			}
+			return Result{}
+		},
+	}
+	app, stdout, stderr := testApp(runner, map[string]string{
+		"RYOKU_HOST_PKGMGR":       "dnf",
+		"RYOKU_HOST_FEDORA_TABLE": table,
+	})
+	if code := app.Package([]string{"installed", "fd", "github-cli"}); code != ExitOK {
+		t.Fatalf("installed exit = %d", code)
+	}
+	runner.commands = nil
+	if code := app.Package([]string{"install", "fd", "github-cli"}); code != ExitOK {
+		t.Fatalf("install exit = %d, stderr=%q", code, stderr.String())
+	}
+	if got := argv(runner.commands[len(runner.commands)-1]); got != "dnf5 install -y --setopt=install_weak_deps=False fd-find gh" {
+		t.Fatalf("install argv = %q", got)
+	}
+	runner.commands = nil
+	if code := app.Package([]string{"available", "fd"}); code != ExitOK {
+		t.Fatalf("available exit = %d", code)
+	}
+	if got := argv(runner.commands[0]); got != "dnf5 repoquery --available --quiet --qf %{name} fd-find" {
+		t.Fatalf("available argv = %q", got)
+	}
+	runner.commands = nil
+	if code := app.Package([]string{"install", "missing"}); code != ExitNotProvided {
+		t.Fatalf("unmapped install exit = %d", code)
+	}
+	if len(runner.commands) != 0 {
+		t.Fatalf("unmapped install ran commands: %v", runner.commands)
+	}
+	if stdout.Len() != 0 {
+		t.Fatalf("unexpected stdout: %q", stdout.String())
+	}
+}
+
+func TestDNFDetectionAndCapabilities(t *testing.T) {
+	runner := &fakeRunner{paths: map[string]bool{"dnf5": true}}
+	app, stdout, _ := testApp(runner, map[string]string{"RYOKU_HOST_INIT": "systemd"})
+	manager, err := app.PackageManager()
+	if err != nil || manager != DNF {
+		t.Fatalf("PackageManager = %q, %v", manager, err)
+	}
+	if code := app.Capabilities(); code != ExitOK {
+		t.Fatalf("Capabilities exit = %d", code)
+	}
+	want := "{\"packageManager\":\"dnf\",\"init\":\"systemd\",\"snapshots\":{\"supported\":false,\"reason\":\"Snapshot rollback is not enabled by the Fedora package layer.\"},\"aur\":{\"supported\":false,\"reason\":\"The AUR is an Arch Linux service; Fedora installs come from DNF.\"}}\n"
+	if got := stdout.String(); got != want {
+		t.Fatalf("capabilities = %q, want %q", got, want)
+	}
+}
+
+func TestFedoraPackageTable(t *testing.T) {
+	_, source, _, ok := runtime.Caller(0)
+	if !ok {
+		t.Fatal("could not locate host test source")
+	}
+	path := filepath.Join(filepath.Dir(source), "../../../../fedora/packages/rpm/payload/fedora.tsv")
+	table, err := readPackageTable(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, unavailable := dnfPackages(table, []string{"fd", "github-cli", "adw-gtk-theme", "ttf-jetbrains-mono-nerd"})
+	want := []string{"fd-find", "gh", "adw-gtk3-theme"}
+	if !reflect.DeepEqual(got, want) || !reflect.DeepEqual(unavailable, []string{"ttf-jetbrains-mono-nerd"}) {
+		t.Fatalf("translation = %v, unavailable = %v", got, unavailable)
+	}
+}
