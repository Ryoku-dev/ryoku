diff --git a/ryoku/cli/internal/host/dnf.go b/ryoku/cli/internal/host/dnf.go
new file mode 100644
index 0000000000000000000000000000000000000000..fd0e13914529ed7d8bd5f23ede0728ca9dad365f
--- /dev/null
+++ b/ryoku/cli/internal/host/dnf.go
@@ -0,0 +1,178 @@
+package host
+
+import (
+	"fmt"
+	"strings"
+)
+
+func (a *App) dnfCommand() string {
+	if a.cfg.Runner.LookPath("dnf5") {
+		return "dnf5"
+	}
+	return "dnf"
+}
+
+func (a *App) fedoraTable() (packageTable, error) {
+	path := a.getenv("RYOKU_HOST_FEDORA_TABLE")
+	if path == "" {
+		path = "/usr/share/ryoku/packages/fedora.tsv"
+	}
+	table, err := readPackageTable(path)
+	if err != nil {
+		return nil, err
+	}
+	return table, nil
+}
+
+func dnfPackages(table packageTable, names []string) ([]string, []string) {
+	return translatePackages(table, names)
+}
+
+func (a *App) dnf(args []string) int {
+	if len(args) == 0 {
+		return ExitUsage
+	}
+	verb, rest := args[0], args[1:]
+	table, err := a.fedoraTable()
+	if err != nil {
+		return a.failf("read Fedora package table: %v", err)
+	}
+	if verb == "count" {
+		if len(rest) > 1 || len(rest) == 1 && rest[0] != "--foreign" {
+			return ExitUsage
+		}
+		cmd, args := "rpm", []string{"-qa", "--qf", "%{NAME}\n"}
+		if len(rest) == 1 {
+			cmd, args = a.dnfCommand(), []string{"repoquery", "--extras", "--installed", "--qf", "%{name}"}
+		}
+		result := a.query(cmd, args...)
+		if result.Code != 0 {
+			return ExitFailure
+		}
+		fmt.Fprintln(a.cfg.Stdout, countLines(result.Output))
+		return ExitOK
+	}
+	if verb == "why" {
+		if len(rest) != 1 {
+			return ExitUsage
+		}
+		return ExitFalse
+	}
+	if verb == "local" {
+		if len(rest) == 0 {
+			return ExitUsage
+		}
+		for _, name := range rest {
+			mapping := translatePackage(table, name)
+			if mapping.Special != "" {
+				fmt.Fprintln(a.cfg.Stdout)
+			} else {
+				fmt.Fprintln(a.cfg.Stdout, strings.Join(mapping.Names, " "))
+			}
+		}
+		return ExitOK
+	}
+	upgrade := false
+	if verb == "install" {
+		for len(rest) > 0 && strings.HasPrefix(rest[0], "--") {
+			switch rest[0] {
+			case "--upgrade":
+				upgrade = true
+				rest = rest[1:]
+			case "--aur":
+				return ExitNotProvided
+			case "--overwrite":
+				if len(rest) < 2 {
+					return ExitUsage
+				}
+				rest = rest[2:]
+			default:
+				return ExitUsage
+			}
+		}
+	}
+	if len(rest) == 0 {
+		return ExitUsage
+	}
+	if verb == "version" || verb == "owner" {
+		if len(rest) != 1 {
+			return ExitUsage
+		}
+		switch verb {
+		case "version":
+			result := a.query("rpm", "-q", "--qf", "%{VERSION}-%{RELEASE}\n", rest[0])
+			if result.Code != 0 {
+				return ExitFalse
+			}
+			fmt.Fprint(a.cfg.Stdout, strings.TrimSpace(result.Output))
+			return ExitOK
+		case "owner":
+			result := a.query("rpm", "-qf", "--qf", "%{NAME}\n", rest[0])
+			if result.Code != 0 {
+				return ExitFalse
+			}
+			fmt.Fprint(a.cfg.Stdout, strings.TrimSpace(result.Output))
+			return ExitOK
+		}
+	}
+	if verb == "install-file" {
+		cmd := append([]string{"install", "-y"}, rest...)
+		return commandExit(a.run(a.dnfCommand(), cmd...))
+	}
+	if verb != "installed" && verb != "available" && verb != "install" && verb != "remove" && verb != "explicit" {
+		return ExitUsage
+	}
+	names, unavailable := dnfPackages(table, rest)
+	if len(unavailable) > 0 {
+		if verb == "installed" || verb == "available" {
+			return ExitFalse
+		}
+		fmt.Fprintf(a.cfg.Stderr, "ryoku-host: packages unavailable on Fedora: %s\n", strings.Join(unavailable, " "))
+		return ExitNotProvided
+	}
+	switch verb {
+	case "installed":
+		for _, name := range names {
+			if a.probe("rpm", "-q", "--quiet", name).Code != 0 {
+				return ExitFalse
+			}
+		}
+		return ExitOK
+	case "available":
+		for _, name := range names {
+			if a.probe(a.dnfCommand(), "repoquery", "--available", "--quiet", "--qf", "%{name}", name).Code != 0 {
+				return ExitFalse
+			}
+		}
+		return ExitOK
+	case "install":
+		args := []string{"install", "-y", "--setopt=install_weak_deps=False"}
+		if upgrade {
+			args = append([]string{"upgrade", "-y", "--setopt=install_weak_deps=False"}, names...)
+		} else {
+			args = append(args, names...)
+		}
+		return commandExit(a.run(a.dnfCommand(), args...))
+	case "remove":
+		return commandExit(a.run(a.dnfCommand(), append([]string{"remove", "-y"}, names...)...))
+	case "explicit":
+		cmd := a.dnfCommand()
+		if cmd == "dnf5" {
+			return commandExit(a.run(cmd, append([]string{"mark", "user"}, names...)...))
+		}
+		return commandExit(a.run(cmd, append([]string{"mark", "install"}, names...)...))
+	}
+	return ExitUsage
+}
+
+func (a *App) dnfOrphans() ([]string, error) {
+	result := a.query(a.dnfCommand(), "repoquery", "--unneeded", "--installed", "--qf", "%{name}")
+	if result.Code != 0 {
+		return nil, fmt.Errorf("dnf repoquery --unneeded: exit %d: %s", result.Code, strings.TrimSpace(result.Output))
+	}
+	output := strings.TrimSpace(result.Output)
+	if output == "" {
+		return nil, nil
+	}
+	return strings.Split(output, "\n"), nil
+}
