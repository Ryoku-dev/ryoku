#!/bin/bash
# Ryoku pre-commit, on staged additions:
#   1. no em-dash in text files (prose stays plain, not machine-styled)
#   2. bash syntax on staged shell scripts
#   3. no low-value filler phrases in added comment lines
# vendored ryoku/lockscreen/qylock is exempt. bypass with --no-verify only when
# you know what you're doing.
set -euo pipefail

fail() {
	echo "" >&2
	echo "pre-commit rejected this commit:" >&2
	echo "  $1" >&2
	echo "" >&2
	exit 1
}

# The em-dash check skips the vendored qylock tree, ryoku/i18n/catalog, the
# embedded potion model and Rashin's vendored skill sets. The catalog is
# generated: its keys are the English source strings verbatim (including
# em-dashes vendored sources still carry), and a key that differs from its
# source no longer matches at lookup. sync.py already strips em-dashes from
# every translation. The model's tokenizer.json is a third-party vocabulary,
# and the em-dash is one of its tokens. The skill sets are upstream files kept
# byte-identical by bin/ryoku-dev-sync-rashin-skills.
exempt='^ryoku/lockscreen/qylock/|^ryoku/i18n/catalog/|^ryoku/rashin/internal/index/embed/model/|^ryoku/rashin/internal/skills/sets/'
text='\.(md|txt|sh|bash|yml|yaml|toml|json|jsonc|conf|lua|tpl|fish|desktop|rules)$|(^|/)(README|NOTICE|LICENSE)$'

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACM)

# 1. em-dash scan over text files.
for f in "${staged[@]}"; do
	[[ -f $f ]] || continue
	[[ $f =~ $exempt ]] && continue
	[[ $f =~ $text ]] || continue
	if git show ":$f" | grep -q $'\xe2\x80\x94'; then
		git show ":$f" | grep -n $'\xe2\x80\x94' >&2
		fail "em-dash found in $f. Use a comma, colon, period, or parentheses."
	fi
done

# 2. bash syntax on staged shell scripts (extension or shebang).
for f in "${staged[@]}"; do
	[[ -f $f ]] || continue
	[[ $f =~ $exempt ]] && continue
	case "$f" in
		*.sh | *.bash) ;;
		*)
			first=$(head -n1 "$f" 2>/dev/null)
			[[ $first == '#!'*bash* || $first == '#!/bin/sh' || $first == '#!/usr/bin/env sh' ]] || continue
			;;
	esac
	if ! git show ":$f" | bash -n 2>/tmp/ryoku-bashn.err; then
		cat /tmp/ryoku-bashn.err >&2
		fail "bash syntax error in $f."
	fi
done

# 3. filler phrases in ADDED comment lines, via the shared scanner (vendored
#    tree excluded). same check runs in CI (.github/workflows/ai-slop.yml).
bin/ryoku-dev-scan-slop --staged >/dev/null \
	|| fail "low-value filler comments found (see above); reword or drop them."

# 4. update-delivery: every user config in the repo reaches an installed box.
bin/ryoku-dev-verify-delivery --quiet \
	|| fail "a config in ryoku/apps reaches no user (see above); ship it from a PKGBUILD or a deploy path. See docs/updates.md."

# 5. wm-isolation: compositor specifics stay inside the ryoku/wm seam.
bin/ryoku-dev-verify-wm-isolation --quiet \
	|| fail "compositor specifics leak outside ryoku/wm (see above); gate on a capability or route through wm.Client."

# 6. a QML object that sets a property twice never loads, and qmllint misses it.
mapfile -t staged_qml < <(printf '%s\n' "${staged[@]}" | grep -E '\.qml$' | grep -vE '^ryoku/lockscreen/qylock/' || true)
if ((${#staged_qml[@]})); then
	bin/ryoku-dev-verify-qml-bindings --quiet "${staged_qml[@]}" \
		|| fail "a QML object sets the same property or handler twice (see above); merge them into one."
fi

# 7. review gate (rashin-reviewer, settings in .rashin-reviewer.yaml): no
#    secrets or conflict markers, no JSON, YAML, TOML, Python, Lua or QML file
#    the commit leaves unparseable, and ShellCheck (CI's flags) and gofmt clean
#    on the added lines. A clone that sets `git config ryoku.reviewGate
#    required` refuses to commit without the reviewer; elsewhere a missing
#    reviewer skips this step, like ShellCheck in pre-push.
reviewer=$(command -v rashin-reviewer || true)
[[ -z $reviewer && -x $HOME/.local/bin/rashin-reviewer ]] && reviewer=$HOME/.local/bin/rashin-reviewer
if [[ -n $reviewer ]]; then
	rc=0
	"$reviewer" hook run pre-commit || rc=$?
	case $rc in
		0) ;;
		1) fail "rashin-reviewer found blocking issues (see above)." ;;
		*) fail "rashin-reviewer could not run (exit $rc); fix or reinstall it." ;;
	esac
elif [[ $(git config --get ryoku.reviewGate || true) == required ]]; then
	fail "this clone requires the review gate (git config ryoku.reviewGate required), but rashin-reviewer is not installed."
fi

exit 0
