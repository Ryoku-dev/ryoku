#!/bin/bash

# Ryoku Arch pre-push.
# safety net for pushes to origin:
#   1. main moves only as the release fast-forward from unstable-dev
#      (RYOKU_RELEASE_PUSH=1 says this is that push); never rewritten, never deleted
#   2. CI-equivalent ShellCheck over non-vendored shell files in the push

set -euo pipefail

zero='0000000000000000000000000000000000000000'
push_updates="$(mktemp)"
trap 'rm -f "$push_updates"' EXIT

fail() {
  echo "" >&2
  echo "pre-push hook rejected this push:" >&2
  echo "  $1" >&2
  echo "" >&2
  exit 1
}

while read -r local_ref local_sha remote_ref remote_sha; do
  printf '%s %s %s %s\n' "$local_ref" "$local_sha" "$remote_ref" "$remote_sha" >>"$push_updates"

  # 1. main is the stable channel users run. work never lands on it directly:
  #    it advances only when a release is cut, by fast-forwarding to a commit
  #    unstable-dev already carries (docs/updates.md, "Publishing"). a push to
  #    main therefore has to say so (RYOKU_RELEASE_PUSH=1), move forward, and
  #    land on origin/unstable-dev; nothing deletes or rewrites it.
  if [[ $remote_ref == "refs/heads/main" ]]; then
    if [[ $local_sha == "$zero" ]]; then
      fail "deleting main is blocked."
    fi
    if [[ -z ${RYOKU_RELEASE_PUSH:-} ]]; then
      echo "pre-push hook: this push moves main." >&2
      echo "  main only syncs to unstable-dev when a release is ready; work goes to" >&2
      echo "  unstable-dev (every push there publishes the testing channel)." >&2
      echo "" >&2
      echo "to cut the release fast-forward on purpose:" >&2
      echo "  RYOKU_RELEASE_PUSH=1 git push origin unstable-dev:main" >&2
      fail "push to main blocked."
    fi
    if [[ $remote_sha != "$zero" ]] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      echo "pre-push hook: this push rewrites history on main." >&2
      echo "  local  $local_sha" >&2
      echo "  remote $remote_sha" >&2
      echo "" >&2
      echo "users who pulled the old main would have broken updates; main is never rewritten." >&2
      fail "force-push to main blocked."
    fi
    upstream_tip="$(git rev-parse --verify --quiet refs/remotes/origin/unstable-dev || true)"
    if [[ -z $upstream_tip ]] || ! git merge-base --is-ancestor "$local_sha" "$upstream_tip" 2>/dev/null; then
      echo "pre-push hook: main would move to a commit origin/unstable-dev does not carry." >&2
      echo "  local  $local_sha" >&2
      echo "  origin/unstable-dev ${upstream_tip:-missing (git fetch origin unstable-dev)}" >&2
      echo "" >&2
      echo "a release fast-forwards main onto unstable-dev; land the work there first." >&2
      fail "main only advances onto unstable-dev."
    fi
  fi
done

# 2. ShellCheck shell scripts in the push (skip if shellcheck missing), with the
#    flags the ShellCheck workflow and installation/tests/iso-preflight.sh use:
#    a rolling box's info-level rules disagree with the runner's generation, so
#    the hook must not refuse what CI accepts (a release push covers every
#    script main is missing).
if command -v shellcheck >/dev/null 2>&1; then
	empty_tree=4b825dc642cb6eb9a060e54bf8d69288fbee4904
	files=()
	while read -r _ local_sha _ remote_sha; do
		[[ $local_sha == "$zero" ]] && continue
		base=$remote_sha
		[[ $base == "$zero" || -z $base ]] && base=$empty_tree
		# NUL-delimited throughout (git -z, read -d '', xargs -0) so paths with
		# spaces or shell metacharacters are never word-split by the collector.
		while IFS= read -r -d '' f; do
			[[ -f $f ]] || continue
			case "$f" in
				*.sh | *.bash) files+=("$f") ;;
				*) first=; IFS= read -r first <"$f" 2>/dev/null || true; [[ $first == '#!'*bash* ]] && files+=("$f") ;;
			esac
		done < <(git diff -z --name-only --diff-filter=ACM "$base" "$local_sha" -- . ':(glob,exclude)**/vendor/**' \
			':(exclude)ryoku/lockscreen/qylock' ':(exclude)ryoku/rashin/internal/skills/sets')
	done <"$push_updates"
	if ((${#files[@]} > 0)); then
		printf '%s\0' "${files[@]}" | sort -zu | xargs -0 -r shellcheck -x -s bash --severity=warning \
			|| fail "ShellCheck failed on pushed shell files."
	fi
fi

# 3. commit subjects stay short. the new commits in this push (which a bypassed
#    or missing commit-msg hook could have let through) must keep a subject of
#    72 chars or fewer, so the log and the generated release notes read at a
#    glance. a brand-new branch has no remote base to bound the range and its
#    history predates the rule, so it is skipped.
while read -r _ local_sha _ remote_sha; do
  [[ $local_sha == "$zero" ]] && continue
  [[ $remote_sha == "$zero" || -z $remote_sha ]] && continue
  while IFS= read -r subject; do
    case "$subject" in
      Revert\ *|fixup!\ *|squash!\ *) continue ;;
    esac
    # A PR merged on GitHub gets " (#NNN)" appended to the title after the
    # author's commit-msg hook already ran, so the pushed subject can exceed
    # the limit through no fault of the author. Measure what they wrote.
    if [[ $subject =~ ^(.*)\ \(#[0-9]+\)$ ]]; then
      subject="${BASH_REMATCH[1]}"
    fi
    if ((${#subject} > 72)); then
      fail "a pushed commit subject is ${#subject} chars (limit 72): $subject"
    fi
  done < <(git log --no-merges --format='%s' "$remote_sha..$local_sha")
done <"$push_updates"

# 4. PKGBUILD dependency resolution. A depends/provides change that no longer
#    resolves (a typo, an AUR-only name, a virtual nothing provides) builds fine
#    with makepkg --nodeps but fails the publish gate AFTER the push, stranding a
#    whole release on the testing channel. Run the same check the publish uses,
#    but only when a pushed commit touches release/packages, so an ordinary push
#    pays nothing. Skips itself when pacman is absent (the script handles that).
while read -r _ local_sha _ remote_sha; do
  [[ $local_sha == "$zero" ]] && continue
  base=$remote_sha
  [[ $base == "$zero" || -z $base ]] && base=4b825dc642cb6eb9a060e54bf8d69288fbee4904
  if git diff --name-only "$base" "$local_sha" -- 'release/packages/**/PKGBUILD' | grep -q .; then
    repo_root="$(git rev-parse --show-toplevel)"
    if [[ -x $repo_root/bin/ryoku-dev-verify-pkgbuild-deps ]]; then
      "$repo_root/bin/ryoku-dev-verify-pkgbuild-deps" \
        || fail "a PKGBUILD dependency does not resolve; fix it or the publish will fail after this push."
    fi
    break
  fi
done <"$push_updates"

# 5. Vendored window-manager seam copies. They are checked in, so a change to
#    ryoku/wm leaves every consumer running the old detection and capability
#    rules until someone re-copies them. Only runs when the push touches the seam
#    or a copy, so an ordinary push pays nothing.
while read -r _ local_sha _ remote_sha; do
  [[ $local_sha == "$zero" ]] && continue
  base=$remote_sha
  [[ $base == "$zero" || -z $base ]] && base=4b825dc642cb6eb9a060e54bf8d69288fbee4904
  if git diff --name-only "$base" "$local_sha" -- 'ryoku/wm/**' '**/vendor/ryoku-wm/**' | grep -q .; then
    repo_root="$(git rev-parse --show-toplevel)"
    if [[ -x $repo_root/bin/ryoku-dev-verify-wm-vendor ]]; then
      "$repo_root/bin/ryoku-dev-verify-wm-vendor" \
        || fail "a vendored window-manager seam copy is stale; re-copy it from ryoku/wm."
    fi
    break
  fi
done <"$push_updates"

exit 0
