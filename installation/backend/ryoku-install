#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
#
# ryoku-install: the Ryoku Arch install backend.
#
# answers come from RYOKU_* env vars (the TUI sets them, full contract in
# installation/backend/README.md). does a direct Arch install: partition,
# optional LUKS, format, mount, pacstrap, configure, Limine.
#
# progress sentinels to the TUI:
#   @@RYOKU_STEP <id>   stage begins
#   @@RYOKU_DONE        printed once after the final stage succeeds
# any failure exits non-zero (set -e) without @@RYOKU_DONE.
#
# RYOKU_DRYRUN=1 prints every destructive command (prefixed "DRYRUN: ") instead
# of running it, so the whole flow can be exercised without a real disk.

set -euo pipefail

SELF=$(realpath "${BASH_SOURCE[0]}")
BACKEND_DIR=$(dirname "$SELF")
LIB_DIR="$BACKEND_DIR/lib"

# shellcheck source=lib/common.sh
source "$LIB_DIR/common.sh"
# shellcheck source=lib/preflight.sh
source "$LIB_DIR/preflight.sh"
# shellcheck source=lib/disk.sh
source "$LIB_DIR/disk.sh"
# shellcheck source=lib/resize.sh
source "$LIB_DIR/resize.sh"
# shellcheck source=lib/luks.sh
source "$LIB_DIR/luks.sh"
# shellcheck source=lib/filesystem.sh
source "$LIB_DIR/filesystem.sh"
# shellcheck source=lib/pacstrap.sh
source "$LIB_DIR/pacstrap.sh"
# shellcheck source=lib/mirrors.sh
source "$LIB_DIR/mirrors.sh"
# shellcheck source=lib/chroot.sh
source "$LIB_DIR/chroot.sh"
# shellcheck source=lib/deploy.sh
source "$LIB_DIR/deploy.sh"
# shellcheck source=lib/network.sh
source "$LIB_DIR/network.sh"
# shellcheck source=lib/drivers.sh
source "$LIB_DIR/drivers.sh"
# shellcheck source=lib/bootloader.sh
source "$LIB_DIR/bootloader.sh"
# shellcheck source=lib/aur.sh
source "$LIB_DIR/aur.sh"
# shellcheck source=lib/snapshots.sh
source "$LIB_DIR/snapshots.sh"
# shellcheck source=lib/offline.sh
source "$LIB_DIR/offline.sh"
# shellcheck source=lib/cachyos.sh
source "$LIB_DIR/cachyos.sh"

# probe: read-only disk inspection for the TUI. no RYOKU_* contract, no disk
# writes, so it runs BEFORE the install-answer validation below (which dies on a
# missing password/strategy). usage: ryoku-install probe alongside <disk>.
if [[ ${1:-} == probe ]]; then
  case ${2:-} in
    alongside)
      [[ -n ${3:-} ]] || die "usage: ryoku-install probe alongside <disk>"
      ryoku_probe_alongside "$3"
      exit 0 ;;
    resize)
      [[ -n ${3:-} ]] || die "usage: ryoku-install probe resize <disk>"
      ryoku_probe_resize "$3"
      exit 0 ;;
    *) die 'unknown probe '\''%s'\'' (supported: '\''alongside'\'', '\''resize'\'')' "${2:-}" ;;
  esac
fi

# defaults for the optional half of the contract.
: "${RYOKU_HOSTNAME:=ryoku}"
: "${RYOKU_USERNAME:=ryoku}"
: "${RYOKU_KEYMAP:=us}"
: "${RYOKU_XKB_LAYOUT:=}"
: "${RYOKU_XKB_VARIANT:=}"
: "${RYOKU_LOCALE:=en_US.UTF-8}"
: "${RYOKU_TIMEZONE:=UTC}"
: "${RYOKU_PROFILE:=vm}"
# disk strategy is required: do NOT default it. defaulting to whole was a silent
# wipe path when the TUI dropped the pick. validation below.
: "${RYOKU_DISK_STRATEGY:=}"
: "${RYOKU_ESP_GIB:=1}"
: "${RYOKU_ESP_MODE:=auto}"
: "${RYOKU_SWAP_GIB:=0}"
: "${RYOKU_SUBVOL_SNAPSHOTS:=1}"
: "${RYOKU_SUBVOL_HOME:=1}"
: "${RYOKU_SUBVOL_BACKUPS:=0}"
: "${RYOKU_REPO:=/usr/share/ryoku}"
# variant: plain (stock Arch) or cachyos (the full CachyOS layer). build.sh bakes
# the marker into the ISO airootfs; it drives the cachy pacstrap set (pacstrap.sh),
# the linux-cachyos boot entry (bootloader.sh), and the CachyOS repo wiring below.
: "${RYOKU_VARIANT:=$(cat "$RYOKU_REPO/variant" 2>/dev/null || echo plain)}"
export RYOKU_VARIANT
: "${RYOKU_ONLINE:=1}"
# offline install (this ISO): the baked package closure the backend pacstraps
# from. present only on an offline ISO; ryoku_offline_active also requires
# RYOKU_ONLINE != 1, so a normal online install ignores it.
: "${RYOKU_OFFLINE_REPO:=/usr/share/ryoku/offline/repo}"
: "${RYOKU_PACMAN_CONF:=}"
# normalize the env-only switches so set -u + shellcheck stay quiet.
: "${RYOKU_DISK:=}"
: "${RYOKU_PASSWORD_HASH:=}"
: "${RYOKU_ENCRYPT:=}"
: "${RYOKU_LUKS_PASSPHRASE:=}"
: "${RYOKU_GPU_MODE:=}"
: "${RYOKU_COMPOSITOR:=}"
: "${RYOKU_COMPOSITOR_CONFIG_DIR:=}"
: "${RYOKU_COMPOSITOR_GPU_PIN:=}"
: "${RYOKU_BROWSER:=}"
: "${RYOKU_DROP_PACKAGES:=}"
export RYOKU_DROP_PACKAGES
# the browser and app choices the TUI collected. RYOKU_BROWSER is one of
# zen|chromium|firefox (empty = the shipped default, zen, so a direct
# backend call behaves like the installer). the losing browsers join the
# drop list once, here, so every package-set reader filters one set.
if [[ -n ${RYOKU_BROWSER:-} ]]; then
  case $RYOKU_BROWSER in
    zen|chromium|firefox) ;;
    *) die "RYOKU_BROWSER='%s' is not one of the shipped browsers (zen|chromium|firefox)" "$RYOKU_BROWSER" ;;
  esac
else
  RYOKU_BROWSER=zen
fi
export RYOKU_BROWSER
case ",${RYOKU_DROP_PACKAGES}," in
  *,zen-browser-bin,*) ;;
  *) [[ $RYOKU_BROWSER == zen ]] || RYOKU_DROP_PACKAGES="${RYOKU_DROP_PACKAGES:+$RYOKU_DROP_PACKAGES,}zen-browser-bin" ;;
esac
case ",${RYOKU_DROP_PACKAGES}," in
  *,chromium,*) ;;
  *) [[ $RYOKU_BROWSER == chromium ]] || RYOKU_DROP_PACKAGES="${RYOKU_DROP_PACKAGES:+$RYOKU_DROP_PACKAGES,}chromium" ;;
esac
case ",${RYOKU_DROP_PACKAGES}," in
  *,firefox,*) ;;
  *) [[ $RYOKU_BROWSER == firefox ]] || RYOKU_DROP_PACKAGES="${RYOKU_DROP_PACKAGES:+$RYOKU_DROP_PACKAGES,}firefox" ;;
esac
: "${RYOKU_REBOOT:=}"
: "${RYOKU_DRYRUN:=}"
# carve (in-place resize) contract: shrink RYOKU_RESIZE_PART to free
# RYOKU_RESIZE_TAKE_MIB before the alongside layout is placed. Absent = no carve.
: "${RYOKU_RESIZE_PART:=}"
: "${RYOKU_RESIZE_TAKE_MIB:=}"

# required answers.
[[ -n $RYOKU_DISK ]] || die "RYOKU_DISK is required"
[[ -n $RYOKU_PASSWORD_HASH ]] || die "RYOKU_PASSWORD_HASH is required"
[[ -n $RYOKU_COMPOSITOR ]] || die "RYOKU_COMPOSITOR is required (which window manager to install)"
[[ -n $RYOKU_COMPOSITOR_CONFIG_DIR ]] || die "RYOKU_COMPOSITOR_CONFIG_DIR is required: the TUI derives it from wm.ConfigDir, so an empty value means '$RYOKU_COMPOSITOR' is not a known compositor. Refusing rather than seeding an unseeded desktop."
case $RYOKU_DISK_STRATEGY in
  whole|alongside) ;;
  '') die "RYOKU_DISK_STRATEGY is required (use 'whole' or 'alongside'); refusing to wipe disk on empty strategy." ;;
  *)  die 'RYOKU_DISK_STRATEGY='\''%s'\'' not supported (use '\''whole'\'' or '\''alongside'\'').' "$RYOKU_DISK_STRATEGY" ;;
esac
if [[ $RYOKU_DISK_STRATEGY == alongside ]]; then
  case $RYOKU_ESP_MODE in
    auto|shared|dedicated) ;;
    *) die 'RYOKU_ESP_MODE must be auto, shared, or dedicated (got '\''%s'\'')' "$RYOKU_ESP_MODE" ;;
  esac
  [[ -z $RYOKU_DRYRUN || $RYOKU_ESP_MODE != auto ]] \
    || die "alongside dry-run cannot measure the existing ESP; set RYOKU_ESP_MODE=shared or dedicated."
fi
# encryption pairing: catch a missing passphrase HERE, before any disk work, so
# an encrypt request can't wipe + partition + luksFormat only to die at `open`.
# luks.sh keeps the same check as defense in depth for a direct backend call.
[[ ${RYOKU_ENCRYPT:-} != 1 || -n $RYOKU_LUKS_PASSPHRASE ]] || die "RYOKU_ENCRYPT=1 but RYOKU_LUKS_PASSPHRASE is unset"

main() {
  [[ -n $RYOKU_DRYRUN ]] && log "DRY RUN: no disk is touched; commands are printed only"
  log 'Ryoku install: disk=%s host=%s user=%s profile=%s wm=%s browser=%s' "$RYOKU_DISK" "$RYOKU_HOSTNAME" "$RYOKU_USERNAME" "$RYOKU_PROFILE" "$RYOKU_COMPOSITOR" "$RYOKU_BROWSER"

  ryoku_preflight
  # an offline install with no usable baked repo can only fail, and it must fail
  # here rather than after the wipe (see lib/offline.sh:ryoku_offline_verify).
  ryoku_offline_verify
  ryoku_ensure_dns
  ryoku_ensure_mirrors

  # build/verify the pacman keyring BEFORE the disk is touched: a broken keyring
  # otherwise surfaces only at pacstrap, after the wipe. offline (uses the live
  # archlinux-keyring), so it belongs in this preflight phase.
  ryoku_ensure_keyring

  step partition
  # carve first when a resize was requested: shrink the chosen partition to free a
  # region, then let the alongside layout drop into it. A no-op otherwise.
  ryoku_carve
  ryoku_partition
  ryoku_luks

  step filesystems
  ryoku_filesystems

  step mount
  ryoku_mount

  step pacstrap
  # offline install: point pacstrap at the baked [offline] repo (no-op online).
  ryoku_offline_prepare
  ryoku_rank_mirrors

  # Mask the hooks that misbehave in the chroot BEFORE pacstrap, which is where
  # they do their damage (snapper with no config, limine-install against a /boot
  # it mistakes for the ESP). Restored before we unmount.
  ryoku_hooks_quiet
  ryoku_pacstrap

  # Mask the initramfs hooks only now: limine-mkinitcpio-hook owns
  # /etc/pacman.d/hooks/90-mkinitcpio-install.hook, so a mask laid before
  # pacstrap is an unowned file at a packaged path and the transaction aborts
  # with "exists in filesystem". The kernel's own build during pacstrap is
  # discarded by the bootloader step's single mkinitcpio -P either way; from
  # here on the drivers and AUR steps rebuild nothing.
  ryoku_hooks_defer_mkinitcpio

  step configure
  ryoku_configure
  # cachyos variant: wire the CachyOS repos into the target's pacman.conf and
  # trust the key (offline-safe: cachyos-keyring was pacstrapped), so the
  # installed box tracks CachyOS on future updates. a no-op on plain.
  [[ $RYOKU_VARIANT == cachyos ]] && ryoku_cachyos_repo
  # offline: make the baked repo resolvable in the chroot so the per-hardware
  # driver step installs with no network (a no-op online); torn down below.
  ryoku_offline_chroot_on
  ryoku_deploy
  ryoku_network
  ryoku_drivers
  # bundled AUR toolset: install it from [offline] while the repo is still bound
  # (before chroot_off). online installs build these later in ryoku_aur instead.
  ryoku_offline_aur
  ryoku_offline_chroot_off

  step bootloader
  ryoku_bootloader

  ryoku_aur || true
  # with the AUR set installed, point the default browser at Zen if it landed.
  ryoku_default_browser

  # the AUR step may have installed limine-mkinitcpio-hook, whose pacman
  # hooks rebuilt the boot menu as the UKI tree: retire the flat placeholder
  # entry and repoint the default at the tree's newest kernel.
  ryoku_bootloader_finalize

  ryoku_snapshots
  ryoku_hooks_restore

  log "flushing the target to disk"
  run sync
  if [[ -z $RYOKU_DRYRUN ]]; then
    swapoff -a 2>/dev/null || true
    umount -R /mnt 2>/dev/null || true
  fi

  printf '@@RYOKU_DONE\n'
  log "install complete"

  if [[ -n $RYOKU_REBOOT ]]; then
    log "rebooting"
    run reboot
  fi
}

# failure handler on EXIT: fires on every exit but acts only on a non-zero
# status, so a clean finish is a no-op (main already unmounted /mnt and printed
# @@RYOKU_DONE). unlike a bare ERR trap this also catches an explicit die()
# (exit 1). on failure it names the stage we died in, restores the snap-pac
# hooks masked for the chroot, flushes to disk, and -- unlike the clean path --
# LEAVES /mnt mounted so the partial tree and the log can be inspected.
# @@RYOKU_DONE prints only on the clean path, so the sentinel protocol is intact.
RYOKU_STAGE=preflight
ryoku_on_exit() {
  local rc=$?
  (( rc == 0 )) && return 0
  trap - EXIT
  printf 'ERROR: install failed at stage "%s" (exit %d)\n' "${RYOKU_STAGE:-startup}" "$rc" >&2
  ryoku_hooks_restore || true
  ryoku_offline_chroot_off || true
  sync || true
  printf 'log: /var/log/ryoku-install.log & journalctl -b\n' >&2
  exit "$rc"
}
trap ryoku_on_exit EXIT

main "$@"
