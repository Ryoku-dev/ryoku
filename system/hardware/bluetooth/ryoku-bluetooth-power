#!/usr/bin/env bash
set -u

state_file="${RYOKU_BLUETOOTH_STATE_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/ryoku/bluetooth-power}"

save_state() {
  local state=$1 dir tmp
  dir=${state_file%/*}
  umask 077
  mkdir -p "$dir" || return 1
  tmp="$state_file.tmp.$$"
  trap 'rm -f "$tmp"' RETURN
  printf '%s\n' "$state" >"$tmp" || return 1
  mv -f "$tmp" "$state_file"
  trap - RETURN
}

saved_state() {
  local state=on
  if [[ -r $state_file ]]; then
    IFS= read -r state <"$state_file" || state=on
  fi
  case $state in
    on|off) printf '%s\n' "$state" ;;
    *) printf 'on\n' ;;
  esac
}

controller_available() {
  bluetoothctl list 2>/dev/null | command grep -q '^Controller[[:space:]]'
}

powered() {
  bluetoothctl show 2>/dev/null | command grep -q '^[[:space:]]*Powered:[[:space:]]*yes'
}

powered_off() {
  bluetoothctl show 2>/dev/null | command grep -q '^[[:space:]]*Powered:[[:space:]]*no'
}

# after a bluetoothd restart the controller can register seconds late and AutoEnable answers Busy
wait_seconds=${RYOKU_BLUETOOTH_WAIT:-15}

retry_until_deadline() {
  local deadline=$((SECONDS + wait_seconds))
  until "$@"; do
    ((SECONDS < deadline)) || return 1
    sleep 0.1
  done
}

power_off_confirmed() {
  controller_available && bluetoothctl power off >/dev/null 2>&1 && powered_off
}

power_on_accepted() {
  controller_available && { bluetoothctl power on >/dev/null 2>&1 || powered; }
}

superseded() {
  [[ $(saved_state) != "$1" ]]
}

# a newer choice from the bar or the Hub ends an older loop still waiting on the controller
attempt_while_wanted() {
  local lock="$state_file.lock"
  if command -v flock >/dev/null 2>&1 && mkdir -p "${state_file%/*}" 2>/dev/null && : 2>/dev/null >>"$lock"; then
    (flock -w 5 9 || exit 1; superseded "$1" || "${@:2}") 9>>"$lock"
  else
    superseded "$1" || "${@:2}"
  fi
}

apply_state() {
  case $1 in
    off)
      command -v bluetoothctl >/dev/null 2>&1 || return 1
      retry_until_deadline attempt_while_wanted off power_off_confirmed
      ;;
    on)
      if command -v rfkill >/dev/null 2>&1; then
        rfkill unblock bluetooth >/dev/null 2>&1 || true
      fi
      command -v bluetoothctl >/dev/null 2>&1 || return 1
      retry_until_deadline attempt_while_wanted on power_on_accepted
      ;;
  esac
}

set_state() {
  local state=$1
  save_state "$state" || return 1
  apply_state "$state"
}

case ${1:-} in
  on|off)
    set_state "$1"
    ;;
  toggle)
    if command -v bluetoothctl >/dev/null 2>&1 && powered; then
      set_state off
    else
      set_state on
    fi
    ;;
  restore)
    apply_state "$(saved_state)"
    ;;
  state)
    saved_state
    ;;
  is-on)
    command -v bluetoothctl >/dev/null 2>&1 && powered
    ;;
  *)
    echo 'Usage: ryoku-bluetooth-power <on|off|toggle|restore|state|is-on>' >&2
    exit 2
    ;;
esac
