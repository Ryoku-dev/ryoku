#!/usr/bin/env bash
set -euo pipefail

cfg="${XDG_CONFIG_HOME:-$HOME/.config}/ryoku/shell.json"
lim=1
if jq -e '.audio.boost == true' "$cfg" >/dev/null 2>&1; then
	lim=1.5
fi

# The step is a Ryoku Settings choice (audio.step, 1-25 percent, 5 shipped), so
# the keys and the bar's wheel walk the same grid. A value that is not a number
# falls back to the shipped step; a number outside the range clamps to its ends.
step="$(jq -r '.audio.step // 5' "$cfg" 2>/dev/null || echo 5)"
case "$step" in
'' | *[!0-9]*) step=5 ;;
esac
[ "$step" -lt 1 ] && step=1
[ "$step" -gt 25 ] && step=25

cur="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf "%d", $2 * 100 + 0.5}')"
max="$(awk -v l="$lim" 'BEGIN{printf "%d", l * 100 + 0.5}')"

case "${1:-up}" in
up)
	next=$(((cur / step) * step + step))
	;;
down)
	next=$((((cur + step - 1) / step) * step - step))
	;;
*)
	echo "usage: ryoku-volume {up|down}" >&2
	exit 1
	;;
esac

[ "$next" -lt 0 ] && next=0
[ "$next" -gt "$max" ] && next="$max"

exec wpctl set-volume -l "$lim" @DEFAULT_AUDIO_SINK@ "${next}%"
