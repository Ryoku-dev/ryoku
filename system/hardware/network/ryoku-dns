#!/usr/bin/env bash
set -euo pipefail

conf=/etc/NetworkManager/conf.d/20-ryoku-dns.conf
provider=${1:-}
conf_dir=${conf%/*}
tmp=

cleanup() {
  [[ -z $tmp ]] || rm -f -- "$tmp"
}
trap cleanup EXIT

if (( EUID != 0 )); then
  exec pkexec "$(readlink -f "$0")" "$@"
fi

write_dns() {
  local servers=$1
  install -d -m755 "$conf_dir"
  tmp=$(mktemp "$conf_dir/.20-ryoku-dns.conf.XXXXXX")
  cat >"$tmp" <<EOF
# Managed by ryoku-dns. Run ryoku-dns dhcp to restore connection-provided DNS.
[global-dns]

[global-dns-domain-*]
servers=$servers
EOF
  chmod 0644 "$tmp"
  mv -f -- "$tmp" "$conf"
  tmp=
}

valid_server() {
  local server=$1 octet
  if [[ $server =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    IFS=. read -r -a octets <<<"$server"
    for octet in "${octets[@]}"; do
      (( 10#$octet <= 255 )) || return 1
    done
    return 0
  fi
  [[ $server == *:* && $server =~ ^[0-9A-Fa-f:]+$ ]] &&
    /usr/bin/getent ahosts "$server" >/dev/null
}

case "${provider,,}" in
  cloudflare)
    write_dns "1.1.1.1,1.0.0.1,2606:4700:4700::1111,2606:4700:4700::1001"
    ;;
  google)
    write_dns "8.8.8.8,8.8.4.4,2001:4860:4860::8888,2001:4860:4860::8844"
    ;;
  custom)
    shift
    (( $# > 0 )) || { echo "custom DNS requires at least one server" >&2; exit 1; }
    for server in "$@"; do
      valid_server "$server" || { echo "invalid DNS server: $server" >&2; exit 1; }
    done
    servers=$(IFS=,; printf '%s' "$*")
    write_dns "$servers"
    ;;
  dhcp)
    rm -f "$conf"
    ;;
  *)
    echo "usage: ryoku-dns <dhcp|cloudflare|google|custom> [servers...]" >&2
    exit 2
    ;;
esac

if ryoku-host svc --system is-active NetworkManager; then
  nmcli general reload conf >/dev/null || ryoku-host svc --system reload NetworkManager
  nmcli general reload dns-full >/dev/null 2>&1 || true
fi
