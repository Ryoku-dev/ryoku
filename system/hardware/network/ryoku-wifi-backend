#!/usr/bin/env bash
# NetworkManager Wi-Fi backend switch, driven by Settings -> Connections.
#
# Ryoku defaults to iwd, but iwd's WPA3-SAE support is incomplete: WPA3-only and
# mixed WPA2/WPA3 networks -- which most Android phone hotspots now are -- fail
# to associate under iwd while wpa_supplicant (>= 2.10) handles SAE fine. This
# flips NetworkManager's backend for the whole system so a user who hits such a
# network can get online without reinstalling.
#
# Privileged: it rewrites the NM drop-in and restarts NetworkManager.
# 51-ryoku-wifi-backend.rules grants exactly this binary to the wheel group
# without a password, so the toggle stays one click (the DNS switch works the
# same way). `get` is read-only and needs no privilege.
#
#   get              print the active backend: iwd | wpa_supplicant
#   iwd              use iwd (the Ryoku default)
#   wpa_supplicant   use wpa_supplicant (WPA3 / Android hotspots)
set -u

CONF="${RYOKU_WIFI_BACKEND_CONF:-/etc/NetworkManager/conf.d/wifi-backend.conf}"
# Under runit the marker is what keeps iwd supervised: NetworkManager can only
# D-Bus-activate iwd where an activation file exists (systemd), Void's iwd
# ships none, so the service manifest's wifi-iwd row links /etc/sv/iwd while
# this file exists and unlinks it when it is gone.
IWD_STATE="${RYOKU_WIFI_IWD_STATE:-/var/lib/ryoku/wifi-iwd.enabled}"
HOST="${RYOKU_WIFI_BACKEND_HOST:-ryoku-host}"
PHYS="${RYOKU_WIFI_BACKEND_PHYS:-/sys/class/ieee80211}"
IW="${RYOKU_WIFI_BACKEND_IW:-iw}"

# systemd iff its runtime directory exists, else runit; the path is a knob so a
# hermetic test can run both lanes on one box.
on_systemd() { [[ -d ${RYOKU_WIFI_BACKEND_SYSTEMD_DIR:-/run/systemd/system} ]]; }

current() {
  if [[ -r $CONF ]] && grep -qiE '^[[:space:]]*wifi\.backend[[:space:]]*=[[:space:]]*wpa_supplicant' "$CONF"; then
    echo wpa_supplicant
  else
    # No drop-in, or it names iwd: iwd is both the Ryoku default and what the
    # installer pins, so treat anything that is not wpa_supplicant as iwd.
    echo iwd
  fi
}

# supervise_iwd keeps iwd's runit service in step with the backend. On systemd
# nothing is recorded: NetworkManager activates iwd over D-Bus there.
supervise_iwd() {
  local backend=$1
  on_systemd && return 0
  if [[ $backend == iwd ]]; then
    # /var/lib/ryoku is shared state whose mode tmpfiles owns (0755); mkdir -p
    # never re-modes an existing directory, install -d would.
    mkdir -p "$(dirname "$IWD_STATE")"
    : >"$IWD_STATE"
  else
    rm -f "$IWD_STATE"
  fi
  "$HOST" svc reconcile --system
}

# iwd replaces each radio's default interface with one of its own and deletes
# that one when it stops, so leaving iwd left wpa_supplicant no interface to
# drive until a reboot. radios_with_interfaces, read before the stop, names
# the radios to watch; restore_interfaces gives each one that ends up bare a
# managed interface again. The kernel deletes iwd's interface just after iwd
# exits, not before the stop returns, and one radio at a time, so each radio
# is watched for up to 3 s.
radios_with_interfaces() {
  local phy
  for phy in "$PHYS"/phy*; do
    [[ -d $phy ]] && compgen -G "$phy/device/net/*" >/dev/null && echo "${phy##*/}"
  done
}

restore_interfaces() {
  local phy i left=("$@") next
  for ((i = 0; i < 30 && ${#left[@]}; i++)); do
    next=()
    for phy in "${left[@]}"; do
      if compgen -G "$PHYS/$phy/device/net/*" >/dev/null; then
        next+=("$phy")
        continue
      fi
      "$IW" phy "$phy" interface add "wlan${phy#phy}" type managed || true
    done
    left=("${next[@]}")
    ((${#left[@]})) && sleep 0.1
  done
}

apply() {
  local backend=$1
  mkdir -p "$(dirname "$CONF")"
  cat >"$CONF" <<EOF
# Managed by ryoku-wifi-backend (Settings -> Connections). NetworkManager's
# Wi-Fi backend: iwd is the Ryoku default; wpa_supplicant handles the WPA3-SAE
# networks (Android phone hotspots) that iwd cannot yet associate with.
[device]
wifi.backend=$backend
EOF
  supervise_iwd "$backend"
  # Only one supplicant may own the radio at a time. Stop the one we are leaving;
  # NetworkManager D-Bus-activates the one we keep when it restarts below, and
  # under runit the reconcile above starts iwd (a fresh runsv needs a moment,
  # so the explicit start is only a shortcut).
  if [[ $backend == wpa_supplicant ]]; then
    local radios
    mapfile -t radios < <(radios_with_interfaces)
    "$HOST" svc --system stop iwd 2>/dev/null || true
    restore_interfaces "${radios[@]}"
  else
    "$HOST" svc --system stop wpa_supplicant 2>/dev/null || true
    on_systemd || "$HOST" svc --system start iwd 2>/dev/null || true
  fi
  "$HOST" svc --system restart NetworkManager
}

case "${1:-get}" in
  get)
    current
    ;;
  iwd | wpa_supplicant)
    apply "$1"
    ;;
  *)
    echo "usage: ryoku-wifi-backend [get | iwd | wpa_supplicant]" >&2
    exit 2
    ;;
esac
