#!/usr/bin/env bash

# Official-repository install through the host package seam. Bundle manifests
# keep using Ryoku's Arch-side catalogue names; ryoku-host translates them for
# the active package manager. Needs a TTY for the sudo prompt, which is why the
# Hub runs installs in a floating terminal.

set -euo pipefail

(($#)) || {
  echo "ryoku-pkg-add: no packages given" >&2
  exit 2
}

# Pacman keeps its full-sync transaction so installing against stale databases
# cannot create a partial upgrade. Fedora installs the newest available RPMs;
# unlike `dnf upgrade`, this also installs bundle packages that are not present.
if [[ $(ryoku-host pkgmgr 2>/dev/null) == dnf ]]; then
  exec sudo ryoku-host pkg install "$@"
fi
exec sudo pacman -Syu --needed --noconfirm "$@"
