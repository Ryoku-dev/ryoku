#!/usr/bin/env bash

# Ryoku plus the CachyOS kernel, and nothing else: add ONLY the [cachyos-v3]
# repository (where linux-cachyos lives) above [core], and trust the CachyOS
# key. The userland stays Arch + [ryoku] -- we do NOT add the core/extra
# rebuilds (so a later `pacman -Syu` cannot convert the userland) or the
# baseline [cachyos] repo (which ships CachyOS's forked pacman). The stock
# kernel stays as the boot fallback. See docs/kernels.md. Needs a TTY for sudo.
# (The full-CachyOS install variant is a separate path: installation/backend/lib/cachyos.sh.)

set -euo pipefail

if [[ $(ryoku-host pkgmgr 2>/dev/null) == dnf ]]; then
  echo "ryoku-pkg-cachyos: the CachyOS repository is not available on Fedora" >&2
  exit 5
fi

conf=/etc/pacman.conf
key=F3B607488DB35A47
mirror=https://mirror.cachyos.org/repo

# serialize the pacman.conf + keyring mutation below: a double-fired bundle
# install (two Hub terminals racing) could otherwise duplicate the repo
# stanza. the second holder just waits, then exits on the idempotence checks.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/ryoku-pkg-conf.lock"
flock 9

if ! /lib/ld-linux-x86-64.so.2 --help 2>/dev/null | grep -q 'x86-64-v3 (supported'; then
  echo "ryoku-pkg-cachyos: this CPU does not support x86-64-v3; the CachyOS kernel needs it" >&2
  exit 1
fi

# stock pacman resolves Architecture = auto to x86_64 and rejects the v3
# packages, so it must also accept x86_64_v3. an active line gets the value
# appended whatever its spacing; a config without one (hand-edited, or the
# line only in a comment) gets the line inserted under [options], never by
# rewriting a commented line, which could sit inside a repo section and
# would break pacman's parse there. verified after, so a silent sed no-op
# exits loudly instead of stranding a repo pacman then rejects.
if ! grep -qE '^Architecture[[:space:]]*=.*x86_64_v3' "$conf"; then
  echo "==> Allowing x86_64_v3 packages in $conf"
  if grep -qE '^Architecture[[:space:]]*=' "$conf"; then
    sudo sed -i 's|^Architecture[[:space:]]*=.*|& x86_64_v3|' "$conf"
  else
    sudo sed -i 's|^\[options\]$|[options]\nArchitecture = auto x86_64_v3|' "$conf"
  fi
  grep -qE '^Architecture[[:space:]]*=.*x86_64_v3' "$conf" || {
    echo "ryoku-pkg-cachyos: could not enable x86_64_v3 in $conf (set 'Architecture = auto x86_64_v3' by hand)" >&2
    exit 1
  }
fi

if grep -qE '^\[cachyos' "$conf"; then
  echo "cachyos: repository already configured"
  exit 0
fi

echo "==> Trusting the CachyOS signing key"
sudo pacman-key --recv-keys "$key" --keyserver keyserver.ubuntu.com \
  || sudo pacman-key --recv-keys "$key" --keyserver hkps://keys.openpgp.org
sudo pacman-key --lsign-key "$key"

echo "==> Adding the [cachyos-v3] repository above [core]"
block="[cachyos-v3]\nServer = $mirror/x86_64_v3/cachyos-v3\n\n[core]"
sudo sed -i "0,/^\[core\]/ s|^\[core\]|$block|" "$conf"
if ! grep -qE '^\[cachyos-v3\]' "$conf"; then
  echo "ryoku-pkg-cachyos: could not add the [cachyos-v3] repository to $conf" >&2
  exit 1
fi

echo "==> Synchronizing package databases"
sudo pacman -Sy

# best-effort: the keyring package keeps trust current across key rotations.
# recv/lsign above already covers today's packages if it is unavailable.
sudo pacman -S --needed --noconfirm cachyos-keyring || true
