[
  {
    "tab": "Behaviour",
    "group": "POINTER",
    "key": "wm.niri.warpMouseToFocus",
    "label": "Move the pointer to the focused window",
    "desc": "When you focus a window with the keyboard, the pointer moves onto it",
    "ctl": "chips",
    "src": "desktop.json",
    "page": "windowmanager",
    "opts": [
      "off",
      "separate",
      "center-xy",
      "center-xy-always"
    ],
    "optLabels": {
      "off": "Off",
      "separate": "Nudge onto the window",
      "center-xy": "Centre on the window",
      "center-xy-always": "Always centre"
    }
  },
  {
    "tab": "Behaviour",
    "group": "POINTER",
    "key": "wm.niri.focusFollowsMouseScroll",
    "label": "Scroll limit when focus follows the pointer",
    "desc": "How far the view may scroll when the pointer focuses a window; -1 means no limit",
    "ctl": "step",
    "src": "desktop.json",
    "lo": -1,
    "hi": 100,
    "unit": "%",
    "adv": true,
    "page": "windowmanager"
  },
  {
    "tab": "Behaviour",
    "group": "WORKSPACES",
    "key": "wm.niri.workspaceAutoBackAndForth",
    "label": "Toggle back to the last workspace",
    "desc": "Focusing the current workspace again returns to the previous one",
    "ctl": "sw",
    "src": "desktop.json",
    "page": "windowmanager"
  },
  {
    "tab": "Behaviour",
    "group": "MODIFIER KEY",
    "key": "wm.niri.modKey",
    "label": "Main modifier key",
    "desc": "The key the window manager's own shortcuts use as their main modifier",
    "ctl": "seg",
    "src": "desktop.json",
    "adv": true,
    "page": "windowmanager",
    "opts": [
      "Super",
      "Alt",
      "Ctrl",
      "Shift"
    ]
  },
  {
    "tab": "Behaviour",
    "group": "MODIFIER KEY",
    "key": "wm.niri.modKeyNested",
    "label": "Main modifier when running in a window",
    "desc": "If you open this desktop inside a window on another desktop, its shortcuts use this key so they don't clash with the other desktop's shortcuts",
    "ctl": "seg",
    "src": "desktop.json",
    "adv": true,
    "page": "windowmanager",
    "opts": [
      "Super",
      "Alt",
      "Ctrl",
      "Shift"
    ]
  },
  {
    "tab": "Behaviour",
    "group": "SESSION",
    "key": "wm.niri.disablePowerKey",
    "label": "Ignore the power key",
    "desc": "Let the system decide what the power key does instead of the window manager",
    "ctl": "sw",
    "src": "desktop.json",
    "page": "windowmanager"
  },
  {
    "tab": "Behaviour",
    "group": "DRAG GESTURES",
    "key": "wm.niri.dndEdgeViewScrollTriggerWidth",
    "label": "Edge scrolling area",
    "desc": "How close to the screen edge a dragged window must come to scroll the view",
    "ctl": "step",
    "src": "desktop.json",
    "lo": 0,
    "hi": 512,
    "unit": "px",
    "adv": true,
    "page": "windowmanager"
  },
  {
    "tab": "Behaviour",
    "group": "DRAG GESTURES",
    "key": "wm.niri.dndEdgeViewScrollDelayMs",
    "label": "Edge scrolling delay",
    "desc": "How long a drag waits at the edge before the view scrolls",
    "ctl": "step",
    "src": "desktop.json",
    "lo": 0,
    "hi": 2000,
    "unit": "ms",
    "adv": true,
    "page": "windowmanager"
  },
  {
    "tab": "Behaviour",
    "group": "DRAG GESTURES",
    "key": "wm.niri.dndEdgeViewScrollMaxSpeed",
    "label": "Edge scrolling speed",
    "desc": "How fast the view scrolls while you drag at the edge",
    "ctl": "step",
    "src": "desktop.json",
    "lo": 0,
    "hi": 10000,
    "unit": "px/s",
    "adv": true,
    "page": "windowmanager"
  },
  {
    "tab": "Behaviour",
    "group": "DRAG GESTURES",
    "key": "wm.niri.dndEdgeWorkspaceTriggerHeight",
    "label": "Workspace switch area",
    "desc": "How close to the top or bottom edge a drag must come to switch workspace",
    "ctl": "step",
    "src": "desktop.json",
    "lo": 0,
    "hi": 512,
    "unit": "px",
    "adv": true,
    "page": "windowmanager"
  },
  {
    "tab": "Behaviour",
    "group": "DRAG GESTURES",
    "key": "wm.niri.dndEdgeWorkspaceDelayMs",
    "label": "Workspace switch delay",
    "desc": "How long a drag waits at the edge before the workspace switches",
    "ctl": "step",
    "src": "desktop.json",
    "lo": 0,
    "hi": 2000,
    "unit": "ms",
    "adv": true,
    "page": "windowmanager"
  },
  {
    "tab": "Behaviour",
    "group": "DRAG GESTURES",
    "key": "wm.niri.dndEdgeWorkspaceMaxSpeed",
    "label": "Workspace switch speed",
    "desc": "How fast workspaces switch while you drag at the edge",
    "ctl": "step",
    "src": "desktop.json",
    "lo": 0,
    "hi": 10000,
    "unit": "px/s",
    "adv": true,
    "page": "windowmanager"
  }
]
