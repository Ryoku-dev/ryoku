[
  {
    "tab": "Layout",
    "group": "WINDOW WIDTH",
    "key": "wm.niri.defaultColumnWidth",
    "label": "New window width",
    "desc": "How much of the screen's width a new window takes",
    "ctl": "slid",
    "src": "desktop.json",
    "lo": 0.25,
    "hi": 1,
    "unit": "%",
    "pct": true,
    "page": "windowmanager"
  },
  {
    "tab": "Layout",
    "group": "WINDOW WIDTH",
    "key": "wm.niri.presetColumnWidths",
    "label": "Widths to switch between",
    "desc": "Each press of the Step column width shortcut moves the window to the next of these widths",
    "ctl": "chips",
    "src": "desktop.json",
    "page": "windowmanager",
    "opts": [
      "0.33333, 0.66667",
      "0.33333, 0.5, 0.66667",
      "0.25, 0.5, 0.75"
    ],
    "optLabels": {
      "0.33333, 0.66667": "Thirds",
      "0.33333, 0.5, 0.66667": "Thirds and half",
      "0.25, 0.5, 0.75": "Quarters"
    }
  },
  {
    "tab": "Layout",
    "group": "COLUMN FOCUS",
    "key": "wm.niri.centerFocusedColumn",
    "label": "Keep the focused window centred",
    "desc": "Slide the window you focus into the middle of the screen",
    "ctl": "chips",
    "src": "desktop.json",
    "page": "windowmanager",
    "opts": [
      "never",
      "always",
      "on-overflow"
    ],
    "optLabels": {
      "never": "Never",
      "always": "Always",
      "on-overflow": "When it won't fit"
    }
  },
  {
    "tab": "Layout",
    "group": "COLUMN FOCUS",
    "key": "wm.niri.alwaysCenterSingleColumn",
    "label": "Centre a lone window",
    "desc": "Open a lone window centred; it scrolls once another joins",
    "ctl": "sw",
    "src": "desktop.json",
    "page": "windowmanager"
  },
  {
    "tab": "Layout",
    "group": "TABBED COLUMNS",
    "key": "wm.niri.tabIndicatorWidth",
    "label": "Tab strip thickness",
    "desc": "How thick the tab strip is on a column of stacked windows",
    "ctl": "step",
    "src": "desktop.json",
    "lo": 0,
    "hi": 16,
    "unit": "px",
    "page": "windowmanager"
  },
  {
    "tab": "Layout",
    "group": "TABBED COLUMNS",
    "key": "wm.niri.tabIndicatorHideSingle",
    "label": "Hide the tab strip for a lone window",
    "desc": "Show the tab strip only when a column holds two or more",
    "ctl": "sw",
    "src": "desktop.json",
    "page": "windowmanager"
  },
  {
    "tab": "Layout",
    "group": "DRAG AND DROP",
    "key": "wm.niri.insertHint",
    "label": "Show where a dragged window will land",
    "desc": "Highlight the slot a dragged window will drop into",
    "ctl": "sw",
    "src": "desktop.json",
    "page": "windowmanager"
  },
  {
    "tab": "Layout",
    "group": "URGENT WINDOWS",
    "key": "wm.niri.urgentColor",
    "label": "Urgent window colour",
    "desc": "Outline colour for a background window wanting attention",
    "ctl": "color",
    "src": "desktop.json",
    "page": "windowmanager"
  },
  {
    "tab": "Layout",
    "group": "ROOM FOR BARS AND DOCKS",
    "key": "wm.niri.struts.left",
    "label": "Left edge",
    "desc": "Room kept free for a bar or dock",
    "ctl": "step",
    "src": "desktop.json",
    "lo": 0,
    "hi": 256,
    "unit": "px",
    "page": "windowmanager"
  },
  {
    "tab": "Layout",
    "group": "ROOM FOR BARS AND DOCKS",
    "key": "wm.niri.struts.right",
    "label": "Right edge",
    "desc": "Room kept free for a bar or dock",
    "ctl": "step",
    "src": "desktop.json",
    "lo": 0,
    "hi": 256,
    "unit": "px",
    "page": "windowmanager"
  },
  {
    "tab": "Layout",
    "group": "ROOM FOR BARS AND DOCKS",
    "key": "wm.niri.struts.top",
    "label": "Top edge",
    "desc": "Room kept free for a bar or dock",
    "ctl": "step",
    "src": "desktop.json",
    "lo": 0,
    "hi": 256,
    "unit": "px",
    "page": "windowmanager"
  },
  {
    "tab": "Layout",
    "group": "ROOM FOR BARS AND DOCKS",
    "key": "wm.niri.struts.bottom",
    "label": "Bottom edge",
    "desc": "Room kept free for a bar or dock",
    "ctl": "step",
    "src": "desktop.json",
    "lo": 0,
    "hi": 256,
    "unit": "px",
    "page": "windowmanager"
  },
  {
    "tab": "Look",
    "group": "TITLE BARS",
    "key": "wm.niri.preferNoCsd",
    "label": "Hide app title bars",
    "desc": "Asks apps not to draw their own title bars. Some apps keep them anyway; reopen apps after changing this",
    "keywords": "titlebar titlebars csd client-side decorations",
    "ctl": "sw",
    "src": "desktop.json",
    "page": "windowmanager"
  },
  {
    "tab": "Behaviour",
    "group": "OVERVIEW",
    "key": "wm.niri.overviewZoom",
    "label": "Overview zoom",
    "desc": "How far the overview pulls back; lower fits more",
    "ctl": "slid",
    "src": "desktop.json",
    "lo": 0.1,
    "hi": 0.75,
    "unit": "%",
    "pct": true,
    "page": "windowmanager"
  },
  {
    "tab": "Behaviour",
    "group": "OVERVIEW",
    "key": "wm.niri.hotCorners",
    "label": "Hot corners",
    "desc": "Push the pointer into a screen corner to open the overview",
    "ctl": "sw",
    "src": "desktop.json",
    "page": "windowmanager"
  },
  {
    "tab": "Behaviour",
    "group": "MOTION",
    "key": "wm.niri.animationSlowdown",
    "label": "Slow down animations",
    "desc": "Stretches every animation; above 1 is slower, below 1 is snappier",
    "ctl": "slid",
    "src": "desktop.json",
    "lo": 0.25,
    "hi": 3,
    "unit": "\u00d7",
    "adv": true,
    "page": "windowmanager"
  },
  {
    "tab": "Behaviour",
    "group": "STARTUP",
    "key": "wm.niri.hotkeyOverlaySkip",
    "label": "Skip the shortcut list at sign-in",
    "desc": "Don't show the list of keyboard shortcuts when the desktop starts",
    "ctl": "sw",
    "src": "desktop.json",
    "page": "windowmanager"
  },
  {
    "tab": "Behaviour",
    "group": "SCREENSHOTS",
    "key": "wm.niri.screenshotPath",
    "label": "Save niri's own screenshots to",
    "desc": "Where screenshots from niri's built-in tool are saved, apart from the screenshot tool; %Y, %m and %d become the date",
    "ctl": "text",
    "src": "desktop.json",
    "eg": "~/Pictures/Screenshots/Screenshot %Y-%m-%d.png",
    "page": "windowmanager",
    "adv": true
  },
  {
    "tab": "Behaviour",
    "group": "PRIVACY",
    "key": "wm.niri.blockOutApps",
    "label": "Hide apps from screen sharing",
    "desc": "They show as a blank box when you share or record the screen. Enter each app's ID, as App rules shows it beside the app's name, separated by commas",
    "ctl": "text",
    "src": "desktop.json",
    "eg": "org.keepassxc.KeePassXC, org.gnome.World.Secrets",
    "page": "windowmanager"
  },
  {
    "tab": "Behaviour",
    "group": "KEY SOUNDS",
    "key": "",
    "label": "Keyboard sounds",
    "desc": "Installs a small sound engine that plays a sound on every key press, in every app, without slowing the window manager",
    "ctl": "install",
    "pkg": "ryoku-keysounds-niri",
    "launch": "ryoku-keysounds",
    "actionLabel": "Install sound engine",
    "src": "desktop.json",
    "page": "windowmanager"
  },
  {
    "tab": "Behaviour",
    "group": "KEY SOUNDS",
    "key": "wm.niri.keysounds.enabled",
    "label": "Play a sound on every key press",
    "desc": "A sound plays in every app and window as you type",
    "ctl": "sw",
    "src": "desktop.json",
    "page": "windowmanager"
  },
  {
    "tab": "Behaviour",
    "group": "KEY SOUNDS",
    "key": "wm.niri.keysounds.profile",
    "label": "Sound profile",
    "desc": "Which keyboard switch you hear; sound packs you add show here too",
    "ctl": "seg",
    "src": "desktop.json",
    "opts": [
      "cherry-mx-blue",
      "cherry-mx-brown",
      "cherry-mx-black",
      "cherry-mx-red",
      "topre",
      "creamy",
      "nk-cream",
      "holy-panda",
      "tealios",
      "crystal-purple",
      "oreo"
    ],
    "optLabels": {
      "cherry-mx-blue": "Cherry MX Blue",
      "cherry-mx-brown": "Cherry MX Brown",
      "cherry-mx-black": "Cherry MX Black",
      "cherry-mx-red": "Cherry MX Red",
      "topre": "Topre",
      "creamy": "Creamy",
      "nk-cream": "NK Cream",
      "holy-panda": "Holy Panda",
      "tealios": "Tealios",
      "crystal-purple": "Crystal Purple",
      "oreo": "Oreo"
    },
    "when": {
      "wm.niri.keysounds.enabled": [
        true
      ]
    },
    "page": "windowmanager"
  },
  {
    "tab": "Behaviour",
    "group": "KEY SOUNDS",
    "key": "wm.niri.keysounds.volume",
    "label": "Volume",
    "desc": "How loud the key sounds play",
    "ctl": "slid",
    "src": "desktop.json",
    "lo": 0,
    "hi": 1,
    "unit": "%",
    "pct": true,
    "when": {
      "wm.niri.keysounds.enabled": [
        true
      ]
    },
    "page": "windowmanager"
  },
  {
    "tab": "Behaviour",
    "group": "KEY SOUNDS",
    "key": "wm.niri.keysounds.release",
    "label": "Key release sound",
    "desc": "Also play a softer sound when you let go of a key",
    "ctl": "sw",
    "src": "desktop.json",
    "when": {
      "wm.niri.keysounds.enabled": [
        true
      ]
    },
    "page": "windowmanager"
  }
]
