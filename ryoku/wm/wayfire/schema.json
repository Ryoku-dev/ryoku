    "src": "desktop.json",
    "lo": 0,
    "hi": 3,
    "when": {"desktop.appearance.blurEnabled": [true]},
    "page": "windowmanager"
  },
  {
    "tab": "Look",
    "group": "BLUR",
    "key": "wm.wayfire.blur.blurByDefault",
    "label": "Blur these windows",
    "desc": "Which windows get blur behind them, written as a match rule",
    "ctl": "text",
    "src": "desktop.json",
    "eg": "type is \"toplevel\"",
    "when": {"desktop.appearance.blurEnabled": [true]},
    "page": "windowmanager"
  },
  {
    "tab": "Look",
    "group": "BLUR",
    "key": "wm.wayfire.blur.degrade",
