    "page": "windowmanager"
  },
  {
    "tab": "Look",
    "group": "WINDOW BUTTONS",
    "key": "wm.wayfire.decoration.buttonOrder",
    "label": "Button order",
    "desc": "Title bar buttons in the order they appear, separated by spaces",
