    "hi": 10,
    "page": "windowmanager"
  },
  {
    "tab": "Layout",
    "group": "WORKSPACE GRID",
    "key": "wm.wayfire.workspace.rows",
    "label": "Workspace rows",
    "desc": "How many workspaces down; takes effect at the next sign-in",
    "ctl": "step",
    "src": "desktop.json",
    "lo": 1,
    "hi": 10,
    "page": "windowmanager"
  },
  {
    "tab": "Layout",
    "group": "WORKSPACE GRID",
    "key": "wm.wayfire.workspace.wraparound",
    "label": "Wrap around when switching workspaces",
    "desc": "Going past the last workspace continues from the opposite edge, or from the first",
