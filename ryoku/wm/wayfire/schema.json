    "ctl": "step",
    "src": "desktop.json",
    "lo": 0,
    "hi": 100,
    "unit": "px",
    "page": "windowmanager"
  },
  {
    "tab": "Look",
    "group": "TITLE BARS",
    "key": "wm.wayfire.decoration.font",
    "label": "Title font",
    "desc": "Font for the window manager's title bars",
    "ctl": "text",
    "src": "desktop.json",
    "eg": "sans-serif",
    "page": "windowmanager"
  },
  {
    "tab": "Look",
    "group": "TITLE BARS",
    "key": "wm.wayfire.decoration.fontColor",
    "label": "Title colour",
