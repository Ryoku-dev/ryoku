    "src": "desktop.json",
    "opts": ["false", "true", "on_end"],
    "optLabels": {
      "false": "Off",
      "true": "At the grid edge",
      "on_end": "After the first or last"
    },
    "page": "windowmanager"
  },
  {
    "tab": "Layout",
    "group": "NEW WINDOWS",
    "key": "wm.wayfire.placement.mode",
    "label": "Floating window placement",
    "desc": "Where a newly opened floating window starts",
    "ctl": "chips",
    "src": "desktop.json",
    "opts": ["center", "cascade", "maximize", "random", "pointer"],
    "optLabels": {
      "center": "Centre",
      "cascade": "Cascade",
      "maximize": "Maximise",
      "random": "Random",
      "pointer": "At pointer"
    },
    "page": "windowmanager"
  },
  {
    "tab": "Look",
    "group": "TITLE BARS",
    "key": "wm.wayfire.decoration.mode",
    "label": "Who draws title bars",
    "desc": "Apps draw their own, or the window manager draws one for every window",
    "ctl": "seg",
    "src": "desktop.json",
    "opts": ["client", "server"],
    "optLabels": {"client": "Apps", "server": "Window manager"},
    "page": "windowmanager"
  },
  {
    "tab": "Look",
    "group": "TITLE BARS",
    "key": "wm.wayfire.decoration.titleHeight",
    "label": "Title bar height",
