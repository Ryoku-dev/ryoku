    "ctl": "text",
    "src": "desktop.json",
    "eg": "app_id is \"org.example.App\"",
    "adv": true,
    "page": "windowmanager"
  },
  {
    "tab": "Look",
    "group": "DECORATION RULES",
    "key": "wm.wayfire.decoration.forcedViews",
    "label": "Always add a title bar to",
    "desc": "Windows that always get a title bar from the window manager, written as a match rule",
    "ctl": "text",
    "src": "desktop.json",
    "eg": "app_id is \"org.example.App\"",
    "adv": true,
    "page": "windowmanager"
  },
  {
    "tab": "Look",
    "group": "BLUR",
    "key": "wm.wayfire.blur.method",
    "label": "Blur style",
    "desc": "How the blur is drawn",
    "ctl": "chips",
    "src": "desktop.json",
    "opts": ["box", "gaussian", "kawase", "bokeh"],
    "optLabels": {
      "box": "Box",
      "gaussian": "Gaussian",
      "kawase": "Kawase",
      "bokeh": "Bokeh"
    },
    "when": {"desktop.appearance.blurEnabled": [true]},
    "page": "windowmanager"
  },
  {
    "tab": "Look",
    "group": "BLUR",
    "key": "wm.wayfire.blur.saturation",
    "label": "Blur saturation",
    "desc": "How much colour stays in what is blurred",
