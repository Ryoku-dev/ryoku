[
  {
    "tab": "Layout",
    "group": "TILING",
    "key": "wm.wayfire.tiling.tileByDefault",
    "label": "New windows",
    "desc": "Open regular windows tiled or floating",
    "ctl": "chips",
    "src": "desktop.json",
    "opts": ["all", "none"],
    "optLabels": {"all": "Tiled", "none": "Floating"},
    "page": "windowmanager"
  },
  {
    "tab": "Layout",
    "group": "TILING",
    "key": "wm.wayfire.tiling.keepFullscreenOnAdjacent",
    "label": "Keep full screen when switching windows",
    "desc": "A tiled window stays full screen when you move focus to the one beside it",
    "ctl": "sw",
    "src": "desktop.json",
    "page": "windowmanager"
  },
  {
    "tab": "Layout",
    "group": "WORKSPACE GRID",
    "key": "wm.wayfire.workspace.columns",
