#!/usr/bin/env bash
set -euo pipefail

app="Google Lens"
input_file=""
remove_input=false

notify_failure() {
	notify-send -u critical "$app" "$1" 2>/dev/null || true
}

while (( $# > 0 )); do
	case "$1" in
	--file)
		[[ -n ${2:-} ]] || { notify_failure "Missing image path"; exit 2; }
		input_file="$2"
		shift 2
		;;
	--remove-input)
		remove_input=true
		shift
		;;
	*)
		notify_failure "Usage: ryoku-cmd-google-lens [--file IMAGE] [--remove-input]"
		exit 2
		;;
	esac
done

runtime="${XDG_RUNTIME_DIR:-}"
if [[ -z $runtime || ! -d $runtime || ! -w $runtime || ! -O $runtime ]]; then
	notify_failure "Private temporary storage is unavailable"
	exit 1
fi

umask 077
if [[ -z $input_file ]]; then
	for command in grim slurp; do
		command -v "$command" >/dev/null 2>&1 || {
			notify_failure "$command is not installed"
			exit 1
		}
	done
	input_file=$(mktemp --tmpdir="$runtime" ryoku-google-lens-XXXXXXXX.png)
	remove_input=true
	geometry=$(slurp 2>/dev/null) || {
		rm -f -- "$input_file"
		exit 130
	}
	[[ -n $geometry ]] || {
		rm -f -- "$input_file"
		exit 0
	}
	ryoku-cmd-grim -g "$geometry" "$input_file"
fi

[[ -r $input_file ]] || {
	notify_failure "Could not read the captured image"
	exit 1
}
crop=""
html=""
cleanup() {
	[[ -z $crop ]] || rm -f -- "$crop"
	[[ -z $html ]] || rm -f -- "$html"
	if $remove_input; then
		rm -f -- "$input_file"
	fi
}
trap cleanup EXIT HUP INT TERM

crop=$(mktemp --tmpdir="$runtime" ryoshot-lens-XXXXXXXX.jpg)
html=$(mktemp --tmpdir="$runtime" ryoshot-lens-XXXXXXXX.html)

if command -v magick >/dev/null 2>&1; then
	magick "$input_file" -resize '1000x1000>' -strip -quality 85 "$crop" 2>/dev/null ||
		cp -- "$input_file" "$crop"
else
	cp -- "$input_file" "$crop"
fi

if ! b64=$(base64 -w0 "$crop" 2>/dev/null); then
	b64=$(base64 "$crop" 2>/dev/null | tr -d '\n') || {
		notify_failure "Could not prepare the captured image"
		exit 1
	}
fi

cat >"$html" <<EOF
<!DOCTYPE html><html><body style="margin:0;display:flex;justify-content:center;align-items:center;height:100vh;background:#111;color:#fff;font-family:system-ui"><p>Searching with Google Lens…</p><form id="f" method="POST" enctype="multipart/form-data" action="https://lens.google.com/v3/upload"></form><script>var b=atob("$b64"),a=new Uint8Array(b.length);for(var i=0;i<b.length;i++)a[i]=b.charCodeAt(i);var d=new DataTransfer();d.items.add(new File([a],"i.jpg",{type:"image/jpeg"}));var inp=document.createElement("input");inp.type="file";inp.name="encoded_image";inp.files=d.files;document.getElementById("f").appendChild(inp);document.getElementById("f").submit();</script></body></html>
EOF

url="file://$html"

launch_command() {
	local command_string="$1"
	local -a argv=()
	read -r -a argv <<<"$command_string"
	[[ ${#argv[@]} -gt 0 ]] || return 1
	command -v "${argv[0]}" >/dev/null 2>&1 || return 1
	"${argv[@]}" "$url" >/dev/null 2>&1 &
}

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
configured=""
if command -v jq >/dev/null 2>&1; then
	configured=$(jq -r '.desktop.apps.browser // empty' \
		"$config_home/ryoku/desktop.json" 2>/dev/null || true)
fi

opened=false
if [[ -n $configured ]] && launch_command "$configured"; then
	opened=true
fi

if ! $opened && command -v xdg-settings >/dev/null 2>&1 &&
	command -v gtk-launch >/dev/null 2>&1; then
	desktop=$(xdg-settings get default-web-browser 2>/dev/null || true)
	if [[ $desktop == *.desktop ]] &&
		gtk-launch "$desktop" "$url" >/dev/null 2>&1; then
		opened=true
	fi
fi

if ! $opened && [[ -n ${BROWSER:-} ]] && launch_command "${BROWSER%%:*}"; then
	opened=true
fi

if ! $opened; then
	for candidate in firefox chromium zen zen-browser google-chrome; do
		if launch_command "$candidate"; then
			opened=true
			break
		fi
	done
fi

if ! $opened; then
	notify_failure "No web browser is available. Pick one in Settings > Default Apps."
	exit 1
fi

sleep 15
