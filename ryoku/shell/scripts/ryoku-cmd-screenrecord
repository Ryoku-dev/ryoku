#!/bin/bash

set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  ryoku-cmd-screenrecord [--fullscreen|--region|--monitor <NAME>] [--geometry <WxH+X+Y>] [--with-desktop-audio] [--with-microphone-audio]
  ryoku-cmd-screenrecord -r|-s|-sr
  ryoku-cmd-screenrecord --stop|--pause|--status

Starts, stops, or pauses Ryoku's shell recorder.

By default it records the focused monitor with gpu-screen-recorder's KMS capture
(-w <output>, falling back to -w screen when the focused output can't be named).
On multi-GPU machines where the display is driven by a card gpu-screen-recorder
cannot enumerate (KMS then reports "no monitor"), it records through the desktop
portal instead (PipeWire ScreenCast, still GPU-encoded, and works regardless of
which card scans out); it only falls back to wf-recorder if gpu-screen-recorder
is missing.

Override the backend with RYOKU_SCREENRECORD_BACKEND=auto|gsr|portal|wf.
Portal capture reuses the last chosen screen; set pickEachTime true in the Hub's
recording settings (or RYOKU_SCREENRECORD_PICK=1) to be asked which screen every
time.
USAGE
}

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a ryoku-cli "$@" >/dev/null 2>&1 || true
  fi
}

# The window manager is reached only through the seam, asked by capability and
# never by name.
ryoku_bin="${RYOKU_BIN-$(command -v ryoku || true)}"

wm_can() {  # capability -> 0 when the live compositor honours it
  [[ -n $ryoku_bin && -x $ryoku_bin ]] || return 1
  case ",$("$ryoku_bin" wm status 2>/dev/null | sed -n 's/^Capabilities: //p' | tr -d '[:space:]')," in
    *",$1,"*) return 0 ;;
  esac
  return 1
}

# Hub-owned recording settings (~/.config/ryoku/recording.json), written by the
# Recording page. env vars still override, then this file, then the built-in
# default. only video encode knobs live here (fps, quality, codec, framerate
# mode, encoder, cursor); capture mode and audio are per-recording flags.
recording_config_file() {
  printf '%s/ryoku/recording.json' "${XDG_CONFIG_HOME:-$HOME/.config}"
}

cfg_get() {
  local key="$1" def="$2" val="" f
  f="$(recording_config_file)"
  if [[ -r $f ]] && command -v jq >/dev/null 2>&1; then
    val="$(jq -r "$key // empty" "$f" 2>/dev/null || true)"
  fi
  printf '%s' "${val:-$def}"
}

cfg_bool() { # -> yes|no
  local v
  v="$(cfg_get "$1" "$2")"
  if [[ $v == true || $v == yes || $v == 1 ]]; then printf 'yes'; else printf 'no'; fi
}

require_command() {
  local command_name="$1"
  local label="$2"

  if ! command -v "$command_name" >/dev/null 2>&1; then
    notify -u critical "Screen recording failed" "$label is not installed"
    echo "ryoku-cmd-screenrecord: missing command: $command_name" >&2
    exit 1
  fi
}

gsr_pattern='(^|/)gpu-screen-recorder( |$)'
wf_pattern='(^|/)wf-recorder( |$)'

# pids of gpu-screen-recorder processes that are NOT replay buffers. A replay
# buffer (someone running `gpu-screen-recorder -r <sec>` themselves) carries the
# `-r` flag; a recording never does. Recording detection, stop and pause act only
# on these, so a background replay buffer is never mistaken for a recording (which
# would strand the shell's record toolbar) nor caught by a recording stop.
recording_gsr_pids() {
  command -v pgrep >/dev/null 2>&1 || return 0
  local p cl
  for p in $(pgrep -f "$gsr_pattern" 2>/dev/null || true); do
    cl=" $(tr '\0' ' ' <"/proc/$p/cmdline" 2>/dev/null || true) "
    case "$cl" in *" -r "*) continue ;; esac
    printf '%s\n' "$p"
  done
}

proc_running() {
  local pattern="$1"

  if command -v pgrep >/dev/null 2>&1; then
    pgrep -f "$pattern" >/dev/null 2>&1
    return
  fi

  if command -v pidof >/dev/null 2>&1; then
    case "$pattern" in
    *gpu-screen-recorder*) pidof gpu-screen-recorder >/dev/null 2>&1; return ;;
    *wf-recorder*) pidof wf-recorder >/dev/null 2>&1; return ;;
    esac
  fi

  return 1
}

recorder_running() {
  [[ -n "$(recording_gsr_pids)" ]] || proc_running "$wf_pattern"
}

# A live (video) wallpaper can render two ways: through the C player
# (ryogami-live, pre-rename ryoku-livewall) on a background layer that is not on
# the KMS scanout gsr captures, or in-shell inside the wallpaper surface. The C
# player defeats gsr's grab, so switch to wf-recorder, which grabs the
# composited output (livewall included). Match both names: a box mid-rename
# still runs the old binary.
live_wallpaper_active() {
  command -v pgrep >/dev/null 2>&1 || return 1
  pgrep -x ryogami-live >/dev/null 2>&1 || pgrep -x ryoku-livewall >/dev/null 2>&1
}

# which backend owns the live recording right now, if any.
running_backend() {
  if [[ -n "$(recording_gsr_pids)" ]]; then
    printf 'gsr'
  elif proc_running "$wf_pattern"; then
    printf 'wf'
  fi
}

signal_recorder() {
  local signal="$1"
  local pattern="$2"

  require_command pkill pkill
  pkill "$signal" -f "$pattern" >/dev/null 2>&1 || true
}

# must match Ryoku.Ui.Singletons.Paths.recordingsDir, which the deck's recordings
# list and the Hub's Recording page both read: the env override, then the Hub's
# `directory` setting, then ${XDG_VIDEOS_DIR:-$HOME/Videos}/Recordings. the list
# watches that one dir, so any other resolution (e.g. `xdg-user-dir VIDEOS`,
# which returns $HOME when there's no Videos dir) would hide every saved
# recording.
recordings_dir() {
  local configured
  if [[ -n ${RYOKU_SHELL_RECORDINGS_DIR:-} ]]; then
    printf '%s\n' "$RYOKU_SHELL_RECORDINGS_DIR"
    return
  fi

  configured="$(cfg_get '.directory' '')"
  if [[ -n $configured ]]; then
    printf '%s\n' "${configured/#\~/$HOME}"
    return
  fi

  printf '%s/Recordings\n' "${XDG_VIDEOS_DIR:-$HOME/Videos}"
}

next_recording_path() {
  local dir="$1"
  local name_format="${RYOKU_SCREENRECORD_NAME_FORMAT:-recording_%Y-%m-%d_%H.%M.%S}"
  local name
  local path
  local suffix=1

  name="$(date +"$name_format")"
  name="${name//\//-}"
  name="${name//$'\n'/-}"
  path="$dir/$name.mp4"

  while [[ -e $path ]]; do
    path="$dir/$name-$suffix.mp4"
    ((suffix++))
  done

  printf '%s\n' "$path"
}

# ground truth: can gpu-screen-recorder list a real monitor with the card it
# auto-picks? on multi-GPU boxes where the display lives on a different card
# than the render GPU this is false and we have to use wf-recorder. probe is
# time-boxed because gsr's DRM enum can hang on exactly those machines.
gsr_capture_probe() {
  local cmd="${RYOKU_SCREENRECORD_RECORDER:-gpu-screen-recorder}"
  local out

  command -v "$cmd" >/dev/null 2>&1 || return 1

  if command -v timeout >/dev/null 2>&1; then
    out="$(timeout -k 2 4 "$cmd" --list-capture-options 2>/dev/null || true)"
  else
    out="$("$cmd" --list-capture-options 2>/dev/null || true)"
  fi

  # a real DRM monitor output looks like "eDP-2|1920x1080"; gsr ALSO lists v4l2
  # webcams ("/dev/video0|1920x1080@30hz|mjpeg") and "portal". Only a monitor
  # connector (a name not starting with "/", with a WxH) means KMS capture can
  # work -- otherwise a box that can't enumerate a monitor gets stuck launching a
  # doomed gsr -w screen. Exclude device paths so a webcam never counts.
  printf '%s' "$out" | grep -Eq '^[^/|[:space:]][^|[:space:]]*\|[0-9]+x[0-9]+'
}

# cheap stable fingerprint of GPU/monitor topology. changes when a card or a
# connected output changes, which is exactly when the backend choice may need
# to flip.
gpu_topology_signature() {
  {
    # bump this tag when the selection logic changes, so a stale cached verdict
    # (e.g. a "gsr" written by the old webcam-fooled probe, or a "wf" stranded
    # by a portal that only stalled while the picker waited on a person) is
    # dropped and re-run.
    printf 'recorder-select-v3\n'
    printf '%s\n' /dev/dri/card*
    cat /sys/class/drm/card*/status 2>/dev/null
  } 2>/dev/null | md5sum 2>/dev/null | cut -d' ' -f1
}

backend_cache_file() {
  printf '%s/screenrecord-backend' "${RYOKU_STATE_PATH:-$HOME/.local/state/ryoku}"
}

# persist the chosen backend for the current GPU/monitor topology so the next
# capture skips the probe. A run-time fallback must not strand a box: call this
# only for a considered choice, and forget_backend for an ambiguous failure.
remember_backend() {
  local chosen="$1" cache sig
  case "$chosen" in gsr | portal | wf) ;; *) return 0 ;; esac
  cache="$(backend_cache_file)"
  sig="$(gpu_topology_signature)"
  [[ -n $sig ]] || return 0
  mkdir -p "$(dirname "$cache")" 2>/dev/null || true
  printf '%s\t%s\n' "$sig" "$chosen" >"$cache" 2>/dev/null || true
}

# drop a cached backend so the next capture re-probes from scratch. used when a
# recording fell through for a reason that says nothing about the machine (the
# portal picker timed out because nobody answered it, e.g.): caching "wf" for
# that strands a box on CPU encoding until the GPU topology changes.
forget_backend() {
  rm -f "$(backend_cache_file)" 2>/dev/null || true
}

select_backend() {
  local backend="${RYOKU_SCREENRECORD_BACKEND:-auto}"

  case "$backend" in
  gsr|wf|portal)
    printf '%s' "$backend"
    return 0
    ;;
  esac

  # reuse the last probed backend while the topology hasn't changed, so the
  # (potentially slow) gsr probe runs at most once per layout.
  local cache sig cached_sig cached_backend chosen
  cache="$(backend_cache_file)"
  sig="$(gpu_topology_signature)"
  if [[ -n $sig && -r $cache ]]; then
    IFS=$'\t' read -r cached_sig cached_backend <"$cache" 2>/dev/null || true
    if [[ $cached_sig == "$sig" && ($cached_backend == "gsr" || $cached_backend == "portal" || $cached_backend == "wf") ]]; then
      printf '%s' "$cached_backend"
      return 0
    fi
  fi

  # gsr's KMS capture (-w screen) is the default: no picker, best quality. When it
  # can't enumerate a monitor (a hybrid box whose display is on a card gsr does
  # not target) fall to gsr's portal capture (PipeWire + GPU encode, works no
  # matter which card scans out), and only to wf-recorder if gsr is absent.
  if gsr_capture_probe; then
    chosen="gsr"
  elif command -v "${RYOKU_SCREENRECORD_RECORDER:-gpu-screen-recorder}" >/dev/null 2>&1; then
    chosen="portal"
  elif command -v "${RYOKU_SCREENRECORD_WF:-wf-recorder}" >/dev/null 2>&1; then
    chosen="wf"
  else
    chosen="gsr"
  fi

  remember_backend "$chosen"

  printf '%s' "$chosen"
}

# slurp geometry as "WxH+X+Y" for gpu-screen-recorder. empty = cancelled.
region_geometry_gsr() {
  local slurp_cmd="${RYOKU_SCREENRECORD_SLURP:-slurp}"
  local region_pick="${RYOKU_STATE_PATH:-$HOME/.local/state/ryoku}/region-pick"
  local geometry pos size x y

  # geometry sources in order: an explicit --geometry, the box the island's region
  # picker drew (a state file we consume so it is never reused stale), else slurp.
  if [[ -n ${region_geom_override:-} ]]; then
    geometry="$region_geom_override"
  elif [[ -s $region_pick ]]; then
    geometry="$(tr -d '[:space:]' < "$region_pick" 2>/dev/null || true)"
    rm -f "$region_pick" 2>/dev/null || true
  fi

  if [[ -z ${geometry:-} ]]; then
    require_command "$slurp_cmd" slurp
    geometry="$("$slurp_cmd" -f "%wx%h+%x+%y" 2>/dev/null || true)"
    [[ -n $geometry ]] || return 0

    if [[ $geometry == *" "* ]]; then
      pos="${geometry%% *}"
      size="${geometry#* }"
      x="${pos%,*}"
      y="${pos#*,}"
      geometry="${size}+${x}+${y}"
    fi
  fi

  if [[ ! $geometry =~ ^[0-9]+x[0-9]+[+-][0-9]+[+-][0-9]+$ ]]; then
    notify -u critical "Screen recording failed" "Invalid region: $geometry"
    echo "ryoku-cmd-screenrecord: invalid region: $geometry" >&2
    exit 1
  fi

  printf '%s' "$geometry"
}

# slurp's native "X,Y WxH" for wf-recorder -g. empty = cancelled.
region_geometry_wf() {
  local slurp_cmd="${RYOKU_SCREENRECORD_SLURP:-slurp}"
  local region_pick="${RYOKU_STATE_PATH:-$HOME/.local/state/ryoku}/region-pick"
  local geometry gsr_geom

  # island-provided region (WxH+X+Y, via --geometry or the picker file) ->
  # wf-recorder's "X,Y WxH".
  gsr_geom="${region_geom_override:-}"
  if [[ -z $gsr_geom && -s $region_pick ]]; then
    gsr_geom="$(tr -d '[:space:]' < "$region_pick" 2>/dev/null || true)"
    rm -f "$region_pick" 2>/dev/null || true
  fi
  if [[ -n $gsr_geom && $gsr_geom =~ ^([0-9]+)x([0-9]+)[+]([0-9]+)[+]([0-9]+)$ ]]; then
    printf '%s,%s %sx%s' "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
    return
  fi

  require_command "$slurp_cmd" slurp
  geometry="$("$slurp_cmd" 2>/dev/null || true)"
  printf '%s' "$geometry"
}

# Focused output name from the seam's output state, to target wf-recorder. Empty
# when it cannot be resolved (wf-recorder then records the only/default output),
# which is also the honest result on a compositor whose outputs we cannot read.
focused_output() {
  command -v ryoku-hub >/dev/null 2>&1 || return 0
  command -v jq >/dev/null 2>&1 || return 0
  ryoku-hub outputs 2>/dev/null \
    | jq -r 'first(.[] | select(.focused)) // .[0] // {} | .name // empty' 2>/dev/null
}

# a --monitor value reaches a backend's -w/-o flag, so gate it the same way a
# region geometry is gated: a Hyprland connector name is letters, digits, dot and
# dash only. reuse the notify-and-exit idiom on a bad value.
validate_monitor_name() {
  local name="$1"
  if [[ -z $name || ! $name =~ ^[A-Za-z0-9._-]+$ ]]; then
    notify -u critical "Screen recording failed" "Invalid monitor: $name"
    echo "ryoku-cmd-screenrecord: invalid monitor: $name" >&2
    exit 1
  fi
}

default_sink_monitor() {
  command -v pactl >/dev/null 2>&1 || return 0
  local sink
  sink="$(pactl get-default-sink 2>/dev/null || true)"
  [[ -n $sink ]] && printf '%s.monitor' "$sink"
}

default_source_name() {
  command -v pactl >/dev/null 2>&1 || return 0
  pactl get-default-source 2>/dev/null || true
}

# render node (/dev/dri/renderD*) sharing a PCI addr with the given card
# device (a real card or a ryoku-gpu-* symlink).
render_node_for_card() {
  local ref="$1"
  local card name pci node

  card="$(readlink -f "$ref" 2>/dev/null || true)"
  name="${card##*/}"
  [[ $name == card* ]] || return 1

  pci="$(readlink -f "/sys/class/drm/$name/device" 2>/dev/null || true)"
  pci="${pci##*/}"
  [[ -n $pci ]] || return 1

  node="/dev/dri/by-path/pci-${pci}-render"
  [[ -e $node ]] || return 1
  readlink -f "$node"
}

# pick the render node for wf-recorder's VAAPI encoder: explicit override, the
# primary GPU pinned by ryoku-gpu (AQ_DRM_DEVICES), else the card that actually
# drives a connected display, else the first render node.
#
# The display-owning card matters on a hybrid laptop: the compositor scans out
# from the card wired to the panel, and VAAPI has to encode frames produced
# there. Picking the bare first render node grabs the discrete GPU on an AMD-
# iGPU laptop, whose VA driver cannot ingest the AMD compositor's buffers, the
# hw encode dies inside its probe window, and every recording silently drops to
# CPU libx264.
wf_vaapi_node() {
  if [[ -n ${RYOKU_SCREENRECORD_WF_DEVICE:-} ]]; then
    printf '%s' "$RYOKU_SCREENRECORD_WF_DEVICE"
    return 0
  fi

  local first node n conn
  if [[ -n ${AQ_DRM_DEVICES:-} ]]; then
    first="${AQ_DRM_DEVICES%%:*}"
    if node="$(render_node_for_card "$first")"; then
      printf '%s' "$node"
      return 0
    fi
  fi

  for conn in /sys/class/drm/card*-*; do
    [[ "$(cat "$conn/status" 2>/dev/null)" == connected ]] || continue
    [[ ${conn##*/} == *Writeback* ]] && continue
    if node="$(render_node_for_card "${conn%%-*}")"; then
      printf '%s' "$node"
      return 0
    fi
  done

  for n in /dev/dri/renderD*; do
    [[ -e $n ]] || continue
    printf '%s' "$n"
    return 0
  done

  return 1
}

stop_recording() {
  # an array, not a bare word split: the pid list is deliberately several pids,
  # and quoting the string would pass them to kill as one argument.
  local -a pids
  mapfile -t pids < <(recording_gsr_pids | tr ' ' '\n' | grep -E '^[0-9]+$' || true)
  if [[ ${#pids[@]} -eq 0 ]] && ! proc_running "$wf_pattern"; then
    notify -u normal "Screen recording" "No active recording found"
    return 0
  fi

  # scope the stop to recording processes: a background replay buffer must survive.
  [[ ${#pids[@]} -gt 0 ]] && kill -INT "${pids[@]}" >/dev/null 2>&1 || true
  proc_running "$wf_pattern" && signal_recorder -INT "$wf_pattern" || true
  # no message here: the file is not written yet, so the old "Saving recording..."
  # was a promise made before the fact. The post-save hook (gsr -sc, or the wf path
  # calling it directly) fires the honest "Recording saved" once the file exists.

  # A hung recorder (a portal session that never came up) ignores SIGINT: give it
  # a short grace, then force-kill any survivor so --stop always clears the capture
  # instead of stranding the island on a zombie gsr.
  for _ in $(seq 20); do recorder_running || break; sleep 0.1; done
  if recorder_running; then
    mapfile -t pids < <(recording_gsr_pids | tr ' ' '\n' | grep -E '^[0-9]+$' || true)
    [[ ${#pids[@]} -gt 0 ]] && kill -KILL "${pids[@]}" >/dev/null 2>&1 || true
    proc_running "$wf_pattern" && signal_recorder -KILL "$wf_pattern" || true
  fi

  # gsr's KMS capture leaves the screen washed out until a reconfigure (#11284);
  # a config reload triggers one. A compositor that cannot reload its config live
  # is unaffected and needs none.
  if wm_can configReload; then
    "$ryoku_bin" wm act config.reload >/dev/null 2>&1 || true
  fi
}

pause_recording() {
  local -a pids
  mapfile -t pids < <(recording_gsr_pids | tr ' ' '\n' | grep -E '^[0-9]+$' || true)
  if [[ ${#pids[@]} -gt 0 ]]; then
    kill -USR2 "${pids[@]}" >/dev/null 2>&1 || true
  elif proc_running "$wf_pattern"; then
    notify -u normal "Screen recording" "Pause isn't available while recording with wf-recorder"
  else
    notify -u normal "Screen recording" "No active recording found"
  fi
}

status_recording() {
  if recorder_running; then
    echo "recording"
  else
    echo "idle"
  fi
}

# vendor id of the GPU driving the focused output, for the encoder label.
focused_gpu_vendor() {
  local out conn cardnum
  out="$(focused_output)"
  [[ -n $out ]] || return 0
  for conn in /sys/class/drm/card*-"$out"; do
    [[ -e $conn ]] || continue
    cardnum="$(basename "$conn")"
    cardnum="${cardnum%%-*}"
    cat "/sys/class/drm/$cardnum/device/vendor" 2>/dev/null && return 0
  done
}

encoder_label() {
  local backend="$1" encoder="$2" vendor
  if [[ $encoder == cpu ]]; then printf 'CPU (libx264)'; return 0; fi
  vendor="$(focused_gpu_vendor)"
  case "$vendor" in
  0x10de) printf 'NVIDIA NVENC' ;;
  0x1002) printf 'AMD VAAPI' ;;
  0x8086) printf 'Intel QSV' ;;
  *) if [[ $backend == wf ]]; then printf 'VAAPI'; else printf 'GPU (hardware)'; fi ;;
  esac
}

# machine-readable summary for the Hub's Recording page: which backend + encoder
# will run, and the resolved settings.
info_recording() {
  local backend fps quality codec fmode encoder enc
  backend="$(select_backend)"
  fps="${RYOKU_SCREENRECORD_FPS:-$(cfg_get '.fps' 60)}"
  quality="${RYOKU_SCREENRECORD_QUALITY:-$(cfg_get '.quality' very_high)}"
  codec="${RYOKU_SCREENRECORD_CODEC:-$(cfg_get '.codec' h264)}"
  fmode="${RYOKU_SCREENRECORD_FRAMERATE_MODE:-$(cfg_get '.framerateMode' cfr)}"
  encoder="${RYOKU_SCREENRECORD_ENCODER:-$(cfg_get '.encoder' gpu)}"
  enc="$(encoder_label "$backend" "$encoder")"
  printf '{"backend":"%s","encoder":"%s","fps":"%s","quality":"%s","codec":"%s","framerateMode":"%s"}\n' \
    "$backend" "$enc" "$fps" "$quality" "$codec" "$fmode"
}

# absolute path to the post-save hook gpu-screen-recorder runs via -sc (a sibling
# script, resolved the way ryoku-cmd-studiorecord resolves this one). empty when
# the helper is missing or not executable, so we never hand gsr a -sc it can't
# run and never call a phantom helper on the wf path.
recording_saved_hook() {
  local here hook
  here="$(dirname "$(readlink -f "$0")")"
  hook="$here/ryoku-cmd-recording-saved"
  [[ -x $hook ]] && printf '%s' "$hook"
}

# wf-recorder has no gsr-style -sc, so after it finishes we hand the saved file
# to the hook ourselves, detached: this wrapper (which the shell waits on) exits
# at once instead of lingering for the notification's bounded action wait.
spawn_saved_hook() {
  local path="$1" hook
  [[ -s $path ]] || return 0
  hook="$(recording_saved_hook || true)"
  [[ -n $hook ]] || return 0
  setsid "$hook" "$path" regular >/dev/null 2>&1 </dev/null &
}

start_gsr() {
  local mode="$1"
  local desktop_audio="$2"
  local microphone_audio="$3"
  local recorder_cmd="${RYOKU_SCREENRECORD_RECORDER:-gpu-screen-recorder}"
  local fps fmode quality codec encoder cursor
  local capture="screen"
  local region_geom=""
  local audio_source=""
  local output_dir
  local output_path
  local args

  fps="${RYOKU_SCREENRECORD_FPS:-$(cfg_get '.fps' 60)}"
  fmode="${RYOKU_SCREENRECORD_FRAMERATE_MODE:-$(cfg_get '.framerateMode' cfr)}"
  quality="${RYOKU_SCREENRECORD_QUALITY:-$(cfg_get '.quality' very_high)}"
  codec="${RYOKU_SCREENRECORD_CODEC:-$(cfg_get '.codec' h264)}"
  encoder="${RYOKU_SCREENRECORD_ENCODER:-$(cfg_get '.encoder' gpu)}"
  cursor="$(cfg_bool '.cursor' true)"

  require_command "$recorder_cmd" gpu-screen-recorder

  if [[ $mode == "region" ]]; then
    region_geom="$(region_geometry_gsr)"
    [[ -n $region_geom ]] || exit 0
    capture="region"
  elif [[ $mode == "monitor" ]]; then
    # -w <NAME> records exactly that KMS connector.
    capture="$monitor_name"
  else
    # man gpu-screen-recorder: -w screen records the FIRST monitor gsr enumerates,
    # not the focused one; the wf path already targets the focused output (-o), so
    # the two backends recorded different screens on a multi-monitor desk. Target
    # the focused output by name, falling back to `screen` when it can't be named.
    local focused
    focused="$(focused_output)"
    [[ -n $focused ]] && capture="$focused"
  fi

  if [[ $desktop_audio == "true" && $microphone_audio == "true" ]]; then
    audio_source="default_output|default_input"
  elif [[ $desktop_audio == "true" ]]; then
    audio_source="default_output"
  elif [[ $microphone_audio == "true" ]]; then
    audio_source="default_input"
  fi

  output_dir="$(recordings_dir)"
  mkdir -p "$output_dir"
  output_path="$(next_recording_path "$output_dir")"
  # record the output path so the studio flow (ryoku-cmd-studiorecord) can find
  # the finished clip to write its cursor sidecar and hand to the editor.
  mkdir -p "${RYOKU_STATE_PATH:-$HOME/.local/state/ryoku}" 2>/dev/null || true
  printf '%s\n' "$output_path" >"${RYOKU_STATE_PATH:-$HOME/.local/state/ryoku}/last-recording" 2>/dev/null || true

  # -fm cfr: a steady framerate every player and editor reads correctly (vfr
  # often imports as ~30fps and looks choppy). -q/-k/-encoder come from the
  # Hub's Recording page (recording.json); env vars override.

  args=("$recorder_cmd" -w "$capture" -f "$fps" -fm "$fmode" -q "$quality" -k "$codec" -encoder "$encoder" -c mp4 -cursor "$cursor")
  [[ $capture == "region" ]] && args+=(-region "$region_geom")
  [[ -n $audio_source ]] && args+=(-a "$audio_source")
  # -sc: gsr runs this after it finishes writing the file, where the honest saved
  # notification (real path, size and duration) belongs; only passed when present.
  local saved_hook
  saved_hook="$(recording_saved_hook || true)"
  [[ -n $saved_hook ]] && args+=(-sc "$saved_hook")
  args+=(-o "$output_path")

  exec "${args[@]}"
}

# gsr portal capture: records through xdg-desktop-portal / PipeWire ScreenCast
# instead of KMS, so it works on hybrid boxes where -w screen finds no monitor.
# gsr still GPU-encodes (NVENC / VAAPI). The first run shows the portal source
# picker once; -restore-portal-session reuses the grant after that. Some hybrid
# boxes' xdph cannot negotiate a DMA-BUF format and the capture comes up empty --
# if portal never yields frames (dies, or stalls alive empty), fall back to wf.
start_portal() {
  local mode="$1"
  local desktop_audio="$2"
  local microphone_audio="$3"
  local recorder_cmd="${RYOKU_SCREENRECORD_RECORDER:-gpu-screen-recorder}"
  local fps fmode quality codec encoder cursor pick_each_time
  local audio_source=""
  local output_dir output_path pid token ticks i
  local -a args

  fps="${RYOKU_SCREENRECORD_FPS:-$(cfg_get '.fps' 60)}"
  fmode="${RYOKU_SCREENRECORD_FRAMERATE_MODE:-$(cfg_get '.framerateMode' cfr)}"
  quality="${RYOKU_SCREENRECORD_QUALITY:-$(cfg_get '.quality' very_high)}"
  codec="${RYOKU_SCREENRECORD_CODEC:-$(cfg_get '.codec' h264)}"
  encoder="${RYOKU_SCREENRECORD_ENCODER:-$(cfg_get '.encoder' gpu)}"
  cursor="$(cfg_bool '.cursor' true)"
  # The portal caches the chosen source in a restore token and gsr reuses it
  # silently, so after the first recording every later one captures whatever
  # screen was picked then -- black or empty once that monitor is gone. Asking
  # each time is the user's call: recording.json pickEachTime, or the env.
  pick_each_time="${RYOKU_SCREENRECORD_PICK:-}"
  [[ -n $pick_each_time ]] || pick_each_time="$(cfg_bool '.pickEachTime' false)"

  require_command "$recorder_cmd" gpu-screen-recorder

  if [[ $desktop_audio == "true" && $microphone_audio == "true" ]]; then
    audio_source="default_output|default_input"
  elif [[ $desktop_audio == "true" ]]; then
    audio_source="default_output"
  elif [[ $microphone_audio == "true" ]]; then
    audio_source="default_input"
  fi

  output_dir="$(recordings_dir)"
  mkdir -p "$output_dir"
  output_path="$(next_recording_path "$output_dir")"
  mkdir -p "${RYOKU_STATE_PATH:-$HOME/.local/state/ryoku}" 2>/dev/null || true
  printf '%s\n' "$output_path" >"${RYOKU_STATE_PATH:-$HOME/.local/state/ryoku}/last-recording" 2>/dev/null || true

  token="${XDG_CONFIG_HOME:-$HOME/.config}/gpu-screen-recorder/restore_token"
  args=("$recorder_cmd" -w portal)
  if [[ $pick_each_time == yes ]]; then
    rm -f "$token"
  else
    args+=(-restore-portal-session yes)
  fi
  args+=(-f "$fps" -fm "$fmode" -q "$quality" -k "$codec" -encoder "$encoder" -c mp4 -cursor "$cursor")
  [[ -n $audio_source ]] && args+=(-a "$audio_source")
  # portal picks its own PipeWire source, so there is no monitor to name here (a
  # --monitor request degrades to region/fullscreen upstream); -sc still fires the
  # saved notification after gsr writes the file, exactly as on the KMS path.
  local saved_hook
  saved_hook="$(recording_saved_hook || true)"
  [[ -n $saved_hook ]] && args+=(-sc "$saved_hook")
  args+=(-o "$output_path")

  "${args[@]}" &
  pid=$!

  # A stalled portal negotiation leaves gsr alive but capturing nothing (empty
  # file) and deaf to SIGINT/SIGTERM, so commit on real frames landing, not on
  # liveness. A restored grant means the picker is already answered, so commit
  # sooner; being asked to choose needs the longer window.
  if [[ -s $token ]]; then ticks=10; else ticks=40; fi
  for ((i = 0; i < ticks; i++)); do
    [[ -s $output_path ]] && { wait "$pid" 2>/dev/null || true; exit 0; }
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.5
  done
  [[ -s $output_path ]] && { wait "$pid" 2>/dev/null || true; exit 0; }

  # Nothing captured: SIGKILL the signal-deaf gsr and record through wf for
  # this run. Do not cache the demotion: the common stall cause is a portal
  # with no ScreenCast implementation (a missing backend package) or a grant
  # that went stale, both of which the next run can recover from. Pinning wf
  # here once stranded a hybrid laptop on CPU x264 encoding permanently, which
  # is the difference between a smooth desktop and a stuttering one while
  # recording.
  kill -KILL "$pid" 2>/dev/null || true
  for ((i = 0; i < 20; i++)); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
  rm -f "$output_path"
  output_path="$(next_recording_path "$output_dir")"
  printf '%s\n' "$output_path" >"${RYOKU_STATE_PATH:-$HOME/.local/state/ryoku}/last-recording" 2>/dev/null || true
  start_wf "$mode" "$desktop_audio" "$microphone_audio"
}

start_wf() {
  local mode="$1"
  local desktop_audio="$2"
  local microphone_audio="$3"
  local wf_cmd="${RYOKU_SCREENRECORD_WF:-wf-recorder}"
  local fps quality qp crf
  local geom monitor audio_dev node output_dir output_path pid status
  local target_args=()
  local audio_args=()

  fps="${RYOKU_SCREENRECORD_FPS:-$(cfg_get '.fps' 60)}"
  quality="${RYOKU_SCREENRECORD_QUALITY:-$(cfg_get '.quality' very_high)}"

  require_command "$wf_cmd" wf-recorder

  if [[ $mode == "region" ]]; then
    geom="$(region_geometry_wf)"
    [[ -n $geom ]] || exit 0
    target_args+=(-g "$geom")
  elif [[ $mode == "monitor" ]]; then
    # -o <NAME> targets that exact output; wf-recorder has no X11-style window id.
    target_args+=(-o "$monitor_name")
  else
    monitor="$(focused_output)"
    [[ -n $monitor ]] && target_args+=(-o "$monitor")
  fi

  if [[ $desktop_audio == "true" ]]; then
    audio_dev="$(default_sink_monitor)"
  elif [[ $microphone_audio == "true" ]]; then
    audio_dev="$(default_source_name)"
  fi
  if [[ $desktop_audio == "true" || $microphone_audio == "true" ]]; then
    if [[ -n ${audio_dev:-} ]]; then
      audio_args+=(--audio="$audio_dev")
    else
      audio_args+=(--audio)
    fi
  fi

  output_dir="$(recordings_dir)"
  mkdir -p "$output_dir"
  output_path="$(next_recording_path "$output_dir")"
  mkdir -p "${RYOKU_STATE_PATH:-$HOME/.local/state/ryoku}" 2>/dev/null || true
  printf '%s\n' "$output_path" >"${RYOKU_STATE_PATH:-$HOME/.local/state/ryoku}/last-recording" 2>/dev/null || true

  # quality preset -> VAAPI qp / x264 crf (lower = crisper).
  case "$quality" in
  ultra) qp=16; crf=17 ;;
  very_high) qp=20; crf=20 ;;
  high) qp=24; crf=23 ;;
  *) qp=28; crf=28 ;;
  esac

  # explicit codec: skip hw/sw negotiation entirely. run (not exec) so we can hand
  # the finished file to the saved hook, which wf-recorder can't do itself.
  if [[ -n ${RYOKU_SCREENRECORD_WF_CODEC:-} ]]; then
    "$wf_cmd" -r "$fps" "${target_args[@]}" "${audio_args[@]}" \
      -c "$RYOKU_SCREENRECORD_WF_CODEC" -f "$output_path" && status=0 || status=$?
    spawn_saved_hook "$output_path"
    exit "$status"
  fi

  # try VAAPI on the primary render node first. if the hw encoder can't be set
  # up (e.g. the captured buffer lives on a GPU whose VAAPI can't ingest it),
  # fall back to libx264 so we always produce a file.
  node="$(wf_vaapi_node || true)"
  if [[ -n ${node:-} ]]; then
    "$wf_cmd" -r "$fps" "${target_args[@]}" "${audio_args[@]}" \
      -c h264_vaapi -d "$node" -p qp="$qp" -F "scale_vaapi=format=nv12" -f "$output_path" &
    pid=$!
    sleep 1.5
    if kill -0 "$pid" 2>/dev/null; then
      wait "$pid" && status=0 || status=$?
      spawn_saved_hook "$output_path"
      exit "$status"
    fi
    wait "$pid" 2>/dev/null && status=0 || status=$?
    # hw encode produced something? the user just stopped it early.
    if [[ -s $output_path ]]; then
      spawn_saved_hook "$output_path"
      exit "${status:-0}"
    fi
    rm -f "$output_path"
    output_path="$(next_recording_path "$output_dir")"
    printf '%s\n' "$output_path" >"${RYOKU_STATE_PATH:-$HOME/.local/state/ryoku}/last-recording" 2>/dev/null || true
  fi

  "$wf_cmd" -r "$fps" "${target_args[@]}" "${audio_args[@]}" \
    -c libx264 -p preset=veryfast -p crf="$crf" -f "$output_path" && status=0 || status=$?
  spawn_saved_hook "$output_path"
  exit "$status"
}

start_recording() {
  local mode="$1"
  local desktop_audio="$2"
  local microphone_audio="$3"
  local backend

  if recorder_running; then
    notify -u normal "Screen recording" "A recording is already running"
    return 0
  fi

  [[ $mode == "monitor" ]] && validate_monitor_name "$monitor_name"

  backend="$(select_backend)"
  # portal capture picks its own PipeWire source and cannot target a named
  # monitor, so a --monitor request degrades to a region grab of the monitor's
  # rect (the caller passes it as --geometry); with no geometry, fall through to a
  # plain portal capture rather than failing. A resulting region then follows the
  # portal-can't-crop rule below and records through wf.
  if [[ $mode == "monitor" && $backend == "portal" ]]; then
    if [[ -n ${region_geom_override:-} ]]; then
      mode="region"
    else
      mode="fullscreen"
    fi
  fi
  # gsr's KMS capture (-w screen) omits a live wallpaper's video plane (it renders
  # on a layer off the scanout gsr grabs), so with a livewall up swap to wf, which
  # records the composited output. portal capture already composites (livewall
  # included), so it is left as-is.
  if [[ $mode != "region" ]] && [[ $backend == "gsr" ]] && live_wallpaper_active; then
    backend="wf"
  fi
  # portal can't crop to a drawn region; wf-recorder's -g does, so a region grab
  # that would use portal records through wf instead.
  if [[ $backend == "portal" && $mode == "region" ]]; then
    backend="wf"
  fi
  case "$backend" in
  wf)
    start_wf "$mode" "$desktop_audio" "$microphone_audio"
    ;;
  portal)
    start_portal "$mode" "$desktop_audio" "$microphone_audio"
    ;;
  *)
    start_gsr "$mode" "$desktop_audio" "$microphone_audio"
    ;;
  esac
}

action="auto"
mode="fullscreen"
desktop_audio=false
microphone_audio=false
region_geom_override=""
monitor_name=""

while (($# > 0)); do
  case "$1" in
  --fullscreen)
    mode="fullscreen"
    action="start"
    ;;
  --region|-r)
    mode="region"
    action="start"
    ;;
  -s)
    mode="fullscreen"
    desktop_audio=true
    action="start"
    ;;
  -sr|-rs)
    mode="region"
    desktop_audio=true
    action="start"
    ;;
  --with-desktop-audio)
    desktop_audio=true
    action="start"
    ;;
  --with-microphone-audio)
    microphone_audio=true
    action="start"
    ;;
  --stop|stop)
    action="stop"
    ;;
  --pause|-p|pause)
    action="pause"
    ;;
  --status|status)
    action="status"
    ;;
  --info|info)
    action="info"
    ;;
  --help|-h|help)
    usage
    exit 0
    ;;
  --geometry)
    shift
    region_geom_override="${1:-}"
    ;;
  --monitor)
    shift
    monitor_name="${1:-}"
    mode="monitor"
    action="start"
    ;;
  *)
    echo "ryoku-cmd-screenrecord: unknown argument: $1" >&2
    usage >&2
    exit 2
    ;;
  esac
  shift
done

if [[ $action == "auto" ]]; then
  if recorder_running; then
    action="stop"
  else
    action="start"
  fi
fi

case "$action" in
start)
  start_recording "$mode" "$desktop_audio" "$microphone_audio"
  ;;
stop)
  stop_recording
  ;;
pause)
  pause_recording
  ;;
status)
  status_recording
  ;;
info)
  info_recording
  ;;
esac
