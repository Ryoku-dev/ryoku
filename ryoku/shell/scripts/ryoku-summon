#!/usr/bin/env bash
# Summon a single-instance window to the current workspace and focus it; launch
# it if it is not running yet.
#   ryoku-summon <window-title> <launch command...>
#   ryoku-summon --app-id <app-id> <launch command...>
#
# Quickshell surfaces share one app id and use their title. Native applications
# should use their stable app id. The window manager is reached only through the
# neutral seam; a missing match falls through to the launch command.
set -uo pipefail

selector="${1:?window selector required}"; shift
if [[ $selector == --app-id ]]; then
	app_id="${1:?app id required}"; shift
	selector="app-id:$app_id"
else
	selector="title:$selector"
fi
[ "$#" -gt 0 ] || { echo "ryoku-summon: launch command required" >&2; exit 2; }

# The window manager is reached only through the seam, never by name.
ryoku_bin="${RYOKU_BIN-$(command -v ryoku || true)}"

# A live matching window is raised and focused through the seam.
if [[ -n $ryoku_bin && -x $ryoku_bin ]]; then
	"$ryoku_bin" wm act window.summon "$selector" >/dev/null 2>&1 && exit 0
fi

exec "$@"
