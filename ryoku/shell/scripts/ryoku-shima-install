#!/usr/bin/env python3
import argparse
import fcntl
import hashlib
import json
import os
import posixpath
from pathlib import Path
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.request


def sha256_file(path):
    with path.open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def overlay_dir():
    configured = os.environ.get("RYOKU_SHIMA_PATCH_DIR")
    if configured:
        return Path(configured)
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    return config_home / "quickshell" / "shima-overlay"


def data_root():
    home = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
    return home / "ryoku" / "shima"


def load_metadata():
    directory = overlay_dir()
    meta = json.loads((directory / "upstream.json").read_text())
    if sha256_file(directory / "runtime.patch") != meta["patch_sha256"]:
        raise RuntimeError("Shima integration patch does not match its pinned digest")
    if sha256_file(directory / "shima-overview-terminal.patch") != meta["overview_patch_sha256"]:
        raise RuntimeError("Shima overview patch does not match its pinned digest")
    paths = (directory / "runtime-files.txt").read_text().splitlines()
    if len(paths) != len(set(paths)) or len(paths) != 2403:
        raise RuntimeError("Shima runtime file list is incomplete or duplicated")
    for name in paths:
        path = Path(name)
        if path.is_absolute() or ".." in path.parts or not name or name.endswith(".service"):
            raise RuntimeError(f"Unexpected upstream runtime path: {name}")
    return directory, meta, set(paths)


def runtime_digest(root):
    result = hashlib.sha256()
    files = sorted(
        str(path.relative_to(root))
        for path in root.rglob("*")
        if path.is_file() and path.name != "runtime.json"
    )
    for rel in files:
        path = root / rel
        if path.is_symlink():
            raise RuntimeError(f"Symlink inside Shima runtime: {rel}")
        result.update(rel.encode() + b"\x00" + bytes.fromhex(sha256_file(path)))
    return result.hexdigest(), len(files)


def verified_generation(root, meta):
    if not root.is_dir() or root.is_symlink():
        return False
    try:
        info = json.loads((root / "runtime.json").read_text())
        if info["archive_sha256"] != meta["archive_sha256"]:
            return False
        if info["patch_sha256"] != meta["patch_sha256"]:
            return False
        if info["overview_patch_sha256"] != meta["overview_patch_sha256"]:
            return False
        digest, count = runtime_digest(root)
        return digest == meta["runtime_sha256"] and count == meta["runtime_files"]
    except (OSError, ValueError, KeyError, RuntimeError):
        return False


def ensure_archive(meta, archive_arg):
    if archive_arg:
        archive = Path(archive_arg)
        if not archive.is_file() or sha256_file(archive) != meta["archive_sha256"]:
            raise RuntimeError("The supplied iNiR archive has an unexpected SHA-256 digest")
        return archive

    cache_home = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
    cache = cache_home / "ryoku" / "shima"
    cache.mkdir(mode=0o700, parents=True, exist_ok=True)
    archive = cache / (meta["archive_sha256"] + ".tar.gz")
    if archive.is_file() and sha256_file(archive) == meta["archive_sha256"]:
        return archive

    fd, temporary = tempfile.mkstemp(prefix=".download-", dir=cache)
    try:
        with os.fdopen(fd, "wb") as out:
            with urllib.request.urlopen(meta["archive"], timeout=45) as response:
                shutil.copyfileobj(response, out)
        downloaded = Path(temporary)
        if sha256_file(downloaded) != meta["archive_sha256"]:
            raise RuntimeError("Downloaded iNiR archive failed SHA-256 verification")
        os.replace(downloaded, archive)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    return archive


def extract_runtime(archive, stage, files, revision):
    prefix = "iNiR-" + revision + "/"
    seen = set()
    links = []
    with tarfile.open(archive, "r:gz") as source:
        for entry in source:
            if not entry.name.startswith(prefix):
                continue
            rel = entry.name[len(prefix):]
            if rel not in files:
                continue
            if rel in seen:
                raise RuntimeError(f"Duplicated iNiR file: {rel}")
            seen.add(rel)
            if entry.issym():
                links.append((rel, entry.linkname))
                continue
            if not entry.isfile():
                raise RuntimeError(f"Unsafe iNiR file type: {rel}")
            target = stage / rel
            target.parent.mkdir(parents=True, exist_ok=True)
            with source.extractfile(entry) as stream, target.open("wb") as out:
                shutil.copyfileobj(stream, out)
            target.chmod(0o755 if entry.mode & 0o111 else 0o644)

    for rel, linked in links:
        target_rel = posixpath.normpath(posixpath.join(posixpath.dirname(rel), linked))
        if posixpath.isabs(linked) or target_rel not in seen or target_rel.startswith("../"):
            raise RuntimeError(f"Unsafe upstream asset link: {rel}")
        source_file = stage / target_rel
        target = stage / rel
        if not source_file.is_file() or source_file.is_symlink():
            raise RuntimeError(f"Missing upstream asset link target: {rel}")
        shutil.copyfile(source_file, target)
        target.chmod(0o644)

    if seen != files:
        missing = sorted(files - seen)
        raise RuntimeError(f"Pinned iNiR archive is missing {len(missing)} runtime files: {missing[:3]}")


def apply_patch(directory, patch):
    if not shutil.which("git"):
        raise RuntimeError("Git is required to apply the pinned Shima integration patch")
    for flag in (["--check"], []):
        command = ["git", "apply", "--whitespace=nowarn", *flag, str(patch)]
        process = subprocess.run(command, cwd=directory, capture_output=True, text=True)
        if process.returncode:
            raise RuntimeError("Shima patch validation failed: " + process.stderr.strip()[-850:])


def apply_overview_patch(directory, patch):
    if not shutil.which("git"):
        raise RuntimeError("Git is required to apply the Shima overview patch")
    for flag in (["--check"], []):
        command = ["git", "apply", "--unidiff-zero", *flag, str(patch)]
        process = subprocess.run(command, cwd=directory, capture_output=True, text=True)
        if process.returncode:
            raise RuntimeError("Shima overview patch validation failed: " + process.stderr.strip()[-850:])


def activate(root, generation):
    current = root / "current"
    if current.exists() and not current.is_symlink():
        raise RuntimeError("Refusing to replace a non-symlink Shima installation")
    temporary = root / (".current-" + str(os.getpid()))
    try:
        temporary.symlink_to(Path("generations") / generation)
        os.replace(temporary, current)
    finally:
        temporary.unlink(missing_ok=True)


def install(meta, files, directory, archive_arg):
    root = data_root()
    if root.is_symlink():
        raise RuntimeError("Refusing a symlinked Shima runtime directory")
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    generations = root / "generations"
    generations.mkdir(mode=0o700, exist_ok=True)
    combined_patch = hashlib.sha256((meta["patch_sha256"] + meta["overview_patch_sha256"]).encode()).hexdigest()
    generation = meta["revision"][:12] + "-" + combined_patch[:12]
    target = generations / generation
    with (root / ".install.lock").open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if target.exists():
            if not verified_generation(target, meta):
                raise RuntimeError("An existing Shima generation is damaged. No changes made")
            activate(root, generation)
            return target

        archive = ensure_archive(meta, archive_arg)
        stage = Path(tempfile.mkdtemp(prefix=".staging-", dir=generations))
        try:
            extract_runtime(archive, stage, files, meta["revision"])
            apply_patch(stage, directory / "runtime.patch")
            apply_overview_patch(stage, directory / "shima-overview-terminal.patch")
            digest, count = runtime_digest(stage)
            if digest != meta["runtime_sha256"] or count != meta["runtime_files"]:
                raise RuntimeError("Assembled Shima runtime differs from the tested pinned build")
            (stage / "runtime.json").write_text(json.dumps({
                "revision": meta["revision"],
                "archive_sha256": meta["archive_sha256"],
                "patch_sha256": meta["patch_sha256"],
                "overview_patch_sha256": meta["overview_patch_sha256"],
            }, indent=2) + "\n")
            stage.rename(target)
        finally:
            if stage.exists():
                shutil.rmtree(stage)
        activate(root, generation)
        return target


def main():
    parser = argparse.ArgumentParser(description="Install the pinned Shima runtime without changing the desktop")
    parser.add_argument("command", nargs="?", choices=("install", "verify", "status"), default="status")
    parser.add_argument("--archive", help="Use a previously downloaded, verified iNiR archive")
    args = parser.parse_args()
    directory, meta, files = load_metadata()
    root = data_root()

    if args.command == "install":
        if os.geteuid() == 0:
            raise RuntimeError("Install Shima as your normal user, without sudo")
        target = install(meta, files, directory, args.archive)
        print(f"Installed Shima {meta['version']}: {target}")
        print("Activate only with RYOKU_SHIMA_UPSTREAM=1 in the Ryoku daemon environment")
        return

    current = root / "current"
    if not current.is_symlink():
        print("Shima upstream runtime is not installed")
        if args.command == "verify":
            raise RuntimeError("No Shima runtime is installed")
        return
    target = current.resolve()
    if not target.is_relative_to((root / "generations").resolve()):
        raise RuntimeError("Shima current symlink escapes the generation directory")
    if not verified_generation(target, meta):
        raise RuntimeError("Installed Shima runtime failed integrity verification")
    print(f"Shima {meta['version']} verified: {target}")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, RuntimeError, tarfile.TarError) as error:
        print(f"ryoku-shima-install: {error}", file=sys.stderr)
        sys.exit(1)
