#!/usr/bin/env bash
# ryostage: the desktop's cut-out engine (docs/stage.md), shared by the
# Subject-in-front and Parallax effects. `cut` writes the wallpaper's subject as
# an alpha-matted PNG, `inpaint` fills the hole it leaves with the surrounding
# colour so a drifting subject reveals the backdrop and not its own ghost.
# The runtime is opt-in: `install` provisions one venv on first enable, so
# nothing ML ships in the base image.
#
# Third-party runtime, fetched on first enable, removable with `remove`.
# Weights carry their own licence, separate from rembg's:
#   rembg[cpu]            MIT            https://github.com/danielgatis/rembg
#   onnxruntime (via it)  MIT            https://github.com/microsoft/onnxruntime
#   u2netp                Apache-2.0*    https://github.com/xuebinqin/U-2-Net
#   silueta               MIT            https://github.com/xuebinqin/U-2-Net/issues/295
#   birefnet-*            MIT            https://github.com/ZhengPeng7/BiRefNet
# * the upstream U-2-Net repo states no licence; the mirrored weights rembg
#   fetches are published Apache-2.0.
set -euo pipefail

# One venv and one model cache for both effects. A pre-split tree from the old
# ryoku-depth or ryoku-parallax-engine is adopted by rename (same filesystem,
# no re-download); a leftover second tree is the doctor's to reclaim.
xdg_state="${XDG_STATE_HOME:-$HOME/.local/state}"
state="$xdg_state/ryoku/ryostage"
if [[ ! -x "$state/venv/bin/python" ]]; then
    for legacy in "$xdg_state/ryoku/depth" "$xdg_state/ryoku/parallax"; do
        [[ -x "$legacy/venv/bin/python" ]] || continue
        mkdir -p "$(dirname "$state")"
        mv "$legacy" "$state" 2>/dev/null || state="$legacy"
        break
    done
fi
venv="$state/venv"
models="$state/models"
export REMBG_HOME="$models"
export U2NET_HOME="$models" # older rembg reads this name

# The curated catalogue: id, quality tier, UI label, download size, licence,
# upstream. `models --json` renders it for the Stage tab so no tier is hardcoded
# in QML.
curated=(u2netp silueta birefnet-general-lite birefnet-general birefnet-portrait)
default_model="u2netp"
model_meta() {
    case "$1" in
    u2netp) printf 'draft\tU2Net Portable\t4.6 MB\tApache-2.0 (mirrored weights)\thttps://github.com/xuebinqin/U-2-Net\n' ;;
    silueta) printf 'draft\tSilueta · Fast\t44.2 MB\tMIT\thttps://github.com/xuebinqin/U-2-Net/issues/295\n' ;;
    birefnet-general-lite) printf 'fine\tBiRefNet General Lite\t224 MB\tMIT\thttps://github.com/ZhengPeng7/BiRefNet\n' ;;
    birefnet-general) printf 'fine\tBiRefNet General · Best\t973 MB\tMIT\thttps://github.com/ZhengPeng7/BiRefNet\n' ;;
    birefnet-portrait) printf 'fine\tBiRefNet Portrait · People\t973 MB\tMIT\thttps://github.com/ZhengPeng7/BiRefNet\n' ;;
    esac
}

is_curated() {
    local m
    for m in "${curated[@]}"; do
        [[ "$1" == "$m" ]] && return 0
    done
    return 1
}

rembg_python() {
    if [[ -x "$venv/bin/python" ]] && "$venv/bin/python" -c "import rembg" 2>/dev/null; then
        PY="$venv/bin/python"
        return 0
    fi
    local p
    for p in python3.13 python3.12 python3.11 python3; do
        command -v "$p" >/dev/null 2>&1 || continue
        if "$p" -c "import rembg" 2>/dev/null; then
            PY="$p"
            return 0
        fi
    done
    return 1
}

# inpaint imports numpy, PIL and scipy (not rembg), so gate on those directly.
inpaint_python() {
    if [[ -x "$venv/bin/python" ]] && "$venv/bin/python" -c "import numpy, PIL, scipy" 2>/dev/null; then
        PY="$venv/bin/python"
        return 0
    fi
    local p
    for p in python3.13 python3.12 python3.11 python3; do
        command -v "$p" >/dev/null 2>&1 || continue
        if "$p" -c "import numpy, PIL, scipy" 2>/dev/null; then
            PY="$p"
            return 0
        fi
    done
    return 1
}

# rembg's cache layout varies by version, so find the onnx rather than assume a path.
model_cached() { [[ -n "$(find "$models" -name "$1.onnx" -print -quit 2>/dev/null)" ]]; }

cmd_check() {
    local model="${1:-}"
    if ! rembg_python; then
        printf 'runtime missing\n'
        return 1
    fi
    if [[ -n $model ]]; then
        if model_cached "$model"; then
            printf 'available\n'
            return 0
        fi
        printf 'model %s missing\n' "$model"
        return 1
    fi
    local m
    for m in "${curated[@]}"; do
        if model_cached "$m"; then
            printf 'available\n'
            return 0
        fi
    done
    printf 'missing\n'
    return 1
}

cmd_models() {
    local json=0 m any=0 first=1 tier label size licence upstream installed
    [[ ${1:-} == --json ]] && json=1
    if [[ $json == 0 ]]; then
        rembg_python || return 1
        for m in "${curated[@]}"; do
            if model_cached "$m"; then
                printf '%s\n' "$m"
                any=1
            fi
        done
        [[ $any == 1 ]]
        return
    fi
    printf '['
    for m in "${curated[@]}"; do
        IFS=$'\t' read -r tier label size licence upstream < <(model_meta "$m")
        installed=false
        model_cached "$m" && installed=true
        [[ $first == 1 ]] || printf ','
        first=0
        printf '{"id":"%s","tier":"%s","label":"%s","size":"%s","installed":%s,"licence":"%s","upstream":"%s"}' \
            "$m" "$tier" "$label" "$size" "$installed" "$licence" "$upstream"
    done
    printf ']\n'
}

cmd_cut() {
    local in="" out="" model="$default_model" matting=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
        -m | --model)
            model="${2:-}"
            shift 2
            ;;
        --matting | --alpha-matting)
            matting=1
            shift
            ;;
        --)
            shift
            break
            ;;
        -*)
            printf 'ryostage: unknown option %s\n' "$1" >&2
            return 2
            ;;
        *)
            if [[ -z $in ]]; then in="$1"; elif [[ -z $out ]]; then out="$1"; fi
            shift
            ;;
        esac
    done
    [[ -z $in && $# -gt 0 ]] && {
        in="$1"
        shift
    }
    [[ -z $out && $# -gt 0 ]] && {
        out="$1"
        shift
    }

    if [[ -z $in || -z $out ]]; then
        printf 'usage: ryostage cut <in> <out.png> [--model <id>] [--matting]\n' >&2
        return 2
    fi
    [[ -f "$in" ]] || {
        printf 'ryostage: input not found: %s\n' "$in" >&2
        return 1
    }
    is_curated "$model" || model="$default_model"

    rembg_python || {
        printf 'ryostage: engine not installed (run: ryostage install)\n' >&2
        return 1
    }
    model_cached "$model" || {
        printf 'ryostage: model %s not downloaded\n' "$model" >&2
        return 1
    }

    mkdir -p "$(dirname -- "$out")"
    local tmp
    tmp="$(mktemp "${out}.XXXXXX")"
    if "$PY" - "$in" "$tmp" "$model" "$matting" <<'PY'
import sys
from rembg import new_session, remove
inp, out, model = sys.argv[1], sys.argv[2], sys.argv[3]
matting = sys.argv[4] == "1"
try:
    session = new_session(model, providers=["CUDAExecutionProvider", "CPUExecutionProvider"])
except TypeError:  # rembg too old for providers=
    session = new_session(model)
with open(inp, "rb") as f:
    data = f.read()
kw = dict(session=session)
if matting:
    # Alpha matting refines the silhouette (hair, fur, soft edges) at some cost
    # in time; the thresholds are rembg's, tuned for a clean foreground.
    kw.update(alpha_matting=True, alpha_matting_foreground_threshold=240,
              alpha_matting_background_threshold=10, alpha_matting_erode_size=10)
with open(out, "wb") as f:
    f.write(remove(data, **kw))
PY
    then
        if [[ -s "$tmp" ]]; then
            mv -f "$tmp" "$out"
            printf '%s\n' "$out"
            return 0
        fi
    fi
    rm -f "$tmp"
    printf 'ryostage: cut failed\n' >&2
    return 1
}

# Hole recolouring: takes the original wallpaper + the subject cutout's alpha
# channel as the hole mask and writes an RGB PNG whose hole pixels carry the
# mean colour of the surrounding background ring (the "recoloured background").
# No AI here: one dilate + one mean over the ring, so the pass is a couple of
# seconds and fully deterministic; the parallax surface renders this as its
# base and the drifted subject reveals the backdrop, not its own silhouette.
cmd_inpaint() {
    local in="" mask="" out=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --)
            shift
            break
            ;;
        -*)
            printf 'ryostage inpaint: unknown option %s\n' "$1" >&2
            return 2
            ;;
        *)
            if [[ -z $in ]]; then in="$1"; elif [[ -z $mask ]]; then mask="$1"; elif [[ -z $out ]]; then out="$1"; fi
            shift
            ;;
        esac
    done

    if [[ -z $in || -z $mask || -z $out ]]; then
        printf 'usage: ryostage inpaint <image> <mask> <out.png>\n' >&2
        return 2
    fi
    [[ -f "$in" ]] || {
        printf 'ryostage: image not found: %s\n' "$in" >&2
        return 1
    }
    [[ -f "$mask" ]] || {
        printf 'ryostage: mask not found: %s\n' "$mask" >&2
        return 1
    }
    inpaint_python || {
        printf 'ryostage: engine not installed (run: ryostage install)\n' >&2
        return 1
    }

    mkdir -p "$(dirname -- "$out")"
    local tmp
    tmp="$(mktemp "${out}.XXXXXX")"
    if "$PY" - "$in" "$mask" "$tmp" <<'PY'
# The Parallax backdrop: the wallpaper with the subject's hole filled from its
# surroundings, then softened as the far plane. The fill grows inward by
# normalized convolution (a Gaussian of the known colour over a Gaussian of the
# known mask), so the hole takes the colours and gradients around it instead of
# one flat plate, and a drifting subject never reveals its own silhouette. The
# hole is the matte grown outward first, so no subject pixel seeds the fill.
# Half resolution keeps it at a few seconds for a 4K wallpaper; the result is
# blurred anyway, so nothing is lost.
import sys
import numpy as np
from PIL import Image, ImageFilter
from scipy import ndimage

image_path, mask_path, out_path = sys.argv[1:4]

img_full = Image.open(image_path).convert("RGB")
mask_rgba = Image.open(mask_path).convert("RGBA")
W, H = img_full.size
scale = 2 if max(W, H) > 1600 else 1
size = (max(1, W // scale), max(1, H // scale))
img = np.asarray(img_full.resize(size, Image.BILINEAR), dtype=np.float32) / 255.0
alpha = np.asarray(mask_rgba.resize(size, Image.BILINEAR), dtype=np.uint8)[..., 3]

hole = ndimage.binary_fill_holes(alpha > 8)
hole = ndimage.binary_closing(hole, iterations=4)
hole = ndimage.binary_dilation(hole, iterations=6)

known = (~hole).astype(np.float32)
col = img * known[..., None]
sigma = 8.0
for _ in range(80):
    num = np.stack([ndimage.gaussian_filter(col[..., c], sigma=sigma) for c in range(3)], -1)
    den = ndimage.gaussian_filter(known, sigma=sigma)
    reach = den > 0.05
    fill = num / np.maximum(den, 0.05)[..., None]
    newly = reach & (known < 0.5)
    if not newly.any():
        break
    col = np.where(newly[..., None], fill, col)
    known = np.where(newly, 1.0, known)
    if known.min() > 0.5:
        break
if known.min() < 0.5:
    # A hole the fill could not reach (a subject covering the whole frame):
    # the mean of everything known, never a hard default.
    mean = (img * known[..., None]).sum((0, 1)) / max(1.0, known.sum())
    col = np.where((known < 0.5)[..., None], mean, col)

res = np.where(hole[..., None], col, img)
out = Image.fromarray(np.clip(res * 255.0, 0, 255).astype(np.uint8))
if scale != 1:
    out = out.resize((W, H), Image.BILINEAR)
out = out.filter(ImageFilter.GaussianBlur(4))
out = Image.fromarray((np.asarray(out, dtype=np.float32) * 0.90).astype(np.uint8))
out.save(out_path, "PNG")
PY
    then
        if [[ -s "$tmp" ]]; then
            mv -f "$tmp" "$out"
            printf '%s\n' "$out"
            return 0
        fi
    fi
    rm -f "$tmp"
    printf 'ryostage: inpaint failed\n' >&2
    return 1
}

pick_python() {
    # rembg needs Python 3.11-3.13; the system python3 may be newer.
    local p ver
    for p in python3.13 python3.12 python3.11 python3; do
        command -v "$p" >/dev/null 2>&1 || continue
        ver="$("$p" -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null)" || continue
        case "$ver" in
        3.11 | 3.12 | 3.13)
            printf '%s\n' "$p"
            return 0
            ;;
        esac
    done
    return 1
}

# A system Python 3.11-3.13 is the fast path; otherwise uv provisions one.
ensure_venv() {
    [[ -x "$venv/bin/python" ]] && return 0
    local py advice host_advice
    if py="$(pick_python)"; then
        printf 'Creating engine environment (%s)...\n' "$py"
        "$py" -m venv "$venv"
        return 0
    fi
    if command -v uv >/dev/null 2>&1; then
        printf 'Provisioning Python 3.13 via uv...\n'
        uv python install 3.13 && uv venv --python 3.13 "$venv"
        [[ -x "$venv/bin/python" ]] && return 0
    fi
    advice='sudo pacman -S uv'
    if command -v ryoku-host >/dev/null 2>&1; then
        if host_advice="$(ryoku-host pkg advice uv 2>/dev/null)" && [[ -n $host_advice ]]; then
            advice=$host_advice
        fi
    fi
    printf 'ryostage: needs Python 3.11-3.13 or uv (install it: %s)\n' "$advice" >&2
    return 1
}

# `python -m pip`, never bin/pip: a venv adopted by rename above keeps console
# scripts whose shebangs name the old directory, so bin/pip no longer runs.
venv_has_pip() { "$venv/bin/python" -m pip --version >/dev/null 2>&1; }
venv_pip() {
    if venv_has_pip; then
        "$venv/bin/python" -m pip install --quiet "$@"
        return
    fi
    uv pip install --quiet --python "$venv/bin/python" "$@"
}

cmd_install() {
    local want=("$@")
    [[ ${#want[@]} -eq 0 ]] && want=("$default_model")

    mkdir -p "$state" "$models"
    ensure_venv || return 1

    printf 'Installing rembg (CPU)...\n'
    venv_has_pip && venv_pip --upgrade pip
    if ! venv_pip "rembg[cpu]"; then
        printf 'ryostage: could not install rembg (no onnxruntime wheel for this Python?)\n' >&2
        return 1
    fi

    local m
    for m in "${want[@]}"; do
        is_curated "$m" || continue
        printf 'Downloading model %s...\n' "$m"
        "$venv/bin/python" - "$m" <<'PY'
import sys
from rembg import new_session
model = sys.argv[1]
try:
    new_session(model, providers=["CUDAExecutionProvider", "CPUExecutionProvider"])
except Exception:
    new_session(model)
PY
    done

    if cmd_check >/dev/null; then
        printf 'done\n'
        return 0
    fi
    printf 'ryostage: install finished but the engine is still unavailable\n' >&2
    return 1
}

cmd_remove() {
    local m="${1:-}"
    [[ -n $m ]] || {
        printf 'usage: ryostage remove <model>\n' >&2
        return 2
    }
    is_curated "$m" || {
        printf 'ryostage: not a curated model: %s\n' "$m" >&2
        return 2
    }
    local f found=0
    while IFS= read -r -d '' f; do
        rm -f "$f"
        found=1
    done < <(find "$models" -name "$m.onnx" -print0 2>/dev/null)
    if [[ $found -eq 1 ]]; then
        printf 'removed %s\n' "$m"
    else
        printf '%s was not installed\n' "$m"
    fi
    return 0
}

case "${1:-}" in
check) cmd_check "${2:-}" ;;
models)
    shift
    cmd_models "$@"
    ;;
cut)
    shift
    cmd_cut "$@"
    ;;
inpaint)
    shift
    cmd_inpaint "$@"
    ;;
install)
    shift
    cmd_install "$@"
    ;;
remove)
    shift
    cmd_remove "$@"
    ;;
*)
    printf 'usage: ryostage check | models [--json] | cut <in> <out.png> [--model <id>] [--matting] | inpaint <image> <mask> <out.png> | install [model...] | remove <model>\n' >&2
    exit 2
    ;;
esac
