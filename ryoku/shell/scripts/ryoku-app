#!/bin/bash
# ryoku-app: launch the user's chosen app for a role, or the Ryoku default.
#
#	ryoku-app terminal              open the terminal
#	ryoku-app terminal -- btop      run btop inside it
#
# The choice lives in the Hub's store (~/.config/ryoku/desktop.json,
# "desktop.apps"); the Default Apps page (Ryoku Settings) writes it. Reading it
# here means a swap takes effect on the next launch with no reload. The fallbacks
# match the shipped binds, so an unconfigured system behaves exactly as before.
set -euo pipefail

# Everything the desktop opens through here inherits this environment, and a
# Quickshell instance that has crashed once leaves __QUICKSHELL_CRASH_INFO_FD in
# it: the memfd of the config it came back from. Quickshell reads that variable
# before it parses arguments, so a Quickshell app started in the terminal we
# exec would draw a second desktop instead. Drop the handle once, here.
unset __QUICKSHELL_CRASH_INFO_FD __QUICKSHELL_CRASH_DUMP_PID \
	__QUICKSHELL_CRASH_DUMP_FD __QUICKSHELL_CRASH_LOG_FD __QUICKSHELL_CRASH_SIGNAL

role="${1:-}"
[ -n "$role" ] || { echo "usage: ryoku-app <role> [-- <program> [arg...]]" >&2; exit 2; }
shift

inner=()
if [ "${1:-}" = "--" ]; then
	shift
	inner=("$@")
	[ ${#inner[@]} -gt 0 ] || { echo "ryoku-app: -- needs a program to run" >&2; exit 2; }
fi

conf="${XDG_CONFIG_HOME:-$HOME/.config}/ryoku"
# The Hub writes the role under desktop.json's desktop.apps.
store="$conf/desktop.json"
# The retired store is still honoured so a box the doctor has not migrated yet
# keeps the role it set there.
legacy="$conf/hypr.json"

fallback() {
	case "$1" in
	browser)
		if command -v firefox >/dev/null 2>&1; then echo "firefox"
		elif command -v chromium >/dev/null 2>&1; then echo "chromium"
		elif command -v zen >/dev/null 2>&1; then echo "zen"
		elif command -v zen-browser >/dev/null 2>&1; then echo "zen-browser"
		else echo ""; fi ;;
	terminal) echo "kitty" ;;
	editor)   echo "kitty -e nvim" ;;
	files)    echo "nautilus" ;;
	*)        echo "" ;;
	esac
}

cmd=""
stored=0
read_role() {
	local file="$1" query="$2"
	[ -r "$file" ] || return 0
	command -v jq >/dev/null 2>&1 || return 0
	jq -r --arg r "$role" "$query" "$file" 2>/dev/null || true
}
cmd="$(read_role "$store" ".desktop.apps[\$r] // empty")"
if [ -n "$cmd" ]; then
	stored=1
else
	cmd="$(read_role "$legacy" ".apps[\$r] // empty")"
	[ -z "$cmd" ] || stored=1
fi
[ -n "$cmd" ] || cmd="$(fallback "$role")"

if [ -z "$cmd" ]; then
	notify-send "Ryoku" "No app set for \"$role\". Pick one in Settings > Default Apps." 2>/dev/null || true
	exit 1
fi
if (( stored )); then
	read -r -a command_argv <<<"$cmd"
	command_bin="${command_argv[0]:-}"
	if [ -z "$command_bin" ] || ! command -v "$command_bin" >/dev/null 2>&1; then
		notify-send "Ryoku" "The app set for \"$role\" is unavailable. Pick another in Settings > Default Apps." 2>/dev/null || true
		exit 1
	fi
fi

if [ ${#inner[@]} -eq 0 ]; then
	exec sh -c "$cmd"
fi

# Handing a program over is per-emulator: kitty and foot take trailing argv.
read -r -a argv <<<"$cmd"
case "${argv[0]##*/}" in
kitty | foot) ;;
wezterm) argv+=(start --) ;;
*) argv+=(-e) ;;
esac
exec "${argv[@]}" "${inner[@]}"
