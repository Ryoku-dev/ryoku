#!/usr/bin/env bash
# The compositor config stays init-neutral while each host keeps its native
# session supervisor and environment handoff.

if [[ -d /run/systemd/system ]]; then
    dbus-update-activation-environment --systemd --all
    systemctl --user daemon-reload
    ryoku-reload-cover begin boot || true
    ryoku-power-cutover session-start-logged && systemctl --user try-restart xdg-desktop-portal.service "$@"
else
    exec /usr/lib/ryoku/runit/session-start
fi
