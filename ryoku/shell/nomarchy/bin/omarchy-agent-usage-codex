#!/usr/bin/python3
import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path


def iso_reset(value):
    try:
        return datetime.fromtimestamp(int(value), timezone.utc).isoformat()
    except Exception:
        return ""


def base_record(agent_id, name, source, path):
    stamp = datetime.fromtimestamp(path.stat().st_mtime, timezone.utc).isoformat()
    recent = []
    for item in source.get("_recent_days") or []:
        if isinstance(item, dict):
            recent.append({"date": str(item.get("date") or ""), "messageCount": int(item.get("tokens") or 0)})
    return {
        "schemaVersion": 1,
        "id": agent_id,
        "name": name,
        "updatedAt": stamp,
        "ready": True,
        "hasLocalStats": True,
        "hasPromptStats": False,
        "todayPrompts": 0,
        "todaySessions": 0,
        "todayTotalTokens": int(source.get("_today_tokens") or 0),
        "todayTokensByModel": {},
        "recentDays": recent,
        "totalPrompts": 0,
        "totalSessions": 0,
        "activeDays": sum(1 for day in recent if day["messageCount"] > 0),
        "modelUsage": {},
        "limitsFetchedAt": int(path.stat().st_mtime * 1000),
        "limitsStale": source.get("_source") == "stale",
        "usageStatusText": "Last known Ryoku usage" if source.get("_source") == "stale" else "",
        "authHelpText": "Manage AI accounts in Rāshin.",
    }


def claude(path, data):
    record = base_record("claude", "Claude Code", data, path)
    record["tierLabel"] = "Claude subscription"
    record["limits"] = []
    for label, util_key, reset_key in (
        ("Session (5-hour)", "5h-utilization", "5h-reset"),
        ("Weekly (7-day)", "7d-utilization", "7d-reset"),
    ):
        try:
            percent = float(data.get(util_key) or 0)
        except Exception:
            continue
        if percent > 0 or data.get(reset_key):
            record["limits"].append({"label": label, "percent": percent, "resetsAt": iso_reset(data.get(reset_key))})
    return record


def codex(path, data):
    record = base_record("codex", "Codex", data, path)
    record["tierLabel"] = str(data.get("_plan") or "Codex subscription")
    record["limits"] = []
    windows = data.get("windows") or []
    if not windows:
        for bucket in data.get("buckets") or []:
            if isinstance(bucket, dict):
                windows.extend(bucket.get("windows") or [])
    seen = set()
    for window in windows:
        if not isinstance(window, dict):
            continue
        key = (window.get("label"), window.get("reset"))
        if key in seen:
            continue
        seen.add(key)
        record["limits"].append({
            "label": str(window.get("label") or "Usage window"),
            "title": str(window.get("label") or "Usage window"),
            "percent": float(window.get("utilization") or 0),
            "resetsAt": iso_reset(window.get("reset")),
        })
    return record


name = Path(sys.argv[0]).name.rsplit("-", 1)[-1]
if name not in {"claude", "codex"}:
    raise SystemExit(0)
path = Path.home() / ".cache" / f"{name}-usage.json"
if not path.is_file():
    raise SystemExit(0)
try:
    data = json.loads(path.read_text(encoding="utf-8"))
    record = claude(path, data) if name == "claude" else codex(path, data)
except Exception as exc:
    print(f"omarchy-agent-usage-{name}: {exc}", file=sys.stderr)
    raise SystemExit(1)
print(json.dumps(record, separators=(",", ":"), sort_keys=True))
