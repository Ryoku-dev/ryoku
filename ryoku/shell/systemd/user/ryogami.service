[Unit]
# ryogami renders every wallpaper surface (image + live) and serves the
# wallpaper topic the shell subscribes to, so it is supervised beside the shell
# daemon on the same session target.
Description=Ryogami wallpaper daemon
PartOf=ryoku-session.target
After=ryoku-session.target
ConditionEnvironment=WAYLAND_DISPLAY
# a config that cannot load would otherwise restart forever; stop and let
# doctor report it instead (start-rate keys belong in [Unit]).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=/usr/bin/ryogami
Restart=always
RestartSec=2
# Kill only the daemon on stop, not its cgroup: it reaps its own render
# surfaces and the ryoku-depth helper it shells out to must outlive a reload.
KillMode=process
Slice=session.slice
# quickshell links jemalloc, so the glibc arena cap does nothing here. The
# picker's tree is built and torn down on every open; without a decay schedule
# the freed pages stay mapped (measured: ~128 MB stranded after a single
# open/close). Same tuning the shell daemon gives its own surfaces.
Environment=MALLOC_CONF=narenas:2,background_thread:true,dirty_decay_ms:5000,muzzy_decay_ms:5000

[Install]
WantedBy=ryoku-session.target
