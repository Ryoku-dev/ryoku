[Unit]
Description=Ryoku Bluetooth pairing agent (BlueZ default agent)
Documentation=https://github.com/Ryoku-dev/ryoku/issues/308
ConditionUser=!@system
# bluetoothd must be up to talk to; the agent is useless without it, and a
# bluetooth restart drops the registration, so follow it through.
After=bluetooth.service
Wants=bluetooth.service
PartOf=bluetooth.service

[Service]
Type=simple
# KeyboardDisplay is the capability BLE HID devices (gamepads, keyboards)
# pair with: they confirm a numeric passkey, and bluetoothd denies the bond
# when no agent can answer (#308). Devices that need nothing (headphones,
# Just Works) are unaffected. bluetoothctl exits at stdin EOF when it is not
# attached to a terminal, so sleep holds stdin open (tail -f wakes every
# second) and the agent sits idle and
# auto-confirms the comparison prompts bluetoothd sends it.
ExecStart=/bin/sh -c 'sleep infinity | bluetoothctl --agent KeyboardDisplay'
Restart=on-failure
RestartSec=2
Slice=session.slice

[Install]
WantedBy=default.target
