[Unit]
Description=Ryoku clamshell policy daemon
PartOf=ryoku-session.target
After=ryoku-session.target
ConditionEnvironment=WAYLAND_DISPLAY
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=/usr/bin/ryoku-clamshell daemon
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
Slice=session.slice

[Install]
WantedBy=ryoku-session.target
