#!/usr/bin/env python3
"""Collect native Claude Code history, account quotas and local API value."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import runpy
from datetime import datetime


def collect(config, cache):
    # Reuse the bundled, tested history schema and private atomic publisher.
    shared = runpy.run_path(str(Path(__file__).resolve().with_name("codex-usage")))
    helpers = {name: runpy.run_path(str(Path(__file__).resolve().with_name("claude-" + name + ".py")))
               for name in ("quota", "sessions", "spending")}
    now = shared["now_epoch"]()
    transcript_state = helpers["sessions"]["TranscriptState"](int(now * 1000))
    requests = {}
    sessions = {}
    files = list((config / "projects").rglob("*.jsonl"))
    malformed = unidentified = unknown_reasoning = 0
    for path in sorted(files):
        try:
            handle = path.open(errors="replace")
        except OSError:
            continue
        with handle:
            for index, line in enumerate(handle):
                try:
                    event = json.loads(line)
                except ValueError:
                    malformed += 1
                    continue
                transcript_state.observe(event, path, index)
                if not isinstance(event, dict) or event.get("type") != "assistant":
                    continue
                message = event.get("message")
                if not isinstance(message, dict):
                    continue
                usage = message.get("usage")
                if not isinstance(usage, dict):
                    continue
                if not usage or message.get("role") != "assistant":
                    continue
                identity = message.get("id")
                if not identity:
                    unidentified += 1
                    continue
                stamp = shared["iso_epoch"](str(event.get("timestamp") or ""))
                if not stamp:
                    continue
                counts = {}
                valid = True
                for key in ("input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"):
                    value = usage.get(key, 0)
                    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
                        valid = False
                        break
                    counts[key] = value
                if not valid:
                    continue
                details = usage.get("output_tokens_details")
                reasoning = details.get("thinking_tokens") if isinstance(details, dict) else None
                if not isinstance(reasoning, int) or isinstance(reasoning, bool) or reasoning < 0:
                    reasoning = None
                # Content blocks repeat the same response's counters. Keep the
                # largest observed snapshot, including partial writes/streaming.
                sid = str(event.get("sessionId") or path.stem)
                request_id = event.get("requestId") or event.get("request_id")
                key = ("request", str(request_id), str(identity)) if request_id else ("session", sid, str(identity))
                row = requests.setdefault(key, dict(counts, reasoning=reasoning,
                    time=int(round(stamp * 1000)), session_id=sid,
                    model=str(message.get("model") or "unknown"),
                    effort=str(event.get("effort") or "unknown"),
                    event_id=json.dumps(key, separators=(",", ":")),
                    cache_write_5m=None, cache_write_1h=None,
                    stop_reason_present="stop_reason" in message,
                    stop_reason=message.get("stop_reason"),
                    service_tier=usage.get("service_tier"), speed=usage.get("speed"),
                    inference_geo=usage.get("inference_geo"), server_tool_use=usage.get("server_tool_use")))
                if row["model"] == "unknown" and isinstance(message.get("model"), str) and message["model"]:
                    row["model"] = message["model"]
                if row["effort"] == "unknown" and isinstance(event.get("effort"), str):
                    row["effort"] = event["effort"]
                for name, value in counts.items():
                    row[name] = max(row[name], value)
                if reasoning is not None:
                    row["reasoning"] = max(row["reasoning"] or 0, reasoning)
                for field in ("service_tier", "speed", "inference_geo", "server_tool_use"):
                    if row[field] is None and usage.get(field) is not None:
                        row[field] = usage[field]
                if "stop_reason" in message:
                    row["stop_reason_present"] = True
                    if message["stop_reason"] is not None:
                        row["stop_reason"] = message["stop_reason"]
                creation = usage.get("cache_creation")
                if isinstance(creation, dict):
                    for source, target in (("ephemeral_5m_input_tokens", "cache_write_5m"),
                                           ("ephemeral_1h_input_tokens", "cache_write_1h")):
                        value = creation.get(source)
                        if isinstance(value, int) and not isinstance(value, bool) and value >= 0:
                            row[target] = max(row[target] or 0, value)
                row["time"] = min(row["time"], int(round(stamp * 1000)))
                session = sessions.setdefault(sid, {"id": sid, "title": "Claude session",
                    "directory": str(event.get("cwd") or ""), "started": row["time"],
                    "updated": row["time"], "tokens": 0, "cost": 0.0, "running": False})
                session["started"] = min(session["started"], row["time"])
                session["updated"] = max(session["updated"], int(round(stamp * 1000)))
    messages = []
    models = set()
    efforts = set()
    incomplete = 0
    for row in requests.values():
        if not any(row[key] for key in ("input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens")):
            continue
        output = row["output_tokens"]
        # CodexBar excludes explicit null-stop initialization placeholders. A
        # later cumulative response snapshot replaces the placeholder normally.
        if row["stop_reason_present"] and row["stop_reason"] is None and output == 0 \
                and row["input_tokens"] > 0 and not row["cache_read_input_tokens"] \
                and not row["cache_creation_input_tokens"]:
            incomplete += 1
            continue
        if row["reasoning"] is None:
            unknown_reasoning += 1
        reason = min(output, row["reasoning"] or 0)
        inp, read, write = (row[k] for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
        total = inp + write + output
        message = dict(time=row["time"], session_id=row["session_id"], model_id=row["model"],
            provider_id="", input=inp, output=output-reason, reasoning=reason,
            cache_read=read, cache_write=write, total=total,
            total_with_cache_read=total+read, cost=0.0,
            **{key: row[key] for key in ("event_id", "cache_write_5m", "cache_write_1h",
                "service_tier", "speed", "inference_geo", "server_tool_use")})
        messages.append(message)
        sessions[row["session_id"]]["tokens"] += total
        models.add(row["model"])
        efforts.add(row["effort"])
    messages.sort(key=lambda r: r["time"])
    lifecycle = helpers["sessions"]["collect_sessions"](
        config, now_ms=int(now * 1000), transcript_state=transcript_state)
    for sid, metadata in lifecycle.items():
        session = sessions.setdefault(sid, {"id": sid, "tokens": 0, "cost": 0.0})
        session.update(metadata)
    try:
        spending, event_costs = helpers["spending"]["estimate_spending"](messages, now=now)
    except OSError:
        spending = {"kind": "api-equivalent", "month": datetime.fromtimestamp(now).strftime("%Y-%m"),
                    "currency": "USD", "amount": None, "partial": True,
                    "state_error": "pricing-state-unavailable"}
        event_costs = {}
    if incomplete:
        spending["partial"] = True
        spending["incomplete_requests"] = incomplete
    for message in messages:
        cost = event_costs.get(message["event_id"])
        # The estimate is separate from provider-billed cost. History costs are
        # local API value only; unknown events remain excluded with coverage.
        if cost is not None:
            message["cost"] = cost
            sessions[message["session_id"]]["cost"] += cost
    try:
        previous = json.loads(cache.read_text())
    except (OSError, ValueError):
        previous = None
    quota = helpers["quota"]["collect_quota"](config, now=now, previous=previous)
    start = int(datetime.fromtimestamp(now).astimezone().replace(hour=0, minute=0, second=0, microsecond=0).timestamp()*1000)
    days = shared["history_days"](messages)
    session_rows = shared["history_sessions"](sessions, limit=max(10, len(sessions)))
    # Keep all running sessions ahead of the bounded recent idle history.
    session_rows.sort(key=lambda row: (row["running"], row["updated"]), reverse=True)
    session_rows = session_rows[:max(10, sum(row["running"] for row in session_rows))]
    for row in session_rows:
        for key in ("activityState", "activityEvidence", "processState"):
            if key in sessions[row["id"]]:
                row[key] = sessions[row["id"]][key]
    out = {"schemaVersion": 3, "_source": "claude-native", "_preview": True,
        **quota, "_spending": spending,
        "_today_tokens": sum(r["total_with_cache_read"] for r in messages if r["time"] >= start),
        "_rate_per_hour": sum(r["total_with_cache_read"] for r in messages if r["time"] >= (now-3600)*1000),
        "_days": days, "_hours": shared["history_hours"](messages),
        "_recent_days": [{"date": r["date"], "tokens": r["tokens"]+r["cacheRead"]} for r in days[-7:]],
        "_sessions": session_rows,
        "_periods": {key: shared["history_period"](messages, since)
                     for key, since in shared["period_starts"](now).items()},
        "_model": messages[-1]["model_id"] if messages else "",
        "_diagnostics": {"files": len(files), "requests": len(requests), "models": sorted(models),
            "efforts": sorted(efforts), "malformed_lines": malformed, "unidentified_rows": unidentified,
            "unknown_reasoning_requests": unknown_reasoning, "incomplete_requests": incomplete},
        "updated_at": datetime.now().strftime("%H:%M:%S"), "status": "unknown"}
    shared["atomic_write_json"](cache, out)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--cache", type=Path, default=Path.home()/".cache/ai-usage/claude-usage.json")
    args = parser.parse_args()
    args.cache.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(str(args.cache)+".lock", os.O_CREAT|os.O_RDWR|os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX|fcntl.LOCK_NB)
        collect(Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home()/".claude"), args.cache)
    except BlockingIOError:
        raise SystemExit(75)
    finally:
        os.close(fd)
