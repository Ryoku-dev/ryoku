#!/usr/bin/env bash
# Keeps remembered per-output layouts current while the display link is off.
# Started by ryoku-output-tiling, never at login on its own. It blocks on the
# window-manager seam's event stream (`ryoku wm watch`) and runs restore on each
# workspaces or outputs frame: a created workspace, or a display that connects or
# disconnects. When the link is back on it exits. One instance at a time.
set -uo pipefail

runtime="${XDG_RUNTIME_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/ryoku}"
mkdir -p "$runtime"
exec 8>"$runtime/output-tiling-watch.lock"
flock -n 8 || exit 0

log="${XDG_STATE_HOME:-$HOME/.local/state}/ryoku/output-tiling-watch.log"
mkdir -p "$(dirname "$log")"

unlinked() { [[ $(ryoku-output-tiling get | jq -r '.linked') == false ]]; }

while unlinked; do
    while IFS= read -r frame; do
        case $(jq -r '.kind // empty' <<<"$frame" 2>/dev/null) in
        workspaces|outputs)
            unlinked || exit 0
            ryoku-output-tiling restore >/dev/null 2>&1 || true
            ;;
        esac
    done < <(ryoku wm watch workspaces outputs 2>>"$log" 8>&-)
    # the stream ended (compositor restarted); back off so a missing one does not spin
    sleep 1
done
