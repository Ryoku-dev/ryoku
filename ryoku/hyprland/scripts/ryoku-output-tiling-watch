#!/usr/bin/env bash
# Keeps remembered per-output layouts on workspaces created after login. Polls the
# window-manager seam's neutral state (`ryoku wm state`) and re-runs restore when the
# workspace list changes. Named no provider, so it stays behind the seam.
# restore is a no-op while the display link is on, and re-applying an unchanged
# layout is harmless.
set -uo pipefail

last=""
while true; do
    cur=$(ryoku wm state 2>/dev/null | jq -c '[.workspaces[]? | {id, output}]' 2>/dev/null || true)
    if [[ -n $cur && $cur != "$last" ]]; then
        last=$cur
        ryoku-output-tiling restore >/dev/null 2>&1 || true
    fi
    sleep 2
done
