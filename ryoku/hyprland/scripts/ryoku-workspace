#!/usr/bin/env bash
# the binds run modules/workspaces.lua in the compositor, this runs it through hyprctl eval for the Kit and by hand
set -euo pipefail

usage() {
  echo "usage: ryoku-workspace {desktop|focus <1..10>|move <1..10>|movesilent <1..10>|hide|scratch}" >&2
  exit 2
}

grid() {
  local out
  out=$(hyprctl eval "require(\"modules.workspaces\").$1") ||
    { echo "ryoku-workspace: ${out#error: }" >&2; exit 1; }
}

case ${1-} in
  desktop)
    # eval only prints ok or an error, so the value comes back as the error text
    out=$(hyprctl eval 'error(tostring(require("modules.workspaces").desktop()), 0)') || true
    out=${out#error: }
    [[ $out =~ ^[0-9]+$ ]] || { echo "ryoku-workspace: $out" >&2; exit 1; }
    echo "$out"
    ;;
  focus | move | movesilent)
    [[ ${2-} =~ ^[0-9]+$ ]] || usage
    grid "$1($2)"
    ;;
  hide | scratch)
    grid "$1()"
    ;;
  *)
    usage
    ;;
esac
