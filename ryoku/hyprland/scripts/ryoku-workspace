#!/usr/bin/env bash
# Command-line face of the per-desktop workspace grid and the scratchpad. The
# logic lives in modules/workspaces.lua, which the Super+N, Super+H and
# Super+Alt+H binds run inside the compositor; this runs the same functions
# through `hyprctl eval` for the Kit command reference and hand use.
#
#   ryoku-workspace desktop             print the current desktop index (0-based)
#   ryoku-workspace focus <slot>        focus the Nth workspace of the current desktop
#   ryoku-workspace move <slot>         move the active window there (and follow it)
#   ryoku-workspace movesilent <slot>   move the active window there and stay
#   ryoku-workspace hide                stash the focused window in the scratchpad,
#                                       or pull it back out if it is already there
#   ryoku-workspace scratch             show the scratchpad, or hide it and hand
#                                       keyboard focus back to what is on screen
set -euo pipefail

usage() {
  echo "usage: ryoku-workspace {desktop|focus <1..10>|move <1..10>|movesilent <1..10>|hide|scratch}" >&2
  exit 2
}

# eval prints "ok", or "error: <message>" with a non-zero exit for a Lua error.
grid() {
  local out
  out=$(hyprctl eval "require(\"modules.workspaces\").$1") ||
    { echo "ryoku-workspace: ${out#error: }" >&2; exit 1; }
}

case ${1-} in
  desktop)
    # eval prints nothing but "ok" or the error text, so the value comes back
    # as an error message.
    out=$(hyprctl eval 'error(tostring(require("modules.workspaces").desktop()), 0)') || true
    out=${out#error: }
    [[ $out =~ ^[0-9]+$ ]] || { echo "ryoku-workspace: $out" >&2; exit 1; }
    echo "$out"
    ;;
  focus | move | movesilent)
    [[ ${2-} =~ ^[0-9]+$ ]] || usage
    grid "$1($2)"
    ;;
  hide | scratch)
    grid "$1()"
    ;;
  *)
    usage
    ;;
esac
