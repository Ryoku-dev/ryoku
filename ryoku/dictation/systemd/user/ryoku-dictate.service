[Unit]
Description=Ryoku voice typing
Documentation=man:ryoku-dictate(1)
# Started on demand by ryoku-shell when Super+` is tapped, and by Settings when
# dictation is switched on. Nothing starts it at login: with dictation off there
# is no process and no model in memory.
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/ryoku-dictate --serve
Restart=on-failure
RestartSec=1
# The model is memory-mapped and unmapped when idle; the daemon holds the
# microphone only while a recording is in progress.
Nice=5
IOSchedulingClass=idle

[Install]
WantedBy=ryoku-session.target
