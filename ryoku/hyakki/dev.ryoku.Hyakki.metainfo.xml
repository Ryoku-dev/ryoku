  <name>Hyakki</name>
  <summary>Local-first agent harness</summary>
  <developer id="dev.ryoku">
    <name>Ryoku-dev</name>
  </developer>
  <description>
    <p>Hyakki is a local-first harness for working with models, agents and teams. The command-line client and desktop app connect to the on-demand Oni daemon.</p>
    <p>Local models and user-supplied providers work without a Ryoku Account. External harnesses and memory services are optional.</p>
  </description>
  <launchable type="desktop-id">dev.ryoku.Hyakki.desktop</launchable>
  <provides>
    <binary>hyakki</binary>
    <binary>oni</binary>
    <binary>hyakki-app</binary>
  </provides>
