# Template file for 'hyakki'
# SPDX-License-Identifier: GPL-3.0-only
# Standalone Hyakki, built from its corresponding-source archive made with
# release/source-dist.sh and placed in files/hyakki-${version}.tar.gz.
# No release is published, so nothing is fetched.
pkgname=hyakki
version=0.1.0
revision=1
replaces="ryoku-rashin>=0"
conflicts="ryoku-rashin>=0"
archs="x86_64"
wrksrc="hyakki-${version}/ryoku/hyakki"
hostmakedepends="go python3 pkg-config"
makedepends="wayland-devel libxkbcommon-devel libglvnd-devel Vulkan-Headers libX11-devel libXcursor-devel libXfixes-devel"
depends="python3 git xdg-utils hicolor-icon-theme libxkbcommon-x11 libX11 libXcursor libXfixes wayland libxkbcommon mesa-dri libglvnd vulkan-loader bubblewrap"
# xbps has no optional dependencies; INSTALL.msg lists them from
# release/optional.json, and release/check.py keeps the two equal.
short_desc="Hyakki local-first AI desktop and command line"
maintainer="Ryoku <releases@ryoku.dev>"
license="GPL-3.0-only, Apache-2.0, OFL-1.1, MIT, BSD-3-Clause, LicenseRef-SCOWL, Zlib"
homepage="https://ryoku.dev"
nostrip=yes

do_extract() {
	bsdtar -xf "${FILESDIR}/hyakki-${version}.tar.gz" -C "${XBPS_BUILDDIR}"
}

do_build() {
	HYAKKI_VERSION="${version}" HYAKKI_BUILD_DIR="${wrksrc}/build/native" ./release/build.sh
}

do_check() {
	python3 release/native.py notices --check
}

do_install() {
	stage="${wrksrc}/build/stage"
	HYAKKI_BUILD_DIR="${wrksrc}/build/native" DESTDIR="${stage}" ./release/install.sh
	./release/check.sh "${stage}"
	vcopy "${stage}/usr" /
}
