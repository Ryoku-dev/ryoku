// The login bootstrap: everything a Ryoku session must bring up when niri
// starts. niri has no scripting layer, so each entry is a spawn node. The
// systemd session line is load-bearing; the rest are best-effort helpers, each
// guarded so a missing binary or a second login still lands a session.
//
// X11 has no line here on purpose: niri creates the X11 sockets, exports
// $DISPLAY, and spawns xwayland-satellite on demand itself, restarting it if it
// dies. A manual start would race that and break it, so the binary ships as a
// dependency and niri drives it.

// Keyring secrets + pkcs11 agents, before anything can ask for a stored secret.
// Idempotent: re-prints its env and exits when PAM already started it at login.
spawn-at-startup "gnome-keyring-daemon" "--start" "--components=secrets,pkcs11"

spawn-at-startup "gsettings" "set" "org.gnome.desktop.interface" "color-scheme" "prefer-dark"
// adw-gtk3-dark, not Adwaita-dark: stock Adwaita GTK3 hardcodes its colours,
// while adw-gtk3 derives from the named colours the daemon already emits. The
// daemon owns accent-color, so it is not set here.
spawn-at-startup "gsettings" "set" "org.gnome.desktop.interface" "gtk-theme" "adw-gtk3-dark"

// Folder icons tinted to the wallpaper accent, rebuilt on every palette change.
spawn-sh-at-startup "command -v ryoku-cmd-folders >/dev/null 2>&1 && ryoku-cmd-folders"

// The session, in one chained command. Push the compositor env into the user
// manager first: a lost race skips ConditionEnvironment=WAYLAND_DISPLAY units
// and lands a black desktop. daemon-reload picks up freshly laid units, then
// session-start owns the guarded restarts and does not return until the shell
// and lid owners prove readiness. Portals restart last so a stale frontend
// cannot proxy ScreenCast requests to the dead backend.
spawn-sh-at-startup "dbus-update-activation-environment --systemd --all; systemctl --user daemon-reload; ryoku-power-cutover session-start && systemctl --user try-restart xdg-desktop-portal.service xdg-desktop-portal-gnome.service xdg-desktop-portal-gtk.service"

// No autoscale line: niri picks each output's scale itself, and ryoku-monitor is the Hyprland provider's display tool.

// Per-device Bluetooth codec memory: WirePlumber restores a device's profile
// across reconnects but not its A2DP codec, so reconcile on every card event.
// A no-op for anyone who never chose a codec.
spawn-sh-at-startup "command -v ryoku-bt-audio >/dev/null 2>&1 && ryoku-bt-audio watch"

// Record the keyring mode once and seed a blank passwordless default, so no app
// prompts for a keyring password out of the box. Idempotent once a mode is set.
spawn-sh-at-startup "command -v ryoku >/dev/null 2>&1 && ryoku keyring init"

spawn-sh-at-startup "command -v ryoku-gpu >/dev/null 2>&1 && ryoku-gpu persist"
// Battery charge ceiling and PCIe link policy are plain sysfs values the kernel
// forgets across a reboot, so a stored choice is pushed back at login. A no-op
// with no power.json and on a box without the knobs.
spawn-sh-at-startup "command -v ryoku-power >/dev/null 2>&1 && ryoku-power apply"

// Push the stored lighting look back at adopted keyboards and mice. A no-op
// until lighting is on with a device adopted.
spawn-sh-at-startup "command -v ryoku-hub >/dev/null 2>&1 && ryoku-hub lighting apply"
spawn-sh-at-startup "command -v ryoku-mic >/dev/null 2>&1 && ryoku-mic"

// Restore the warm screen when night light was left on; the process a reboot
// drops. A no-op when it was off or absent.
spawn-sh-at-startup "command -v ryoku-cmd-nightlight >/dev/null 2>&1 && ryoku-cmd-nightlight restore"

// Booted into a btrfs snapshot from the boot menu: offer the one-click restore.
// niri runs no XDG autostart entries, so start it here; a normal boot detects no
// snapshot and exits silently.
spawn-sh-at-startup "command -v limine-snapper-restore >/dev/null 2>&1 && limine-snapper-restore --notify"

// Seed voxtype's config and user service with the built-in hotkey off (the shell
// owns Super+` and the mic wave); starts unless dictation was turned off in the Hub.
spawn-sh-at-startup "command -v voxtype >/dev/null 2>&1 && command -v ryoku-hub >/dev/null 2>&1 && ryoku-hub voxtype ensure >/dev/null 2>&1"

// Seed the empty AI-translation key file so Language > Generate with AI can read it.
spawn-sh-at-startup "command -v ryoku-i18n >/dev/null 2>&1 && ryoku-i18n ensure >/dev/null 2>&1"

// Welcome tour, once per tour version: a fresh or older-version box sees it, a
// box already on this version is left alone. The version is written only after
// qs actually runs the tour, so a first-boot launch failure retries next login,
// and the flock guards a double fire. Bump the version when the tour changes.
// qs surfaces spawned here bypass ryoku-shell's daemon, which injects the QML module path.
spawn-sh-at-startup "s=\"${XDG_STATE_HOME:-$HOME/.local/state}/ryoku\"; v=$(head -n1 \"$s/welcome-seen\" 2>/dev/null); case \"$v\" in ''|*[!0-9]*) v=0;; esac; [ \"$v\" -lt 18 ] && flock -n \"${XDG_RUNTIME_DIR:-/tmp}/ryoku-welcome.lock\" env QML_IMPORT_PATH=\"$HOME/.local/lib/qt6/qml\" QML2_IMPORT_PATH=\"$HOME/.local/lib/qt6/qml\" qs -c welcome && mkdir -p \"$s\" && printf 18 > \"$s/welcome-seen\""

// First-boot keyboard hint, shown exactly once ever. The marker is written
// before the async launch, so a reboot before it is dismissed cannot bring it back.
spawn-sh-at-startup "s=\"${XDG_STATE_HOME:-$HOME/.local/state}/ryoku\"; [ -e \"$s/keys-hint-seen\" ] || { mkdir -p \"$s\" && printf seen > \"$s/keys-hint-seen\" && flock -n \"${XDG_RUNTIME_DIR:-/tmp}/ryoku-keys-hint.lock\" env QML_IMPORT_PATH=\"$HOME/.local/lib/qt6/qml\" QML2_IMPORT_PATH=\"$HOME/.local/lib/qt6/qml\" qs -c keys-hint; }"
