#!/usr/bin/env bash
#
# ryoku-greeter: the SDDM Wayland greeter compositor.
#
# Runs `weston --shell=kiosk` at each connected output's top mode (native
# resolution, highest refresh) so the login screen matches a high-refresh
# session instead of the EDID-preferred rate (often 60Hz). This is the Wayland
# equivalent of the xrandr-in-Xsetup hack, without touching a stock SDDM file or
# fighting Hyprland's own mode selection.
#
# modetest (libdrm) reads each connector's modes without holding DRM master, so
# it runs before weston takes the card. Any uncertainty -- no modetest, nothing
# connected, an empty parse -- falls back to plain weston (preferred mode), so
# the greeter always comes up. weston itself ignores an unmatched output mode
# and keeps the preferred one, so a wrong pick degrades to today's behaviour
# rather than a blank login screen.
#
# Which monitor the login form lands on: with two displays weston's kiosk shell
# drops the greeter on whichever output came up first (a DP that trains a beat
# before an HDMI), which is often the wrong one. kiosk-shell can pin a client to
# a named output by its Wayland app-id, so the greeter (sddm-greeter-qt6) is
# pinned to a chosen output: an internal laptop panel when there is one, or the
# connector named in /etc/ryoku/greeter.conf (PRIMARY=<name>, APPID=<id>) or
# RYOKU_GREETER_PRIMARY / RYOKU_GREETER_APPID. Idle blanking is off so a display
# never powers down at the login screen.
set -u

# The login pointer is the greeter client's own cursor: Qt pushes a themed
# cursor surface and weston's kiosk shell has no cursor of its own. Pin the
# shipped Bibata set (ryoku-cursors) so that surface renders from a real
# theme. Matches GreeterEnvironment in /etc/sddm.conf.d/10-ryoku-wayland.conf.
export XCURSOR_THEME="${XCURSOR_THEME:-Bibata-Modern-Ice}"
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"

# The login pointer vanishes on NVIDIA: its DRM backend hands the cursor to a
# hardware plane the driver accepts but never displays (issue #184). Dropping to
# the pixman renderer avoids plane promotion and fixes it there. But pixman is a
# trap everywhere else: under it weston uses no cursor plane AND composites none
# (weston #375), so forcing it on an Intel/AMD iGPU panel -- where the GL
# renderer's hardware cursor works -- hides the pointer entirely (issue #191).
# So only use pixman when NVIDIA actually drives the connected internal panel the
# greeter lands on, mirroring how the session picks its GPU env.
weston_args=""
for conn in /sys/class/drm/card*-eDP-* /sys/class/drm/card*-LVDS-* /sys/class/drm/card*-DSI-*; do
  [ -e "$conn/status" ] && [ "$(cat "$conn/status")" = connected ] || continue
  card=${conn%-*}; card=${card%-*}
  [ "$(cat "$card/device/vendor" 2>/dev/null)" = "0x10de" ] && weston_args="--renderer=pixman"
  break
done

# weston reads no X11 keyboard config, so without one the greeter comes up on
# weston's built-in us map and a non-us password fails at the login field. Read
# the layout the system records and hand it to weston through the libxkbcommon
# defaults, which weston honours when its own config names no keymap.
#
# /etc/X11/xorg.conf.d/00-keyboard.conf is the richest source (layout, variant,
# options) but localectl only writes it when a layout is applied system-wide;
# many installs set only /etc/vconsole.conf. So fall back to the console keymap
# -- the layout the box was installed with -- converting the console-keymap names
# that differ from their xkb code (de-latin1 -> de, uk -> gb) so a de box shows
# de at the login field even when the X11 file was never written (#224). Mirrors
# consoleToXkb in ryoku/cli/internal/keyboard/keyboard.go.
console_to_xkb() {
  case "$1" in
    uk | gb) printf '%s' gb ;;
    fr-latin1 | fr-pc | azerty) printf '%s' fr ;;
    be-latin1) printf '%s' be ;;
    de-latin1) printf '%s' de ;;
    de_CH-latin1 | sg | sf) printf '%s' ch ;;
    es-cp850) printf '%s' es ;;
    la-latin1) printf '%s' latam ;;
    it2) printf '%s' it ;;
    pt-latin1) printf '%s' pt ;;
    br-abnt2) printf '%s' br ;;
    no-latin1 | nb) printf '%s' no ;;
    fi-latin1) printf '%s' 'fi' ;;
    se-latin1) printf '%s' se ;;
    dk-latin1) printf '%s' dk ;;
    is-latin1) printf '%s' is ;;
    pl2) printf '%s' pl ;;
    cz-lat2) printf '%s' cz ;;
    sk-qwertz) printf '%s' sk ;;
    hu101) printf '%s' hu ;;
    jp106) printf '%s' jp ;;
    croat) printf '%s' hr ;;
    slovene) printf '%s' si ;;
    trq | trf) printf '%s' tr ;;
    ua-utf) printf '%s' ua ;;
    ruwin_alt-UTF-8) printf '%s' ru ;;
    us-acentos | dvorak | colemak) printf '%s' us ;;
    "") : ;;
    *[-_]*) base=${1%%[-_]*}; [ "${#base}" -le 3 ] && printf '%s' "$base" ;;
    *) [ "${#1}" -le 3 ] && printf '%s' "$1" ;;
  esac
}

layout=""
variant=""
options=""
kb_conf=/etc/X11/xorg.conf.d/00-keyboard.conf
if [ -r "$kb_conf" ]; then
  xkb_opt() { sed -n "s/.*Option[[:space:]]*\"$1\"[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$kb_conf" | head -n1; }
  layout=$(xkb_opt XkbLayout); layout=${layout%%,*}
  if [ -n "$layout" ]; then
    variant=$(xkb_opt XkbVariant); variant=${variant%%,*}
    options=$(xkb_opt XkbOptions)
  fi
fi
if [ -z "$layout" ] && [ -r /etc/vconsole.conf ]; then
  keymap=$(sed -n 's/^[[:space:]]*KEYMAP[[:space:]]*=[[:space:]]*//p' /etc/vconsole.conf | tail -n1)
  keymap=${keymap%\"}; keymap=${keymap#\"}
  layout=$(console_to_xkb "$keymap")
fi
if [ -n "$layout" ]; then
  export XKB_DEFAULT_LAYOUT="$layout"
  [ -n "$variant" ] && export XKB_DEFAULT_VARIANT="$variant"
  [ -n "$options" ] && export XKB_DEFAULT_OPTIONS="$options"
fi

# Operator config for where the login form lands. env wins over the file; the
# file is /etc/ryoku/greeter.conf with plain KEY=value lines (PRIMARY, APPID).
# greeter_appid is the Wayland app-id kiosk-shell matches: the Qt6 greeter sets
# none, so Qt uses the binary name, sddm-greeter-qt6.
greeter_conf="${RYOKU_GREETER_CONF:-/etc/ryoku/greeter.conf}"
conf_val() { [ -r "$greeter_conf" ] && sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$greeter_conf" | tail -n1; }
# The session's chosen main display, published by the Hub's Displays apply.
# /etc/ryoku/greeter.conf is root-owned and manual, so it can never follow the
# user's pick; this file is how the pick reaches the greeter, which runs as the
# unprivileged sddm user and cannot read a per-user home.
greeter_primary_file="${RYOKU_GREETER_PRIMARY_FILE:-/var/lib/ryoku/greeter-primary}"
greeter_primary="${RYOKU_GREETER_PRIMARY:-$(conf_val PRIMARY)}"
greeter_appid="${RYOKU_GREETER_APPID:-$(conf_val APPID)}"
greeter_appid="${greeter_appid:-sddm-greeter-qt6}"

# Resolve which connector the login form is pinned to. An explicit PRIMARY (env
# or operator file) wins when it is actually connected; then the connector the
# session's Displays apply recorded as main; then an internal laptop panel
# (eDP/LVDS/DSI) as the sensible default. With none of them, print nothing:
# weston keeps its own choice and only the mode tuning applies, exactly as
# before. Every candidate is validated against the connected set, so a stale
# hand-off (a docked external that is gone) degrades to the old behaviour
# instead of a blank login.
choose_primary() {
  local want="$1" names handoff
  names="$(printf '%s\n' "$modes" | awk 'NF { print $1 }')"
  if [ -n "$want" ] && printf '%s\n' "$names" | grep -qxF "$want"; then
    printf '%s' "$want"; return
  fi
  if [ -r "$greeter_primary_file" ]; then
    handoff="$(tr -d '[:space:]' < "$greeter_primary_file")"
    if [ -n "$handoff" ] && printf '%s\n' "$names" | grep -qxF "$handoff"; then
      printf '%s' "$handoff"; return
    fi
  fi
  printf '%s\n' "$names" | grep -m1 -E '^(eDP|LVDS|DSI)' || true
}

# The kiosk shell draws no pointer of its own for a cursor-shape client, and
# weston only learns which theme to draw from a [shell] block, so every config we
# hand it carries one; without it the login pointer never renders (issue #191).
shell_ini() { printf '[shell]\ncursor-theme=%s\ncursor-size=%s\n\n' "${XCURSOR_THEME:-Bibata-Modern-Ice}" "${XCURSOR_SIZE:-24}"; }

# The keypad must type digits at the login field. SDDM's [General] Numlock knob
# is inert under the Wayland greeter (its keyboard backend's sendChanges() is
# empty), and the skin's keyboard.numLock assignment reaches the same dead end,
# so weston's own lock key is the only channel that lands. Without it the
# keypad sends navigation keysyms (KP_End, not KP_1) and a PIN-style password
# never reaches the field.
keyboard_ini() { printf '[keyboard]\nnumlock-on=true\n\n'; }

# Match the session's touchpad feel: Hyprland enables tap-to-click by default,
# weston does not (enable-tap defaults off), so a clickpad that taps to click in
# the session does nothing at the login field (#224). natural-scroll stays off to
# match modules/input.lua; enable-tap only affects touchpad devices.
libinput_ini() { printf '[libinput]\nenable-tap=true\nnatural-scroll=false\n\n'; }

# exec plain weston (preferred mode); the login screen must always start. Hand it
# a [core]+[shell] config too so the pointer has a theme even when no modes parse.
weston_plain() {
  local pini
  pini="$(mktemp --tmpdir ryoku-greeter.XXXXXX.ini 2>/dev/null)" &&
    { printf '[core]\nidle-time=0\n\n'; shell_ini; libinput_ini; keyboard_ini; } >"$pini" &&
    exec weston --shell=kiosk $weston_args --config="$pini" "$@"
  exec weston --shell=kiosk $weston_args "$@"
}

command -v weston >/dev/null 2>&1 || { echo "ryoku-greeter: weston not found" >&2; exit 127; }
command -v modetest >/dev/null 2>&1 || weston_plain "$@"

# Per connected connector, pick the largest resolution then its highest refresh.
# Output: "<name> <w> <h> <refresh-string>" lines. Refresh is kept verbatim from
# modetest so weston matches the exact modelist entry. modetest holds no DRM
# master, so this is safe to poll before weston takes the card.
probe_modes() {
  modetest -c 2>/dev/null | awk '
    /^Connectors:/ { insec = 1; next }
    /^(CRTCs|Encoders|Planes|Framebuffers):/ { insec = 0 }
    !insec { next }
    $3 == "connected"    { conn = $4; next }
    $3 == "disconnected" { conn = "";  next }
    conn != "" && $1 ~ /^#[0-9]+$/ {
      split($2, wh, "x"); w = wh[1] + 0; h = wh[2] + 0; rr = $3 + 0
      if (w <= 0 || h <= 0 || rr <= 0) next
      area = w * h
      if (area > ba[conn] || (area == ba[conn] && rr > br[conn])) {
        ba[conn] = area; br[conn] = rr; bw[conn] = w; bh[conn] = h; brs[conn] = $3
      }
    }
    END { for (c in bw) printf "%s %d %d %s\n", c, bw[c], bh[c], brs[c] }
  '
}

gen_ini() {
  # idle-time=0: the login screen must never blank a display out from under the
  # user. One [output] per connected panel at its top mode; the chosen primary
  # also carries app-ids so kiosk-shell drops the greeter window there.
  printf '[core]\nidle-time=0\n\n'
  shell_ini
  libinput_ini
  keyboard_ini
  while read -r name w h rr; do
    [ -n "$name" ] && [ "${w:-0}" -gt 0 ] && [ "${h:-0}" -gt 0 ] || continue
    printf '[output]\nname=%s\nmode=%sx%s@%s\n' "$name" "$w" "$h" "$rr"
    [ -n "$greeter_primary" ] && [ "$name" = "$greeter_primary" ] &&
      printf 'app-ids=%s\n' "$greeter_appid"
    printf '\n'
  done <<< "$modes"
}

# Inspect the generated config without starting the greeter.
if [ "${RYOKU_GREETER_DRYRUN:-0}" = 1 ]; then
  modes="$(probe_modes)"
  greeter_primary="$(choose_primary "$greeter_primary")"
  gen_ini
  exit 0
fi

# Some boards bring one connector up a beat before another (DP a moment before
# HDMI), so a greeter that probes once lights only the fast panel and the login
# lands on the wrong screen -- or on just one of two. Poll until the connected
# set holds steady, giving a slower panel time to arrive, then build the .ini
# from the full set so weston lights every output. Bounded so the login screen
# always starts; tune the floor and cap with RYOKU_GREETER_SETTLE and
# RYOKU_GREETER_DEADLINE (seconds).
settle="${RYOKU_GREETER_SETTLE:-1}"
deadline="${RYOKU_GREETER_DEADLINE:-6}"
start=$SECONDS
modes=""
last=-1
while :; do
  modes="$(probe_modes)"
  n=$(printf '%s' "$modes" | awk 'NF { c++ } END { print c + 0 }')
  elapsed=$(( SECONDS - start ))
  [ "$elapsed" -ge "$deadline" ] && break
  [ "$n" -gt 0 ] && [ "$n" -eq "$last" ] && [ "$elapsed" -ge "$settle" ] && break
  last="$n"
  sleep 0.3
done

[ -n "$modes" ] || weston_plain "$@"

# Pin the login form to the resolved output now that the full connected set is in.
greeter_primary="$(choose_primary "$greeter_primary")"

ini="$(mktemp --tmpdir ryoku-greeter.XXXXXX.ini 2>/dev/null)" || weston_plain "$@"
gen_ini > "$ini"
[ -s "$ini" ] || weston_plain "$@"

exec weston --shell=kiosk $weston_args --config="$ini" "$@"
