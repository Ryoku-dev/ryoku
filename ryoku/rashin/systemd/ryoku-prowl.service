[Unit]
Description=Ryoku Prowl: model gateway and code intelligence for Rashin
BindsTo=ryoku-rashin.service
After=ryoku-rashin.service
StartLimitIntervalSec=0

[Service]
ExecStartPre=-/usr/bin/prowl gateway down --port 8788
ExecStart=/usr/bin/prowl gateway serve --port 8788
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
